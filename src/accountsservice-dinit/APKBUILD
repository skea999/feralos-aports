# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# AccountsService on the system bus. The unit is named after the bus name
# and D-Bus activation is routed through feralos-dbus-activate (ADR-010).
pkgname=accountsservice-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for AccountsService"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit accountsservice feralos-dbus-activate"
makedepends=""
source="org.freedesktop.Accounts org.freedesktop.Accounts.service"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/org.freedesktop.Accounts" \
		"$pkgdir/lib/dinit.d/org.freedesktop.Accounts"
	# D-Bus activation override: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.freedesktop.Accounts.service" \
		"$pkgdir/etc/dbus-1/system-services/org.freedesktop.Accounts.service"
}

sha512sums="
