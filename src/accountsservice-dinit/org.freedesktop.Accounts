# dinit service: AccountsService (system bus user/account queries)
# Unit name = system bus name: D-Bus activation is routed through
# /etc/dbus-1/system-services/org.freedesktop.Accounts.service, whose Exec
# starts this unit (ADR-010).
type = process
smooth-recovery = true
log-type = file
logfile = /var/log/dinit/org.freedesktop.Accounts.log
command = /usr/libexec/accounts-daemon
depends-on = dbus
depends-on = local.target
before = login.target
