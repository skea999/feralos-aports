# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=acpid-dinit
pkgver=0.1.0
pkgrel=5
pkgdesc="dinit service for acpid"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit acpid"
makedepends=""
source="acpid acpid.script acpid.conf"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/acpid" "$pkgdir/lib/dinit.d/acpid"
	install -Dm755 "$srcdir/acpid.script" "$pkgdir/usr/lib/dinit/acpid"
	install -Dm644 "$srcdir/acpid.conf" "$pkgdir/etc/dinit.d/config/acpid.conf"
}

