pkgname=acpid-dinit
pkgver=0.1.0
pkgrel=3
pkgdesc="dinit service for acpid"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit acpid"
makedepends=""
source="acpid"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/acpid" "$pkgdir/lib/dinit.d/acpid"
}

