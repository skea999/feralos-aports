# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=acpid-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for acpid"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit acpid"
makedepends=""
source="acpid"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/acpid" "$pkgdir/usr/lib/dinit.d/acpid"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../acpid" "$pkgdir/usr/lib/dinit.d/boot.d/acpid"
}

sha512sums="26664f108dd7244894d483988fd546a61a52d83bf3af6901e85681ae1b800bc9  acpid"
