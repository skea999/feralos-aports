# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=apparmor-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for apparmor"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit apparmor"
makedepends=""
source="apparmor"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/apparmor" "$pkgdir/usr/lib/dinit.d/apparmor"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../apparmor" "$pkgdir/usr/lib/dinit.d/boot.d/apparmor"
}

sha512sums="c06a57dc35e3e7a499111462f3f5e0bb24d655cbf3d943649bd1e0d602728081a50ab5908e3b8a5078527a3e20991794314a9dfce6d55ab1fe6071b5cc4bfc8c  apparmor"
