# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=apparmor-dinit
pkgver=0.1.0
pkgrel=5
pkgdesc="dinit service for apparmor (scripted profile loader)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit apparmor"
makedepends=""
source="apparmor dinit-apparmor"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/apparmor" "$pkgdir/lib/dinit.d/apparmor"
	install -Dm755 "$srcdir/dinit-apparmor" "$pkgdir/usr/libexec/dinit-apparmor"
}

