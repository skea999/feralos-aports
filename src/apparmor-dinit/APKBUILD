# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=apparmor-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for apparmor"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit apparmor"
makedepends=""
source="apparmor-dinit"

build() { return 0; }
check() { return 0; }

package() {
    install -Dm644 "$srcdir/apparmor-dinit" "$pkgdir/usr/lib/dinit.d/apparmor-dinit"
    mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
    ln -sf ../"apparmor-dinit" "$pkgdir/usr/lib/dinit.d/boot.d/apparmor-dinit"
}

