# dinit service: apparmor — loads configured profiles into the kernel.
# Equivalent of the Alpine openrc apparmor start() (apparmor_parser over
# /etc/apparmor.d with cache); scripted + best-effort (never blocks boot).
type = scripted
command = /usr/libexec/dinit-apparmor
after = early-fs-local.target
before = local.target
restart = false
