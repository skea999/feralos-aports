# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# User dinit service for the at-spi accessibility bus. Unit name = canonical
# session D-Bus bus name (ADR-010); D-Bus activation is routed through
# feralos-dbus-activate via an override in /usr/share/feralos/dbus-services/.
pkgname=at-spi2-core-user-dinit
pkgver=0.1.0
pkgrel=1
pkgdesc="User dinit service for at-spi2-core (accessibility bus)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="dinit at-spi2-core feralos-dbus-activate"
makedepends=""
source="org.a11y.Bus.user org.a11y.Bus.service"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/org.a11y.Bus.user" \
		"$pkgdir/etc/dinit.d/user/org.a11y.Bus.user"
	# D-Bus activation override: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.a11y.Bus.service" \
		"$pkgdir/usr/share/feralos/dbus-services/org.a11y.Bus.service"
}

sha512sums="
