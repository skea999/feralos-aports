# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=audit-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for auditd"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
# audit-openrc ships /etc/init.d/auditd (the OpenRC fallback unit; the
# installer's rules enablement drives BOTH inits from the same service name)
depends="dinit audit audit-openrc"
makedepends=""
source="auditd auditd.script auditd.conf"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/auditd" "$pkgdir/lib/dinit.d/auditd"
	install -Dm755 "$srcdir/auditd.script" "$pkgdir/usr/lib/dinit/auditd"
	install -Dm644 "$srcdir/auditd.conf" "$pkgdir/etc/dinit.d/config/auditd.conf"
}

sha512sums="
