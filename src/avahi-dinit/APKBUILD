# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=avahi-dinit
pkgver=0.1.0
pkgrel=6
pkgdesc="dinit service for avahi"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit avahi"
makedepends=""
source="avahi avahi.script avahi.conf"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/avahi" "$pkgdir/lib/dinit.d/avahi"
	install -Dm755 "$srcdir/avahi.script" "$pkgdir/usr/lib/dinit/avahi"
	install -Dm644 "$srcdir/avahi.conf" "$pkgdir/etc/dinit.d/config/avahi.conf"
}

