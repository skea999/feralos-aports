# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=avahi-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for avahi"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit avahi"
makedepends=""
source="avahi"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/avahi" "$pkgdir/usr/lib/dinit.d/avahi"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../avahi" "$pkgdir/usr/lib/dinit.d/boot.d/avahi"
}

sha512sums="2dfe729a7747ab30ae1710dac79ff5861c3008fac6828275f2c7777b87ccae93  avahi"
