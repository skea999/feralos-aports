# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# avahi on the system bus. ADR-010: the D-Bus activation target
# org.freedesktop.Avahi routes through feralos-dbus-activate to a dinit
# unit named after the bus name; the override is packaged in
# /usr/share/dinit/dbus-system-services (materialized at boot into the
# launch helper's standard dirs). Transitional units: the harness check
# dbus_activation_migration retires them once dbus-broker is installed and
# every activation target has a package-shipped unit.
pkgname=avahi-dinit
pkgver=0.1.0
pkgrel=11
pkgdesc="dinit service for avahi"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit avahi feralos-dbus-activate"
# VERSIONED provides are REQUIRED: unversioned provides are virtual and apk add <alias> refuses the provider.
# Upstream activation file is an Exec=/bin/false trap; the audit falls back to
# bus-name-only identity and apk add resolves the supervision package via provides.
provides="org.freedesktop.Avahi-dinit=$pkgver-r$pkgrel"
makedepends=""
source="org.freedesktop.Avahi
	org.freedesktop.Avahi.service"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	# D-Bus activation target (canonical bus name) + override.
	install -Dm644 "$srcdir/org.freedesktop.Avahi" \
		"$pkgdir/lib/dinit.d/org.freedesktop.Avahi"
	install -Dm644 "$srcdir/org.freedesktop.Avahi.service" \
		"$pkgdir/usr/share/dinit/dbus-system-services/org.freedesktop.Avahi.service"
}

sha512sums="
5de85dff0260c6be3b31bf539d1cf017c38ffec920c862d4c404c9bebd8536b0b4e2bd532574ce105ae7a48bf26371c8d406c29545cd123a7e60cd128d0d732f  org.freedesktop.Avahi
c2a427c33f963e6ce424b55e92d2af4891aec173336360de06b01e7bb529012908bcbeb24cafe8c8f3bb3373e6de02404659fd0b69e5eeff0fd0318b62c57553  org.freedesktop.Avahi.service
"
