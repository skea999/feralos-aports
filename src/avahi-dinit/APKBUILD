# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=avahi-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for avahi"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit avahi"
makedepends=""
source="avahi"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/avahi" "$pkgdir/usr/lib/dinit.d/avahi"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../avahi" "$pkgdir/usr/lib/dinit.d/boot.d/avahi"
}

sha512sums="34c9fded8f954e70719c57c71c879fc0c01bd415cd9d5e5cd617b71a55fffcc84b679bd7ed395d8b5e5a17ab8cc87f251a9ada14270d44392ea2e964ac06650c  avahi"
