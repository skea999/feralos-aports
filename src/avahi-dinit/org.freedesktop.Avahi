# feralos avahi-dinit: D-Bus activation target for org.freedesktop.Avahi (ADR-010).
# Transitional: drop when the package (or dbus-broker ephemeral services) ships
# this unit itself. Runs like upstream's service (root, daemon drops privileges
# and chroots itself); activation-only — no boot enablement.
type = process
command = /usr/sbin/avahi-daemon
smooth-recovery = true
restart = false
log-type = file
logfile = /var/log/dinit/org.freedesktop.Avahi.log
depends-on = dbus
depends-on = networking
