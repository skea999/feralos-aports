# dinit service: bluetoothd (system daemon)
# Unit name = the OpenRC initd name (bluetooth, ADR-010 R1 amendment):
# D-Bus activation is routed through feralos-dbus-activate via the override
# packaged in /usr/share/feralos/dbus-system-services/org.bluez.service
# (installed at boot into /usr/local/share/dbus-1/system-services by
# dbus-services-setup).
type = process
log-type = file
logfile = /var/log/dinit/bluetoothd.log
command = /usr/lib/dinit/dbus-wait-for -s -f 4 -n org.bluez /usr/lib/bluetooth/bluetoothd --nodetach
ready-notification = pipefd:4
smooth-recovery = true
depends-on = dbus
depends-on = local.target
before = login.target
