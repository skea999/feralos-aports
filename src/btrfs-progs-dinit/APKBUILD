# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=btrfs-progs-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for btrfs-progs"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit btrfs-progs"
makedepends=""
source="btrfs-progs"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/btrfs-progs" "$pkgdir/usr/lib/dinit.d/btrfs-progs"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../btrfs-progs" "$pkgdir/usr/lib/dinit.d/boot.d/btrfs-progs"
}

sha512sums="1b3adc90976d10e99e670c7207e77c35647bd8da2b88f05c5b9497e06be61fa1  btrfs-progs"
