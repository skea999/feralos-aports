pkgname=btrfs-progs-dinit
pkgver=0.1.0
pkgrel=2
pkgdesc="dinit service for btrfs-progs"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit btrfs-progs"
makedepends=""
source="btrfs-progs"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/btrfs-progs" "$pkgdir/lib/dinit.d/btrfs-progs"
}

