pkgname=btrfs-progs-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for btrfs-progs"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit btrfs-progs"
makedepends=""
source="btrfs-progs"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/btrfs-progs" "$pkgdir/usr/lib/dinit.d/btrfs-progs"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../btrfs-progs" "$pkgdir/usr/lib/dinit.d/boot.d/btrfs-progs"
}

sha512sums="7b97d40cbe360df40c4d005f0a3d7ed9aad259841a98b0c00c08a675bc1396c585afa4d70db0771a9d07a75d68077a92db98a6befbdad3b528efaabe51c7fc69  btrfs-progs"
