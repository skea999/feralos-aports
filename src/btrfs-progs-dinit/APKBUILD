pkgname=btrfs-progs-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for btrfs-progs"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit btrfs-progs"
makedepends=""
source="btrfs-progs-dinit"

build() { return 0; }
check() { return 0; }

package() {
    install -Dm644 "$srcdir/btrfs-progs-dinit" "$pkgdir/usr/lib/dinit.d/btrfs-progs-dinit"
    mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
    ln -sf ../"btrfs-progs-dinit" "$pkgdir/usr/lib/dinit.d/boot.d/btrfs-progs-dinit"
}

