# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=busybox-loadkmap-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for loadkmap (console keyboard layout, busybox loadkmap)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="busybox kbd-bkeymaps"
makedepends=""
source="loadkmap loadkmap-script loadkmap.conf"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/loadkmap" "$pkgdir/lib/dinit.d/loadkmap"
	install -Dm755 "$srcdir/loadkmap-script" "$pkgdir/usr/lib/dinit/loadkmap"
	# /etc/conf.d/loadkmap: the FeralOS installer rewrites KEYMAP= from the
	# user variables — apk keeps the modified file on upgrade (conf.d is
	# protected), fresh installs get this default.
	install -Dm644 "$srcdir/loadkmap.conf" "$pkgdir/etc/conf.d/loadkmap"
}

