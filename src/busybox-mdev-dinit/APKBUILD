# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=busybox-mdev-dinit
pkgver=0.1.0
pkgrel=2
pkgdesc="dinit service for mdev (Alpine initd name) — unused on FeralOS (eudev)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit busybox"
makedepends=""
source="mdev"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/mdev" "$pkgdir/lib/dinit.d/mdev"
}

