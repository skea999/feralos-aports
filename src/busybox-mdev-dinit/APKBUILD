# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=busybox-mdev-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for busybox-mdev"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit busybox"
makedepends=""
source="busybox-mdev"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/busybox-mdev" "$pkgdir/usr/lib/dinit.d/busybox-mdev"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../busybox-mdev" "$pkgdir/usr/lib/dinit.d/boot.d/busybox-mdev"
}

sha512sums="a3aef12685d00a811dc30811d6b3830c210869a4d92225e804a1a53536f13f73  busybox-mdev"
