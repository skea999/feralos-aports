# Maintainer: FeralOS <dev@feralos.org>
pkgname=busybox-mdev-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for busybox-mdev"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit busybox"
makedepends=""
source="busybox-mdev"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/busybox-mdev" "$pkgdir/usr/lib/dinit.d/busybox-mdev"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../busybox-mdev" "$pkgdir/usr/lib/dinit.d/boot.d/busybox-mdev"
}

sha512sums="0da29c825694efd5ea7140b7e8d1cccb025f79e505d10a5b61aa1744c033ec98f511aba5b60c79df79cec8c5af84fd7a919a8ca66adea7d7deee3e483242d1af  busybox-mdev"
