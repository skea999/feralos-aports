# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=chrony-dinit
pkgver=0.1.0
pkgrel=6
pkgdesc="dinit service for chronyd (Alpine initd name)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit chrony"
makedepends=""
source="chronyd chronyd.script chronyd.conf"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/chronyd" "$pkgdir/lib/dinit.d/chronyd"
	install -Dm755 "$srcdir/chronyd.script" "$pkgdir/usr/lib/dinit/chronyd"
	install -Dm644 "$srcdir/chronyd.conf" "$pkgdir/etc/dinit.d/config/chronyd.conf"
}

