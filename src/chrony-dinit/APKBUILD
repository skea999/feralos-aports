# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=chrony-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for chrony"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit chrony"
makedepends=""
source="chrony"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/chrony" "$pkgdir/usr/lib/dinit.d/chrony"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../chrony" "$pkgdir/usr/lib/dinit.d/boot.d/chrony"
}

sha512sums="d9c2605ea62a9ea9e996a8df2ce9cd1f0f70dae1c0dcc692e74211165a5ee04b  chrony"
