d4244ae1af84fc97db87f44215b65188defe1800bfa88c1ed0d07a0f88d860324235dc5b75a10cf3f92167b9a36380cc17e17997862820d4901175d0a68ba150  clamd.script
59084fd0006eac1f883306b6ec32cdd4da1c4b0533f7acc516d093f7f8e6201634d8f174815cdda20c8c104b77bf6cfa2e9d240cf40329880e73d93b06ff6672  clamd.conf
"
