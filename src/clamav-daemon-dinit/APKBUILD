# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# NAME CONTRACT: the installer's dinit conversion (packages.go) scans the
# installed `-openrc` subpackages and `apk add <base>-dinit` for each —
# Alpine ships `clamav-daemon-openrc`, so this package MUST be named
# `clamav-daemon-dinit` (one daemon, one package, matching the upstream
# split; freshclam has its own freshclam-dinit).
pkgname=clamav-daemon-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for clamd"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
# clamav-daemon owns /etc/init.d/clamd (the OpenRC fallback unit — this
# package does NOT ship that path); the installer's rules enablement drives
# BOTH inits from the same service name. The dinit unit depends-on freshclam
# (the Alpine clamd.confd rc_need="freshclam" semantic, preserved via the
# freshclam-dinit unit).
depends="dinit clamav-daemon"
makedepends=""
source="clamd clamd.script clamd.conf"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/clamd" "$pkgdir/lib/dinit.d/clamd"
	install -Dm755 "$srcdir/clamd.script" "$pkgdir/usr/lib/dinit/clamd"
	install -Dm644 "$srcdir/clamd.conf" "$pkgdir/etc/dinit.d/config/clamd.conf"
}

sha512sums="
