# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# complete-security-config: the FeralOS enterprise security stack family
# (ADR-013 R2 — one package = complete functionality, pulled in as ONE
# dependency of the installer's completeSecurity feature). This package
# carries:
#   - the enterprise stack as apk dependencies: auditd (kernel audit
#     framework), AIDE (file integrity), fail2ban (+ its own -config jail
#     package), Tracee (runtime detection), lynis (conformance)
#   - /etc/audit/audit.rules — the lean baseline (the vendor audit package
#     ships NO audit.rules; only audit-stop.rules + auditd.conf)
#   - /etc/aide.conf — the vendor aide package ships no config (sample
#     under doc/ only)
#   - /etc/periodic/daily/aide-check — the daily integrity cron
# The watches that depend on WHICH sudo/doas/openssh stack is installed are
# inserted by the post-install (existence-filtered) ABOVE the immutable
# marker: -e 2 must stay LAST. The service enablement (auditd/fail2ban/
# tracee) is rules-driven — it rides the complete-security-config
# packageLogic key (dep-installed packages have no reachable rules key of
# their own).
pkgname=complete-security-config
pkgver=0.1.0
pkgrel=0
pkgdesc="FeralOS enterprise security stack: audit rules, AIDE config + cron, stack dependencies"
url="https://github.com/skea999/feralos-aports"
arch="noarch"
license="ISC"
depends="audit aide fail2ban fail2ban-config tracee lynis"
makedepends=""
source="audit.rules aide.conf aide-check $pkgname.post-install"
install="$pkgname.post-install"
options="!check" # static config, exercised by the security_stack harness checks

package() {
	install -Dm640 "$srcdir/audit.rules" "$pkgdir/etc/audit/audit.rules"
	install -Dm644 "$srcdir/aide.conf" "$pkgdir/etc/aide.conf"
	install -Dm755 "$srcdir/aide-check" "$pkgdir/etc/periodic/daily/aide-check"
	# state + report dirs (the vendor aide package ships none; the daily
	# check and BaselineAide write into them)
	install -d -m755 "$pkgdir"/var/lib/aide "$pkgdir"/var/log/aide
}
sha512sums="
