74e950be913f6b7f437876a8cad31f65269ce8c22595a52e56b63921e94918ed2d7064da7ceb5c6d41f6b98d72a906cd7bdb944e6e450b484dd29f10ee4868ea  com.system76.CosmicStatusNotifierWatcher.service
"
