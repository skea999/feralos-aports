b40e151744088ddf33a400f43177ac5985aa3e81069323556873ca18d67c93440f846cd444b7d7d9e7c0ff4a7cc80913a7a680ca055729c0f9ddd1db24f10cfd  com.system76.CosmicStatusNotifierWatcher.service
"
