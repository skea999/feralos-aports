# feralos cosmic-applets-user-dinit: D-Bus activation target for
# com.system76.CosmicStatusNotifierWatcher (ADR-010).
# Transitional: drop when the package (or dbus-broker ephemeral services) ships
# this unit itself.
type = process
command = /usr/bin/cosmic-applet-status-area --status-notifier-watcher
smooth-recovery = true
restart = false
load-options = sub-vars
logfile = $HOME/.local/share/dinit/com.system76.CosmicStatusNotifierWatcher.log
depends-on = dbus.user
