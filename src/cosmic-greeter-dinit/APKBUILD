# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=cosmic-greeter-dinit
pkgver=0.1.0
pkgrel=5
pkgdesc="dinit service for cosmic-greeter (Alpine initd name: cosmic-greeter)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit cosmic-greeter greetd pam-rundir"
makedepends=""
source="cosmic-greeter
	cosmic-greeter-daemon
	cosmic-greeter-session
	feralos-cosmic-greeter.toml
	pam.d-cosmic-greeter"

build() { return 0; }
check() { return 0; }

package() {
	# cosmic-greeter is a greetd FRONTEND: it needs GREETD_SOCK, so greetd
	# (not the greeter binary) is what runs — with the FeralOS config
	# (VT 7, not Alpine's VT 1 which collides with getty@tty1).
	install -Dm644 "$srcdir/cosmic-greeter" "$pkgdir/lib/dinit.d/cosmic-greeter"
	install -Dm644 "$srcdir/cosmic-greeter-daemon" "$pkgdir/lib/dinit.d/cosmic-greeter-daemon"
	install -Dm755 "$srcdir/cosmic-greeter-session" "$pkgdir/usr/libexec/feralos/cosmic-greeter-session"
	install -Dm644 "$srcdir/feralos-cosmic-greeter.toml" "$pkgdir/etc/greetd/feralos-cosmic-greeter.toml"
	# Base-only PAM stack: Alpine's vendored file requires pam_gnome_keyring
	# (not shipped on FeralOS); base-session's optional pam_rundir creates
	# XDG_RUNTIME_DIR for the elogind-based COSMIC session.
	install -Dm644 "$srcdir/pam.d-cosmic-greeter" "$pkgdir/etc/pam.d/cosmic-greeter"
}

