pkgname=cpufrequtils-dinit
pkgver=0.1.0
pkgrel=1
pkgdesc="dinit service for cpufrequtils"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit cpufrequtils"
makedepends=""
source="cpufrequtils"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/cpufrequtils" "$pkgdir/lib/dinit.d/cpufrequtils"
	mkdir -p "$pkgdir/lib/dinit.d/boot.d"
	ln -sf "../cpufrequtils" "$pkgdir/lib/dinit.d/boot.d/cpufrequtils"
}

