# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=cpufrequtils-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for cpufrequtils"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit cpufrequtils"
makedepends=""
source="cpufrequtils"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/cpufrequtils" "$pkgdir/usr/lib/dinit.d/cpufrequtils"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../cpufrequtils" "$pkgdir/usr/lib/dinit.d/boot.d/cpufrequtils"
}

sha512sums="f415d60f0f42c6168011a106281c1ba7838c60fae5b29a3d322e4962d1c27e3e  cpufrequtils"
