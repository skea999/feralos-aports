# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=cpufrequtils-dinit
pkgver=0.1.0
pkgrel=6
pkgdesc="dinit service for cpufrequtils (apply governor settings)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit cpufrequtils"
makedepends=""
source="cpufrequtils dinit-cpufrequtils cpufrequtils.conf"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/cpufrequtils" "$pkgdir/lib/dinit.d/cpufrequtils"
	install -Dm755 "$srcdir/dinit-cpufrequtils" "$pkgdir/usr/libexec/dinit-cpufrequtils"
	install -Dm644 "$srcdir/cpufrequtils.conf" "$pkgdir/etc/dinit.d/config/cpufrequtils.conf"
}

