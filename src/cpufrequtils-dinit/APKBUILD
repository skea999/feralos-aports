pkgname=cpufrequtils-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for cpufrequtils"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit cpufrequtils"
makedepends=""
source="cpufrequtils-dinit"

build() { return 0; }
check() { return 0; }

package() {
    install -Dm644 "$srcdir/cpufrequtils-dinit" "$pkgdir/usr/lib/dinit.d/cpufrequtils-dinit"
    mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
    ln -sf ../"cpufrequtils-dinit" "$pkgdir/usr/lib/dinit.d/boot.d/cpufrequtils-dinit"
}

