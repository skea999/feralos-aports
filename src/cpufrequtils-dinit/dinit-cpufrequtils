#!/bin/sh
# Apply CPU frequency settings — Alpine openrc cpufrequtils start()/stop()
# equivalent. Parameters come from /etc/dinit.d/config/cpufrequtils.conf;
# the defaults below apply when the config is absent or partial.
command -v cpufreq-set >/dev/null 2>&1 || { echo "cpufrequtils: cpufreq-set not found, skipping"; exit 0; }

[ -r /etc/dinit.d/config/cpufrequtils.conf ] && . /etc/dinit.d/config/cpufrequtils.conf
: "${CPUFREQ_START_OPTS=--governor ondemand}"
: "${CPUFREQ_STOP_OPTS=--governor performance}"

run_for_each_cpu() {
	rc=0
	for cpupath in /sys/devices/system/cpu/cpu[0-9]*; do
		[ -d "$cpupath/cpufreq" ] || continue
		cpu="${cpupath##*/cpu}"
		cpufreq-set -c "$cpu" "$@" || { echo "cpufrequtils: failed on cpu$cpu" >&2; rc=1; }
	done
	return $rc
}

case "${1:-}" in
stop)
	# Shutdown: return to a known-good governor (openrc cpufrequtils stop()).
	run_for_each_cpu $CPUFREQ_STOP_OPTS
	;;
*)
	[ -n "$CPUFREQ_START_OPTS" ] || { echo "cpufrequtils: no CPUFREQ_START_OPTS, skipping"; exit 0; }
	# Any real failure (config present, tool present, cpufreq dir exists) is
	# surfaced: dinit marks the service {X}. CPUs without cpufreq (VMs) are
	# simply skipped.
	run_for_each_cpu $CPUFREQ_START_OPTS
	;;
esac
