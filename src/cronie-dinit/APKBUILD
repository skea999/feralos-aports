# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=cronie-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="cronie service for dinit"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit cronie"
makedepends=""
source="cronie"

build() {
	# nothing to build
	return 0
}

check() {
	# nothing to test
	return 0
}

package() {
	install -Dm644 "$srcdir/cronie" "$pkgdir/usr/lib/dinit.d/cronie"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf ../cronie "$pkgdir/usr/lib/dinit.d/boot.d/cronie"
}

sha512sums="70daafcd7047184c4a2e4e0d1a21ee82f64cc5f6d0cc72f2b02d40f1155908eaeddb6dac6322ddaf6d776e774bc4a50518492c18ad43e3d8e5d3aa0b6f9ed758  cronie"
