# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=cronie-dinit
pkgver=0.1.0
pkgrel=6
pkgdesc="dinit service for cronie"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit cronie"
makedepends=""
source="cronie cronie.script cronie.conf"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/cronie" "$pkgdir/lib/dinit.d/cronie"
	install -Dm755 "$srcdir/cronie.script" "$pkgdir/usr/lib/dinit/cronie"
	install -Dm644 "$srcdir/cronie.conf" "$pkgdir/etc/dinit.d/config/cronie.conf"
}

