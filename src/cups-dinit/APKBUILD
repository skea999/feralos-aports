# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=cups-dinit
pkgver=0.1.0
pkgrel=4
pkgdesc="dinit service for cups (cupsd — Alpine initd name)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit cups"
makedepends=""
source="cupsd"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/cupsd" "$pkgdir/lib/dinit.d/cupsd"
}

sha512sums="
