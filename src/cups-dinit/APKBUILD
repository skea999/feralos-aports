# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=cups-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for cups"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit cups"
makedepends=""
source="cups"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/cups" "$pkgdir/usr/lib/dinit.d/cups"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../cups" "$pkgdir/usr/lib/dinit.d/boot.d/cups"
}

sha512sums="9fd2fe6d2af6ff87e175478afdc8a118b81a7b875f22446ca23524bd6a9e5dc6  cups"
