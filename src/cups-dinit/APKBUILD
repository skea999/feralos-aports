pkgname=cups-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for cups"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit cups"
makedepends=""
source="cups-dinit"

build() { return 0; }
check() { return 0; }

package() {
    install -Dm644 "$srcdir/cups-dinit" "$pkgdir/usr/lib/dinit.d/cups-dinit"
    mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
    ln -sf ../"cups-dinit" "$pkgdir/usr/lib/dinit.d/boot.d/cups-dinit"
}

