pkgname=cups-dinit
pkgver=0.1.0
pkgrel=3
pkgdesc="dinit service for cups"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit cups"
makedepends=""
source="cups"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/cups" "$pkgdir/lib/dinit.d/cups"
}

