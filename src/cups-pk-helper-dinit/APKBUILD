# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# cups-pk-helper on the system bus. ADR-010: the D-Bus activation target
# org.opensuse.CupsPkHelper.Mechanism routes through feralos-dbus-activate
# to a dinit unit named after the bus name; the override is packaged in
# /usr/share/dinit/dbus-system-services (materialized at boot into the
# launch helper's standard dirs). Transitional units: the harness check
# dbus_activation_migration retires them once dbus-broker is installed and
# every activation target has a package-shipped unit.
pkgname=cups-pk-helper-dinit
pkgver=0.1.0
pkgrel=3
pkgdesc="dinit service for cups-pk-helper (D-Bus activation target)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="feralos-dbus-activate cups-pk-helper cups-dinit"
makedepends=""
source="org.opensuse.CupsPkHelper.Mechanism
	org.opensuse.CupsPkHelper.Mechanism.service"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/org.opensuse.CupsPkHelper.Mechanism" \
		"$pkgdir/lib/dinit.d/org.opensuse.CupsPkHelper.Mechanism"
	# D-Bus activation override: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.opensuse.CupsPkHelper.Mechanism.service" \
		"$pkgdir/usr/share/dinit/dbus-system-services/org.opensuse.CupsPkHelper.Mechanism.service"
}

sha512sums="
03dc2267d5d9a435755589503f1037df1b0618f0afd5727c621746232e716e1c304dae92af226c808b9a4c4f5692f6ab27be1314c188a654f6395f3bbde729c3  org.opensuse.CupsPkHelper.Mechanism
6b90fb013b11549db12a2c8bf183b0667f24fd101bd994be36da8d2acbc5a8fd500357e7d86602aba4aba5fce99aa20193ba1c373f9dac44062ef5ec00cae2db  org.opensuse.CupsPkHelper.Mechanism.service
"
