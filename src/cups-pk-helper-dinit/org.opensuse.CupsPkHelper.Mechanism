# feralos cups-pk-helper-dinit: D-Bus activation target for
# org.opensuse.CupsPkHelper.Mechanism (ADR-010). Transitional: drop when the package
# (or dbus-broker ephemeral services) ships this unit itself. The mechanism has no CLI
# options and serves immediately on exec; it needs cupsd running.
type = process
command = /usr/libexec/cups-pk-helper-mechanism
run-as = root
# dbus-activated on-demand: smooth-recovery off — a clean idle exit stops the
# unit (the next activation restarts it); restart=on-failure covers crashes.
smooth-recovery = false
restart = on-failure
log-type = file
logfile = /var/log/dinit/org.opensuse.CupsPkHelper.Mechanism.log
depends-on = dbus
depends-on = cupsd
