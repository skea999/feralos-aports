# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=dbus-dinit
pkgver=0.1.0
pkgrel=8
pkgdesc="dinit service for dbus (pipefd readiness, shutdown stop guard)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit dbus"
makedepends=""
source="dbus dbus-dinit.tmpfiles dbus-stop dbus.script dbus.conf"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/dbus" "$pkgdir/lib/dinit.d/dbus"
	install -Dm755 "$srcdir/dbus.script" "$pkgdir/usr/lib/dinit/dbus"
	install -Dm644 "$srcdir/dbus.conf" "$pkgdir/etc/dinit.d/config/dbus.conf"
	# /run/dbus must exist before the daemon (OpenRC initd did checkpath)
	install -Dm644 "$srcdir/dbus-dinit.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/dbus-dinit.conf"
	# stop guard: keep the bus alive while session trackers (turnstiled) close
	# their PAM sessions at shutdown — dinit runs stop-command INSTEAD of
	# signalling the process (see dbus-stop header)
	install -Dm755 "$srcdir/dbus-stop" "$pkgdir/usr/libexec/dbus-dinit-stop"
}

