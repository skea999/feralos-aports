# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=dbus-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dbus service for dinit"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit dbus"
makedepends=""
source="dbus"

build() {
	# nothing to build
	return 0
}

check() {
	# nothing to test
	return 0
}

package() {
	install -Dm644 "$srcdir/dbus" "$pkgdir/usr/lib/dinit.d/dbus"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf ../dbus "$pkgdir/usr/lib/dinit.d/boot.d/dbus"
}

sha512sums="2d8b5f09862a47b20bdba5794cf4833b0ab6318cbbcee024543714d7f888e5e12bca63c2c902aa281a8f8235efdf3995657d39daf35ca7b33dab4253a61203ec  dbus"
