# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=dbus-dinit
pkgver=0.1.0
pkgrel=5
pkgdesc="dinit service for dbus (pipefd readiness)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit dbus"
makedepends=""
source="dbus
	dbus-dinit.tmpfiles"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/dbus" "$pkgdir/lib/dinit.d/dbus"
	# /run/dbus must exist before the daemon (OpenRC initd did checkpath)
	install -Dm644 "$srcdir/dbus-dinit.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/dbus-dinit.conf"
}

sha512sums="
