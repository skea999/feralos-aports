# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=dbus-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for dbus"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit dbus"
makedepends=""
source="dbus"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/dbus" "$pkgdir/usr/lib/dinit.d/dbus"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../dbus" "$pkgdir/usr/lib/dinit.d/boot.d/dbus"
}

sha512sums="6bbe62c2e2790b87d8eefdf0972d5ac90c157e5f00b70636e24a89cd6546d88e  dbus"
