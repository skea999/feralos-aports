# Maintainer: FeralOS <dev@feralos.org>
pkgname=dbus-user-dinit
pkgver=0.1.0
pkgrel=3
pkgdesc="dinit user service for the D-Bus session bus"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dbus"
makedepends=""
source="dbus.user dbus-session"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; the user dinit instance
	# (started by the session wrapper) supervises it.
	install -Dm644 "$srcdir/dbus.user" "$pkgdir/etc/dinit.d/user/dbus.user"
	install -Dm755 "$srcdir/dbus-session" "$pkgdir/etc/dinit.d/user/scripts/dbus-session"
}

sha512sums="
