#!/bin/sh
# dbus session bus launcher — supervised by the user dinit instance.
# The address is deterministic ($XDG_RUNTIME_DIR/bus); it is exported both
# to the environment (inherited by dbus-daemon) and into the dinit manager
# environment (dinitctl setenv) so dependent services see it too.
export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/`id -u`/bus"
dinitctl setenv DBUS_SESSION_BUS_ADDRESS || :
exec dbus-daemon --session --address="$DBUS_SESSION_BUS_ADDRESS" "$@"
