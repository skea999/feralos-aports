# dinit user service: dconf service (ca.desrt.dconf)
# D-Bus gateway for the dconf configuration database. Unit name = canonical
# D-Bus bus name (ADR-010); D-Bus activation is routed through
# /usr/local/share/dbus-1/services/ca.desrt.dconf.service.
type = process
smooth-recovery = true
load-options = sub-vars
logfile = $HOME/.local/share/dinit/ca.desrt.dconf.log
command = /usr/libexec/dconf-service
working-dir = $HOME
depends-on = dbus.user
