# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=dinit-boot-log
pkgver=0.1.0
pkgrel=1
pkgdesc="dinit service mirroring the PID1 status trail to /var/log/dinit/boot.log"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit"  # tail -F: busybox tail (1.35+) supports it
makedepends=""
source="dinit-boot-log.sh
	dinit-boot-log
	dinit-boot-log.tmpfiles"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven
	# (defaultRunlevelsDinit in the installer)
	install -Dm755 "$srcdir/dinit-boot-log.sh" "$pkgdir/usr/libexec/dinit-boot-log"
	install -Dm644 "$srcdir/dinit-boot-log" "$pkgdir/lib/dinit.d/dinit-boot-log"
	install -Dm644 "$srcdir/dinit-boot-log.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/dinit-boot-log.conf"
}

sha512sums="
