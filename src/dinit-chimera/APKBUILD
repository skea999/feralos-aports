# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=dinit-chimera
pkgver=0.99.24
pkgrel=4
pkgdesc="Dinit core service suite (Chimera upstream) for FeralOS"
url="https://github.com/chimera-linux/dinit-chimera"
arch="all"
license="BSD-2-Clause"
depends="dinit sd-tools snooze eudev tzdata util-linux-misc kexec-tools makedumpfile"
makedepends="meson pkgconf kmod-dev linux-headers"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/chimera-linux/dinit-chimera/archive/refs/tags/v$pkgver.tar.gz
	dinit-devd
	dinit-cryptdisks
	dinit-console"
options="!check"  # upstream ships no test suite

prepare() {
	default_prepare
	# Alpine standard service dir: the stock Alpine dinit (0.21) scans
	# /etc/dinit.d, /run/dinit.d, /usr/local/lib/dinit.d, /lib/dinit.d —
	# it does NOT scan /usr/lib/dinit.d (Chimera works because cports patches
	# their dinit). Override srvdir to /lib/dinit.d so dinit finds the `boot`
	# service; the `/` operator with an absolute RHS discards the prefix, so
	# EARLY_PATH/HELPER_PATH/SCRIPT_PATH stay coherent (all /lib/dinit.d/*).
	# libdir-relative dirs are NOT affected: tmpfdir stays /usr/lib/tmpfiles.d
	# and dlibdir (shutdown-hook) stays /usr/lib/dinit.
	sed -i "s|srvdir = get_option('libdir') / 'dinit.d'|srvdir = '/lib/dinit.d'|" "$builddir"/meson.build
	# upstream service files hardcode ABSOLUTE waits-for.d paths — align the
	# package drop-in with the relocated service dir (boot waits for
	# /etc/dinit.d/boot.d — the admin dir — and needs no change)
	sed -i "s|waits-for.d: /usr/lib/dinit.d/boot.d|waits-for.d: /lib/dinit.d/boot.d|" \
		"$builddir"/services/system
}

build() {
	# plain meson setup (NOT abuild-meson: it auto-passes --sbindir which
	# conflicts with our -Dsbindir=bin)
	# -Dsbindir=bin: upstream hardcodes dinit_path=$prefix/sbindir/dinit while
	# Alpine installs dinit to /usr/bin/dinit — bin keeps the @DINIT_PATH@
	# substitution correct; the only other sbin file (init wrapper) is
	# relocated in package() anyway
	# -Ddinit-sulogin-path: busybox sulogin on Alpine (upstream default is
	# /usr/sbin/sulogin)
	# -Ddefault-path-env: PATH for every process spawned by dinit. Upstream
	# value /usr/bin suffices on Chimera (usr-merged); Alpine is NOT
	# usr-merged — daemons shell out to /usr/sbin binaries (incusd -> ip)
	meson setup \
		--prefix=/usr \
		--buildtype=plain \
		-Ddefault-path-env=/usr/sbin:/usr/bin:/sbin:/bin \
		-Dsbindir=bin \
		-Ddinit-sulogin-path=/sbin/sulogin \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	# init wrapper: meson installs it to /usr/bin/init (sbindir=bin) —
	# relocate for OpenRC coexistence; kernel cmdline uses
	# init=/usr/libexec/dinit/init
	mkdir -p "$pkgdir/usr/libexec/dinit"
	mv "$pkgdir/usr/bin/init" "$pkgdir/usr/libexec/dinit/init"

	# MANDATORY stable contract: device-manager backend (eudev on Alpine)
	# — early-devd calls it with start|stop|settle|trigger
	install -Dm755 "$srcdir/dinit-devd" "$pkgdir/usr/libexec/dinit-devd"

	# cryptdisks backend: /etc/crypttab volumes NOT unlocked by the initramfs
	# (e.g. LUKS swap on btrfsStandardServer) — early|remaining + start|stop
	install -Dm755 "$srcdir/dinit-cryptdisks" "$pkgdir/usr/libexec/dinit-cryptdisks"

	# console backend: keyboard (loadkmap) + font (setfont), always exit 0
	# — upstream default path /usr/libexec/dinit-console, no meson flag needed
	install -Dm755 "$srcdir/dinit-console" "$pkgdir/usr/libexec/dinit-console"

	# drop-in dirs: packages (and admins) symlink enabled services here;
	# dinit-check + dinit require them to exist
	# (services dir = /lib/dinit.d — see prepare() srvdir override)
	install -d "$pkgdir/lib/dinit.d/boot.d" "$pkgdir/etc/dinit.d/boot.d"
}

