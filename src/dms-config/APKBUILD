# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# dms-config: the niri (DMS) greeter script as an APK package (ADR-013).
# greetd-config ships the shared greetd config; THIS package is the
# DE-specific half — what the greeter session executes:
#   XDG_RUNTIME_DIR fallback (greetd starts before elogind creates
#   /run/user/<uid>) then niri + regreet.
# The niriWayle variant lives in wayle-config (greeter-wayle.sh, adds the
# session.log redirect). grep by filename: greetd-config dispatches through
# the names, never through a shared path.
# This package also ships the niri STATIC base (/usr/share/dms/niri/
# base.kdl — prefer-no-csd, environment minus the per-install XDG_DATA_DIRS,
# xwayland-satellite, the xdg-user-dirs spawn) that the user config includes
# via ABSOLUTE path (niri >=25.11 merges most sections PER-PROPERTY; user
# overrides live in their installer-written config.kdl, the base is
# package-owned and upgrade-replaceable by design). The per-version DMS
# fragments (dms/*.kdl) are GENERATED by `dms setup` per user — NOT static,
# NOT here.
# GLOBAL (system-layer) defaults — every user inherits them live, no
# per-user copies (owner directive 2026-11-25: home configs that support a
# system layer go global so future users never redo them):
#   - /etc/xdg/mimeapps.list + /etc/xdg/xdg-terminals.list — the GLib /
#     xdg-terminal-exec standard system layers (the DMS Default Apps tab
#     reads/writes the USER files; the system ones are the fallback)
#   - /etc/xdg/mimeapps.list + /etc/xdg/xdg-terminals.list — the GLib /
#     xdg-terminal-exec standard system layers (the DMS Default Apps tab
#     reads/writes the USER files; the system ones are the fallback)
#   - the portals override STAYS installer-written per-user: the pin
#     differs per variant (DMS=gnome-keyring, Wayle=oo7-portal in the
#     wayle-config /etc admin conf) and the smoke CI installs every apk
#     into ONE root — two packages shipping the same portals path would
#     collide (the hicolor lesson, run 45301085299).
# SKEL — the per-user seeds move to /etc/skel (packages install BEFORE
# user creation, so the install-time user gets them via the adduser skel
# copy, and FUTURE users inherit them automatically — owner directive
# 2026-11-25 "home configs global so future users never redo them"):
#   - skel/.config/niri/config.kdl — the niri entry file (static includes;
#     install.kdl = optional: absent for future users, niri skips it)
#   - skel/.config/DankMaterialShell/{settings,plugin_settings}.json —
#     static (customPowerActionReboot = sudo -n /usr/bin/reboot baked:
#     zz-power ships unconditionally in feralos-reboot, so the command is
#     correct under BOTH inits)
#   - skel/.local/state/DankMaterialShell/session.json — dark mode seed
# NOT here: the per-user DMS fragments (dms/*.kdl) — `dms setup`-generated
# per user, NOT static.
# regreet.toml = the SHARED static file — greetd-config ships it (one file
# for both DEs; owner rule: aesthetic merges).
pkgname=dms-config
pkgver=0.3.1
pkgrel=0
pkgdesc="FeralOS niri (DMS) statics: greeter script, niri base.kdl, /etc/xdg global defaults, skel seeds"
url="https://github.com/skea999/feralos-aports"
arch="noarch"
license="ISC"
depends="greetd-config"
makedepends=""
	source="greeter.sh niri-base.kdl mimeapps.list xdg-terminals.list
	skel-niri-config.kdl skel-settings.json skel-plugin_settings.json skel-session.json"
options="!check" # static script + configs, proven live by the greeter harness checks

package() {
	install -Dm755 "$srcdir/greeter.sh" "$pkgdir/etc/greetd/greeter-niri.sh"
	install -Dm644 "$srcdir/niri-base.kdl" "$pkgdir/usr/share/dms/niri/base.kdl"
	# GLOBAL system-layer defaults (no collision: wayle-config ships none)
	install -Dm644 "$srcdir/mimeapps.list" "$pkgdir/etc/xdg/mimeapps.list"
	install -Dm644 "$srcdir/xdg-terminals.list" "$pkgdir/etc/xdg/xdg-terminals.list"
	# SKEL: the per-user seeds — copied by adduser at user creation
	install -d "$pkgdir/etc/skel/.config/niri" "$pkgdir/etc/skel/.config/DankMaterialShell"
	install -d "$pkgdir/etc/skel/.local/state/DankMaterialShell"
	install -m644 "$srcdir/skel-niri-config.kdl" "$pkgdir/etc/skel/.config/niri/config.kdl"
	install -m644 "$srcdir/skel-settings.json" "$pkgdir/etc/skel/.config/DankMaterialShell/settings.json"
	install -m644 "$srcdir/skel-plugin_settings.json" "$pkgdir/etc/skel/.config/DankMaterialShell/plugin_settings.json"
	install -m644 "$srcdir/skel-session.json" "$pkgdir/etc/skel/.local/state/DankMaterialShell/session.json"
	# GLOBAL system-layer defaults + the greetd PAM takeover
	install -Dm644 "$srcdir/mimeapps.list" "$pkgdir/etc/xdg/mimeapps.list"
	install -Dm644 "$srcdir/xdg-terminals.list" "$pkgdir/etc/xdg/xdg-terminals.list"
}
