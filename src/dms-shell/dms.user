# dinit service: DMS (user session) — WAYLAND_DISPLAY resolved at start
# from the compositor socket (compositor-agnostic; depends-on the
# wait-wayland gate). QML UI is embedded in the binary.
type = process
load-options = sub-vars
logfile = $HOME/.local/share/dinit/dms.log
command = /etc/dinit.d/user/scripts/dms-session
# no restart: a clean exit (greeter-session guard in dms-session) must stop
# the service; smooth-recovery still revives crashes (ADR-009 style)
smooth-recovery = true
depends-on = wait-wayland.user
depends-on = dbus.user
