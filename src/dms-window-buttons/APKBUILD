# Maintainer: FeralOS <dev@feralos.org>
pkgname=dms-window-buttons
pkgver=1.0.1
pkgrel=0
pkgdesc="Windows-style window controls (maximize/fullscreen/close) for the DMS bar"
url="https://github.com/skea999/dms-window-buttons"
arch="noarch"
license="ISC"
depends="dms-shell"
source="$pkgname-$pkgver.tar.gz::https://github.com/skea999/dms-window-buttons/archive/refs/tags/v$pkgver.tar.gz"

package() {
	install -d "$pkgdir"/etc/xdg/quickshell/dms-plugins/dmsWindowButtons
	install -m644 "$builddir/plugin.json" "$pkgdir"/etc/xdg/quickshell/dms-plugins/dmsWindowButtons/
	install -m644 "$builddir/WindowButtons.qml" "$pkgdir"/etc/xdg/quickshell/dms-plugins/dmsWindowButtons/
}

sha512sums="
