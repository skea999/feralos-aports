# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=dnsmasq-dinit
pkgver=0.1.0
pkgrel=3
pkgdesc="dinit service for dnsmasq"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit dnsmasq"
makedepends=""
source="dnsmasq"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/dnsmasq" "$pkgdir/lib/dinit.d/dnsmasq"
}

sha512sums="
