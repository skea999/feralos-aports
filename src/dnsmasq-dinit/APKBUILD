# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=dnsmasq-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for dnsmasq"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit dnsmasq"
makedepends=""
source="dnsmasq"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/dnsmasq" "$pkgdir/usr/lib/dinit.d/dnsmasq"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../dnsmasq" "$pkgdir/usr/lib/dinit.d/boot.d/dnsmasq"
}

sha512sums="65097299a9fad922a4df692f00bbca4907cc3e405dace57cb42883f8f166a800  dnsmasq"
