# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=dnsmasq-dinit
pkgver=0.1.0
pkgrel=5
pkgdesc="dinit service for dnsmasq"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit dnsmasq"
makedepends=""
source="dnsmasq dnsmasq.script dnsmasq.conf"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/dnsmasq" "$pkgdir/lib/dinit.d/dnsmasq"
	install -Dm755 "$srcdir/dnsmasq.script" "$pkgdir/usr/lib/dinit/dnsmasq"
	install -Dm644 "$srcdir/dnsmasq.conf" "$pkgdir/etc/dinit.d/config/dnsmasq.conf"
}

