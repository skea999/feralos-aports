# feralos dolphin-user-dinit: D-Bus activation target for
# org.freedesktop.FileManager1 (ADR-010).
# Transitional: drop when the package (or dbus-broker ephemeral services) ships
# this unit itself.
type = process
command = /usr/bin/dolphin --daemon
smooth-recovery = true
restart = false
working-dir = $HOME
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.freedesktop.FileManager1.log
depends-on = dbus.user
