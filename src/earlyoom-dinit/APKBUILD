# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=earlyoom-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for earlyoom"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit earlyoom"
makedepends=""
source="earlyoom"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/earlyoom" "$pkgdir/usr/lib/dinit.d/earlyoom"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../earlyoom" "$pkgdir/usr/lib/dinit.d/boot.d/earlyoom"
}

sha512sums="1c1a8669bb28317d5c2c17b174bcdb942fcccf8550baa2d7e0449de2f132c8cc  earlyoom"
