# dinit service: earlyoom (Alpine openrc earlyoom + overrides)
type = process
log-type = file
logfile = /var/log/dinit/earlyoom.log
command = /usr/lib/dinit/earlyoom
env-file = /etc/dinit.d/config/earlyoom.conf
smooth-recovery = true
restart = on-failure
depends-on = local.target
before = login.target
