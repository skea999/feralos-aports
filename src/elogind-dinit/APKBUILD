pkgname=elogind-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for elogind"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit elogind"
makedepends=""
source="elogind-dinit"

build() { return 0; }
check() { return 0; }

package() {
    install -Dm644 "$srcdir/elogind-dinit" "$pkgdir/usr/lib/dinit.d/elogind-dinit"
    mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
    ln -sf ../"elogind-dinit" "$pkgdir/usr/lib/dinit.d/boot.d/elogind-dinit"
}

