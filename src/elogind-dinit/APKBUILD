# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=elogind-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for elogind"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit elogind"
makedepends=""
source="elogind"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/elogind" "$pkgdir/usr/lib/dinit.d/elogind"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../elogind" "$pkgdir/usr/lib/dinit.d/boot.d/elogind"
}

sha512sums="c946b96c7e0c5ec669fd9a23c627988f74e921f2501fb1bfeae152e39ec77f0c  elogind"
