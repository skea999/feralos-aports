# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# dinit service for elogind (depends-on dbus, shutdown stop guard).
# Unit name = the OpenRC initd name (elogind, ADR-010 R1 amendment):
# explicitly-activated system services carry the initd name; the D-Bus
# override keeps the bus name (org.freedesktop.login1) and aliases onto this
# unit. Activation is routed through feralos-dbus-activate via the override
# packaged in /usr/share/dinit/dbus-system-services (materialized at boot
# into the launch helper's standard dirs).
pkgname=elogind-dinit
pkgver=0.1.0
pkgrel=13
pkgdesc="dinit service for elogind (depends-on dbus, shutdown stop guard)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit elogind dbus dbus-wait-for-dinit feralos-dbus-activate"
makedepends=""
source="elogind
	org.freedesktop.login1.service
	elogind-stop"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/elogind" \
		"$pkgdir/lib/dinit.d/elogind"
	# D-Bus activation override: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.freedesktop.login1.service" \
		"$pkgdir/usr/share/dinit/dbus-system-services/org.freedesktop.login1.service"
	# stop guard: pam_elogind (session tracker PAM stack) talks to elogind over
	# the system bus while sessions close at shutdown — dinit runs stop-command
	# INSTEAD of signalling the process (see elogind-stop header)
	install -Dm755 "$srcdir/elogind-stop" "$pkgdir/usr/libexec/elogind-dinit-stop"
}

sha512sums="
