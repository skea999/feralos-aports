# dinit service: elogind (auto-generated from Alpine openrc elogind)
# Unit name = the OpenRC initd name (elogind, ADR-010 R1 amendment):
# explicitly-activated system services carry the initd name; the D-Bus
# override keeps the bus name and aliases onto this unit. Activation is
# routed through feralos-dbus-activate via the override packaged in
# /usr/share/feralos/dbus-system-services/org.freedesktop.login1.service
# (installed at boot into /usr/local/share/dbus-1/system-services by
# dbus-services-setup).
# Sibling dinit units depend on `elogind`.
# dbus dependency: elogind registers on the system bus; without dbus up
# first it logs "Failed to connect to system bus" and restarts (run
# 2026-09-26 serial noise).
# stop-command: pam_elogind (in the session tracker's PAM stack) talks to
# elogind over the bus while sessions close at shutdown — dinit stops
# dependencies on release, not on dependent exit. Script waits (bounded)
# for turnstiled, then stops elogind itself; see
# /usr/libexec/elogind-dinit-stop.
type = process
log-type = file
logfile = /var/log/dinit/elogind.log
command = /usr/lib/dinit/dbus-wait-for -s -f 4 -n org.freedesktop.login1 /usr/libexec/elogind/elogind
ready-notification = pipefd:4
smooth-recovery = true
depends-on = local.target
depends-on = dbus
before = login.target
stop-command = /usr/libexec/elogind-dinit-stop
stop-timeout = 30
