# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# evolution-data-server factories on the session bus. ADR-010: the D-Bus
# activation targets Sources5/AddressBook10/Calendar8/UserPrompter0 route
# through feralos-dbus-activate to per-user dinit units named after the bus
# names; the overrides are packaged in /usr/share/dinit/dbus-services
# (materialized at login into $XDG_RUNTIME_DIR/dbus-1/services).
# Transitional units: the harness check dbus_activation_migration retires
# them once dbus-broker is installed and every activation target has a
# package-shipped unit.
pkgname=evolution-data-server-user-dinit
pkgver=0.1.0
pkgrel=3
pkgdesc="user dinit services for evolution-data-server (D-Bus activation targets)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="feralos-dbus-activate evolution-data-server"
makedepends=""
source="org.gnome.evolution.dataserver.Sources5.user
	org.gnome.evolution.dataserver.Sources5.service
	org.gnome.evolution.dataserver.AddressBook10.user
	org.gnome.evolution.dataserver.AddressBook10.service
	org.gnome.evolution.dataserver.Calendar8.user
	org.gnome.evolution.dataserver.Calendar8.service
	org.gnome.evolution.dataserver.UserPrompter0.user
	org.gnome.evolution.dataserver.UserPrompter0.service"

build() { return 0; }
check() { return 0; }

package() {
	for unit in Sources5 AddressBook10 Calendar8 UserPrompter0; do
		install -Dm644 "$srcdir/org.gnome.evolution.dataserver.$unit.user" \
			"$pkgdir/etc/dinit.d/user/org.gnome.evolution.dataserver.$unit.user"
		install -Dm644 "$srcdir/org.gnome.evolution.dataserver.$unit.service" \
			"$pkgdir/usr/share/dinit/dbus-services/org.gnome.evolution.dataserver.$unit.service"
	done
}

