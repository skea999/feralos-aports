# feralos evolution-data-server-user-dinit: D-Bus activation target for
# org.gnome.evolution.dataserver.AddressBook10 (ADR-010). Transitional unit.
type = process
command = /usr/libexec/evolution-addressbook-factory
# Idle-exit daemon: when it exits the unit stops (activation restarts it); do NOT respawn.
smooth-recovery = false
restart = false
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.gnome.evolution.dataserver.AddressBook10.log
depends-on = dbus.user
