# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=fail2ban-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for fail2ban"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
# fail2ban-openrc ships /etc/init.d/fail2ban (the OpenRC fallback unit; the
# installer's rules enablement drives BOTH inits from the same service name)
depends="dinit fail2ban fail2ban-openrc"
makedepends=""
source="fail2ban fail2ban.script fail2ban.conf"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/fail2ban" "$pkgdir/lib/dinit.d/fail2ban"
	install -Dm755 "$srcdir/fail2ban.script" "$pkgdir/usr/lib/dinit/fail2ban"
	install -Dm644 "$srcdir/fail2ban.conf" "$pkgdir/etc/dinit.d/config/fail2ban.conf"
}

sha512sums="
