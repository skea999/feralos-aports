# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# BOTH-INIT override package: the Alpine fail2ban-openrc initd has
# depend() need logger (busybox syslogd — vector replaced it), so it can
# never start on FeralOS. This package ships the dinit unit AND a
# dependency-free OpenRC replacement at the same /etc/init.d/fail2ban path
# (apk keeps future fail2ban-openrc updates as .apk-new — klogd-openrc
# precedent); `replaces` retires the vendor -openrc subpackage.
pkgname=fail2ban-dinit
pkgver=0.1.0
pkgrel=2
pkgdesc="dinit + OpenRC services for fail2ban (FeralOS both-inits override)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit fail2ban"
replaces="fail2ban-openrc"
makedepends=""
source="fail2ban fail2ban.script fail2ban.conf fail2ban.initd"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/fail2ban" "$pkgdir/lib/dinit.d/fail2ban"
	install -Dm755 "$srcdir/fail2ban.script" "$pkgdir/usr/lib/dinit/fail2ban"
	install -Dm644 "$srcdir/fail2ban.conf" "$pkgdir/etc/dinit.d/config/fail2ban.conf"
	install -Dm755 "$srcdir/fail2ban.initd" "$pkgdir/etc/init.d/fail2ban"
}

sha512sums="
