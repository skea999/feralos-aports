# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# feralos-branding-cli: the FeralOS CLI identity (ADR-013 wave C). The
# RIGHT file for the OS identity is /usr/lib/os-release (/etc/os-release is
# the vendor SYMLINK to it) — the installer never touched it, so the target
# stayed "Alpine Linux" everywhere. This package takes over:
#   - /usr/lib/os-release — NAME=FeralOS, ID=feralos, ID_LIKE=alpine (tooling
#     friendly), PRETTY_NAME with the Alpine base
#   - /etc/issue — the TTY login banner (alpine-release owns it)
#   - /etc/motd — the console/SSH banner (alpine-baselayout owns it)
# /etc/alpine-release stays VENDOR on purpose (owner decision 2026-11-24):
# 3.24.2 is the honest base version and the file is read by Alpine tooling.
# replaces retires the vendor files — future alpine-release upgrades leave
# ours as .apk-new (the klogd-openrc takeover precedent).
pkgname=feralos-branding-cli
pkgver=0.1.0
pkgrel=0
pkgdesc="FeralOS CLI identity: os-release, issue, motd (Alpine takeover)"
url="https://github.com/skea999/feralos-aports"
arch="noarch"
license="ISC"
depends=""
replaces="alpine-release alpine-baselayout"
makedepends=""
source="os-release issue motd"
options="!check" # static identity files, exercised by the os_identity harness check

package() {
	install -Dm644 "$srcdir/os-release" "$pkgdir/usr/lib/os-release"
	install -Dm644 "$srcdir/issue" "$pkgdir/etc/issue"
	install -Dm644 "$srcdir/motd" "$pkgdir/etc/motd"
}
sha512sums="
