# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# feralos-branding: the CANONICAL FeralOS branding assets in ONE staging
# dir (/usr/share/feralos/branding/) that the consumers pick up:
#   - niri-base-config symlinks the wallpapers (/usr/share/wallpapers/) —
#     shared between both DEs (the regreet background points there)
#   - wayle-config + dms-config symlink the logo into the system hicolor
#     dir (per-DE identity: the Wayle launcher button + Raffi + the DMS
#     surface resolve `icon-name = "feralos-logo"` there)
# SYMLINK consumers on purpose (owner decision 2026-11-24): a rebrand of
# ONE file in the staging dir propagates everywhere instantly — no DE
# config reinstall needed.
pkgname=feralos-branding
pkgver=0.1.0
pkgrel=0
pkgdesc="FeralOS canonical branding assets (logo + wallpapers) in the shared staging dir"
url="https://github.com/skea999/feralos-aports"
arch="noarch"
license="ISC"
depends=""
makedepends=""
source="feralos-logo.svg feralos-wallpaper-1080p.png feralos-wallpaper-1440p.png"
options="!check" # static assets

package() {
	install -d "$pkgdir/usr/share/feralos/branding"
	install -m644 "$srcdir/feralos-logo.svg" \
		"$pkgdir/usr/share/feralos/branding/feralos-logo.svg"
	install -m644 "$srcdir/feralos-wallpaper-1080p.png" \
		"$pkgdir/usr/share/feralos/branding/feralos-wallpaper-1080p.png"
	install -m644 "$srcdir/feralos-wallpaper-1440p.png" \
		"$pkgdir/usr/share/feralos/branding/feralos-wallpaper-1440p.png"
}
sha512sums="
