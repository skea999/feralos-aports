# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# feralos-dbus-activate: uniform D-Bus activation shim (ADR-010).
# Every dbus-activatable FeralOS service is a dinit service; the effective
# .service file Exec points here, the shim forwards the activation environment
# to dinit and starts the unit. See docs/architecture/dbus-activation.md in
# the feralos repository.
pkgname=feralos-dbus-activate
pkgver=0.1.0
pkgrel=1
pkgdesc="FeralOS D-Bus activation shim: activation always starts a dinit service"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="dinit"
makedepends=""
source="dbus-activate"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm755 "$srcdir/dbus-activate" "$pkgdir/usr/libexec/feralos/dbus-activate"
}

sha512sums="549a71410319abb4e0668557a512ac2c2367ac39972eeca5d5db0c1376d55e07217606768e3d5ddd37fa1e6fd0d442990b22c6d5c095d4d1ee81a32c08971ef6  dbus-activate"
