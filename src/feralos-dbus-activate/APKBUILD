# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# feralos-dbus-activate: uniform D-Bus activation shim (ADR-010).
# Every dbus-activatable FeralOS service is a dinit service; the effective
# .service file Exec points here, the shim forwards the activation environment
# to dinit and starts the unit. See docs/architecture/dbus-activation.md in
# the feralos repository.
# Ships dbus-services-setup (dinit unit + OpenRC initd, both before dbus):
# it materializes the packaged system-bus overrides from
# /usr/share/dinit/dbus-system-services into /usr/local/share/dbus-1/
# system-services — the setuid launch helper's trivial parser resolves names
# only against the standard dirs, never the /etc override tree
# (daemon-enumerated only, not helper-searched).
pkgname=feralos-dbus-activate
pkgver=0.1.0
pkgrel=3
pkgdesc="FeralOS D-Bus activation shim: activation always starts a dinit service"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="dinit"
makedepends=""
source="dbus-activate
	dbus-system-services-setup
	dbus-services-setup
	dbus-services-setup.initd"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm755 "$srcdir/dbus-activate" "$pkgdir/usr/libexec/dinit/dbus-activate"
	install -Dm755 "$srcdir/dbus-system-services-setup" "$pkgdir/usr/libexec/dinit/dbus-system-services-setup"
	install -Dm644 "$srcdir/dbus-services-setup" "$pkgdir/lib/dinit.d/dbus-services-setup"
	install -Dm755 "$srcdir/dbus-services-setup.initd" "$pkgdir/etc/init.d/dbus-services-setup"
}

sha512sums="
