# Maintainer: FeralOS <dev@feralos.org>
# feralos-dbus-audit: ADR-010 supervision audit — the FIRST package built
# from the feralos repository itself (standalone Go binary under
# src/firstBoot/dbus-audit). Rule (feralos docs/adr/ADR-010, R1b): the
# audit AUTO-INSTALLS the supervision packages — it scans BOTH activation
# inventories (session /usr/share/dbus-1/services and system
# /usr/share/dbus-1/system-services), checks the unit for every target
# (bus-name + binary-name conventions, plus the packaged FeralOS overrides
# that alias the bus name onto the unit, e.g. org.freedesktop.login1 ->
# elogind) and installs the daemon-named counterpart (<who-owns-Exec>-user-dinit /
# -dinit, then the bus name which resolves provides= aliases). The
# installer passes --no-fail (always exit 0 — never blocks an interactive
# install); the boot oneshot and CLI stay strict (exit 1 = the post-install
# signal the user must notice). Runs install-time
# (installer, chroot step 8a), boot-time (the oneshot units shipped here)
# and manually (CLI).
pkgname=feralos-dbus-audit
pkgver=0.1.0
pkgrel=3
pkgdesc="FeralOS D-Bus supervision audit (ADR-010): activation targets must be dinit units"
url="https://github.com/skea999/feralos"
arch="all"
license="ISC"
# source = the feralos git repo at the commit this package was cut from
# (GitHub strips the sha in the extracted dir: feralos-<sha>)
_commit=f33e8bd7709ce382acf9be6a1443c5cc2288e02e
source="$pkgname-$pkgver.tar.gz::https://github.com/skea999/feralos/archive/$_commit/feralos-$_commit.tar.gz
	feralos-dbus-audit.dinit
	feralos-dbus-audit.initd"
builddir="$srcdir/feralos-$_commit"
makedepends="go"
# dinit per the feralos-dbus-activate precedent (the oneshot unit is only
# consumed under dinit; OpenRC keeps its own initd in this package)
depends="dinit"
# go build may need the network for module/toolchain resolution (abuild
# warns without it); go mod download in prepare() pins the module graph
options="net"

prepare() {
	default_prepare
	# module deps of the imported utils/shell package (yaml/term/x/sys):
	# download once in prepare (network convention), build stays --mod=readonly
	cd "$builddir"/src
	export GOPATH="$srcdir/gopath"
	export GOCACHE="$srcdir/gocache"
	go mod download
}

build() {
	cd "$builddir"/src/firstBoot/dbus-audit
	export GOPATH="$srcdir/gopath"
	export GOCACHE="$srcdir/gocache"
	export CGO_ENABLED=0
	go build -trimpath -o "$srcdir"/feralos-dbus-audit .
}

check() {
	# NOT the real scan: the shared-root smoke installs land arbitrary
	# activation files with no units — a scan here would be
	# nondeterministic. The --help probe proves the binary executes and
	# the flags are wired (flag pkg prints usage and exits 2 — grep on the
	# pipeline carries the result).
	"$srcdir"/feralos-dbus-audit --help 2>&1 | grep -q log-file
}

package() {
	install -Dm755 "$srcdir"/feralos-dbus-audit "$pkgdir"/usr/libexec/feralos/feralos-dbus-audit
	install -Dm644 "$builddir"/LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
	# boot oneshot (dinit): report to /var/log (the @var-log subvol —
	# hence depends-on local.target, the ursined lesson) before login.
	install -Dm644 "$srcdir"/feralos-dbus-audit.dinit "$pkgdir"/lib/dinit.d/feralos-dbus-audit
	# boot oneshot (OpenRC fallback)
	install -Dm755 "$srcdir"/feralos-dbus-audit.initd "$pkgdir"/etc/init.d/feralos-dbus-audit
}

sha512sums="
 f3b973f9bb8d9508ae6ffa0ff9bc802d463d404b0fe73c8bed690b8ac47b609ff9b3a2002efc080a122a20900658d9bc96bab4465d8b97e6baad7869461e44ae  feralos-dbus-audit-0.1.0.tar.gz
4b2b6eb566a1fdba0923adf8690360ac40fbcd41831070744455595eba84e89026c75df5a1b7aad7033eb019f2324a868f3c205890d01640230a77b7b6cbc18d  feralos-dbus-audit.dinit
449a7225086c25a80d8f38d00450aed0e25ef14c1bdd72f5ef1777567fe57ae52175d59b15a134d6d6b8253bb61ae0439e1b235bb4eb35401a9092f6a520295d  feralos-dbus-audit.initd
"
