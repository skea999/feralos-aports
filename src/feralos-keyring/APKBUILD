pkgname=feralos-keyring
pkgver=1
pkgrel=0
pkgdesc="FeralOS repository key and repo definition"
url="https://github.com/skea999/feralos-aports"
arch="noarch"
license="MIT"
depends=""
source="feralos.rsa.pub
	feralos.list"

package() {
	install -Dm644 "$srcdir/feralos.rsa.pub" "$pkgdir/etc/apk/keys/feralos.rsa.pub"
	install -Dm644 "$srcdir/feralos.list" "$pkgdir/etc/apk/repositories.d/feralos.list"
}

