# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=firewalld-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for firewalld"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit firewalld"
makedepends=""
source="firewalld"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/firewalld" "$pkgdir/usr/lib/dinit.d/firewalld"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../firewalld" "$pkgdir/usr/lib/dinit.d/boot.d/firewalld"
}

sha512sums="2305f84e9b2bb790494ee54a18aa09b31400859714e986f63ee01b7d3db12545  firewalld"
