# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=firewalld-dinit
pkgver=0.1.0
pkgrel=7
pkgdesc="dinit service for firewalld (--nofork, dbus ordering)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit firewalld"
makedepends=""
source="firewalld"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/firewalld" "$pkgdir/lib/dinit.d/firewalld"
}

