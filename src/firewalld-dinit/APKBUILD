pkgname=firewalld-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for firewalld"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit firewalld"
makedepends=""
source="firewalld-dinit"

build() { return 0; }
check() { return 0; }

package() {
    install -Dm644 "$srcdir/firewalld-dinit" "$pkgdir/usr/lib/dinit.d/firewalld-dinit"
    mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
    ln -sf ../"firewalld-dinit" "$pkgdir/usr/lib/dinit.d/boot.d/firewalld-dinit"
}

