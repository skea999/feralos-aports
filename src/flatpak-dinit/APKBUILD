# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# Flatpak system helper on the system bus. The unit is named after the bus
# name and D-Bus activation is routed through feralos-dbus-activate (ADR-010);
# the override is packaged in /usr/share/dinit/dbus-system-services
# (materialized at boot into the launch helper's standard dirs).
# System-wide flatpak installs go through this helper.
pkgname=flatpak-dinit
pkgver=0.1.0
pkgrel=4
pkgdesc="dinit service for the flatpak system helper"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit flatpak feralos-dbus-activate"
makedepends=""
source="org.freedesktop.Flatpak.SystemHelper
	org.freedesktop.Flatpak.SystemHelper.service"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/org.freedesktop.Flatpak.SystemHelper" \
		"$pkgdir/lib/dinit.d/org.freedesktop.Flatpak.SystemHelper"
	# D-Bus activation override: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.freedesktop.Flatpak.SystemHelper.service" \
		"$pkgdir/usr/share/dinit/dbus-system-services/org.freedesktop.Flatpak.SystemHelper.service"
}

sha512sums="
bfef4dc7fb4ae6e7cc73829bec9336e4731e09e1dbc2bf8f4df9211654a51054425505a89db14de502f4a5aeb3ecf84fae0d03cd4139e75b30ade608b7d507fa  org.freedesktop.Flatpak.SystemHelper
3defe88f38bfaa09febb8a65b09216b508259504f739d38a29be5722fc9895e5277006777d7a13c8bd342d24cb1c23244dbac5688ac4a748154e0502a3b823ad  org.freedesktop.Flatpak.SystemHelper.service
"
