# dinit service: flatpak system helper (system bus, system-wide installs)
# Unit name = system bus name: D-Bus activation is routed through the
# packaged override
# /usr/share/feralos/dbus-system-services/org.freedesktop.Flatpak.SystemHelper.service
# (installed at boot into /usr/local/share/dbus-1/system-services by
# dbus-services-setup), whose Exec starts this unit (ADR-010).
type = process
smooth-recovery = true
log-type = file
logfile = /var/log/dinit/org.freedesktop.Flatpak.SystemHelper.log
command = /usr/libexec/flatpak-system-helper
depends-on = dbus
