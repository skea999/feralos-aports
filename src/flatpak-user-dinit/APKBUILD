# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# User dinit services for the flatpak session stack. Unit names = canonical
# session D-Bus bus names (ADR-010); D-Bus activation is routed through
# feralos-dbus-activate via overrides in /usr/local/share/dbus-1/services/.
pkgname=flatpak-user-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="User dinit services for the flatpak session stack (session helper + portal + OCI authenticator)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="dinit flatpak feralos-dbus-activate"
makedepends=""
source="org.freedesktop.Flatpak.user org.freedesktop.portal.Flatpak.user
	org.flatpak.Authenticator.Oci.user org.freedesktop.Flatpak.service
	org.freedesktop.portal.Flatpak.service org.flatpak.Authenticator.Oci.service"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/org.freedesktop.Flatpak.user" \
		"$pkgdir/etc/dinit.d/user/org.freedesktop.Flatpak.user"
	install -Dm644 "$srcdir/org.freedesktop.portal.Flatpak.user" \
		"$pkgdir/etc/dinit.d/user/org.freedesktop.portal.Flatpak.user"
	install -Dm644 "$srcdir/org.flatpak.Authenticator.Oci.user" \
		"$pkgdir/etc/dinit.d/user/org.flatpak.Authenticator.Oci.user"
	# D-Bus activation overrides: the effective Exec starts the dinit unit.
	for s in org.freedesktop.Flatpak org.freedesktop.portal.Flatpak \
		org.flatpak.Authenticator.Oci; do
		install -Dm644 "$srcdir/$s.service" \
			"$pkgdir/usr/local/share/dbus-1/services/$s.service"
	done
}

