# dinit user service: flatpak session helper (org.freedesktop.Flatpak)
# Session helper for the flatpak sandbox. Unit name = canonical D-Bus bus
# name (ADR-010); D-Bus activation is routed through
# /usr/local/share/dbus-1/services/org.freedesktop.Flatpak.service.
type = process
smooth-recovery = true
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.freedesktop.Flatpak.log
command = /usr/libexec/flatpak-session-helper
working-dir = $HOME
depends-on = dbus.user
