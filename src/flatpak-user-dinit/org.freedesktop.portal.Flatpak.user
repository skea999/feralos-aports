# dinit user service: flatpak portal (org.freedesktop.portal.Flatpak)
# Portal for apps inside the flatpak sandbox. Unit name = canonical D-Bus bus
# name (ADR-010); D-Bus activation is routed through
# /usr/local/share/dbus-1/services/org.freedesktop.portal.Flatpak.service.
type = process
smooth-recovery = true
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.freedesktop.portal.Flatpak.log
command = /usr/libexec/flatpak-portal
working-dir = $HOME
depends-on = dbus.user
