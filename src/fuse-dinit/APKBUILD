pkgname=fuse-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for fuse"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit fuse"
makedepends=""
source="fuse-dinit"

build() { return 0; }
check() { return 0; }

package() {
    install -Dm644 "$srcdir/fuse-dinit" "$pkgdir/usr/lib/dinit.d/fuse-dinit"
    mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
    ln -sf ../"fuse-dinit" "$pkgdir/usr/lib/dinit.d/boot.d/fuse-dinit"
}

