# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=fuse-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for fuse"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit fuse"
makedepends=""
source="fuse"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/fuse" "$pkgdir/usr/lib/dinit.d/fuse"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../fuse" "$pkgdir/usr/lib/dinit.d/boot.d/fuse"
}

sha512sums="5c10d60ec013ce7e14e2812b7f88f4dcfd60a667b1cf5c55589ed7ace371f941  fuse"
