# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=fuse-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for fuse"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit fuse"
makedepends=""
source="fuse"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/fuse" "$pkgdir/usr/lib/dinit.d/fuse"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../fuse" "$pkgdir/usr/lib/dinit.d/boot.d/fuse"
}

sha512sums="5e3738112afadae33e6a3001c9945f68d778092dcff79836d7c26347820c6cdef08819c481d05bd1775203621aec771def42245ceac0efbd207d1f9d66614534  fuse"
