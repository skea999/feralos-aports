# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=fuse-dinit
pkgver=0.1.0
pkgrel=5
pkgdesc="dinit service for fuse (best-effort module load)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit fuse"
makedepends=""
source="fuse dinit-fuse"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/fuse" "$pkgdir/lib/dinit.d/fuse"
	install -Dm755 "$srcdir/dinit-fuse" "$pkgdir/usr/libexec/dinit-fuse"
}

