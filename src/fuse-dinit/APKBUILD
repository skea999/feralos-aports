pkgname=fuse-dinit
pkgver=0.1.0
pkgrel=2
pkgdesc="dinit service for fuse"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit fuse"
makedepends=""
source="fuse"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/fuse" "$pkgdir/lib/dinit.d/fuse"
}

