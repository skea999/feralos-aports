# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# Unit name = system bus name. D-Bus activation (.service override packaged
# in /usr/share/feralos/dbus-system-services, materialized at boot into the
# launch helper's standard dirs) starts this unit through feralos-dbus-activate.
# The wrapper/config keep their fwupd names (they are internal to the unit).
pkgname=fwupd-dinit
pkgver=0.1.0
pkgrel=7
pkgdesc="dinit service for fwupd"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit fwupd feralos-dbus-activate"
makedepends=""
source="org.freedesktop.fwupd fwupd.script fwupd.conf
	org.freedesktop.fwupd.service"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/org.freedesktop.fwupd" \
		"$pkgdir/lib/dinit.d/org.freedesktop.fwupd"
	install -Dm755 "$srcdir/fwupd.script" "$pkgdir/usr/lib/dinit/fwupd"
	install -Dm644 "$srcdir/fwupd.conf" "$pkgdir/etc/dinit.d/config/fwupd.conf"
	# D-Bus activation override: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.freedesktop.fwupd.service" \
		"$pkgdir/usr/share/feralos/dbus-system-services/org.freedesktop.fwupd.service"
}

