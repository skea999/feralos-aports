# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=fwupd-dinit
pkgver=0.1.0
pkgrel=5
pkgdesc="dinit service for fwupd"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit fwupd"
makedepends=""
source="fwupd fwupd.script fwupd.conf"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/fwupd" "$pkgdir/lib/dinit.d/fwupd"
	install -Dm755 "$srcdir/fwupd.script" "$pkgdir/usr/lib/dinit/fwupd"
	install -Dm644 "$srcdir/fwupd.conf" "$pkgdir/etc/dinit.d/config/fwupd.conf"
}

