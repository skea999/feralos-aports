# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=fwupd-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for fwupd"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit fwupd"
makedepends=""
source="fwupd"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/fwupd" "$pkgdir/usr/lib/dinit.d/fwupd"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../fwupd" "$pkgdir/usr/lib/dinit.d/boot.d/fwupd"
}

sha512sums="03343e93470e48a3a6b8972a8b57791965fd7261aafb36cca282ab245393e329  fwupd"
