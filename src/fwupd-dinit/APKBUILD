# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=fwupd-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for fwupd"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit fwupd"
makedepends=""
source="fwupd"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/fwupd" "$pkgdir/usr/lib/dinit.d/fwupd"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../fwupd" "$pkgdir/usr/lib/dinit.d/boot.d/fwupd"
}

sha512sums="e952b113d789397d7f62031ea0e6925f223bdc1eec9a46c9795920a6608d25ffdb6d0ccefd51016a7336e07b6d04f10d135ef33c83aa22db4c553af0636db04f  fwupd"
