# dinit service: fwupd (Alpine openrc fwupd + overrides)
# Unit name = system bus name: D-Bus activation is routed through
# /usr/share/dinit/dbus-system-services/org.freedesktop.fwupd.service
# (installed at boot into /usr/local/share/dbus-1/system-services by
# dbus-services-setup), whose Exec starts this unit (ADR-010).
type = process
# dbus-activated on-demand: smooth-recovery off — a clean idle exit stops the
# unit (the next activation restarts it); restart=on-failure covers crashes.
smooth-recovery = false
restart = on-failure
log-type = file
logfile = /var/log/dinit/org.freedesktop.fwupd.log
command = /usr/lib/dinit/fwupd
env-file = /etc/dinit.d/config/fwupd.conf
depends-on = local.target
before = login.target
