# dinit service: fwupd (Alpine openrc fwupd + overrides)
# Unit name = system bus name: D-Bus activation is routed through
# /etc/dbus-1/system-services/org.freedesktop.fwupd.service, whose Exec
# starts this unit (ADR-010).
type = process
smooth-recovery = true
log-type = file
logfile = /var/log/dinit/org.freedesktop.fwupd.log
command = /usr/lib/dinit/fwupd
env-file = /etc/dinit.d/config/fwupd.conf
depends-on = local.target
before = login.target
