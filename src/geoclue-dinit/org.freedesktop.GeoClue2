# feralos geoclue-dinit: D-Bus activation target for org.freedesktop.GeoClue2 (ADR-010).
# Transitional: drop when the package (or dbus-broker ephemeral services) ships this
# unit itself. geoclue exits after 60s of inactivity by default — activation-only
# semantics preserved (the unit stops when idle; the next activation restarts it).
type = process
command = /usr/libexec/geoclue
run-as = geoclue
smooth-recovery = true
restart = false
log-type = file
logfile = /var/log/dinit/org.freedesktop.GeoClue2.log
depends-on = dbus
