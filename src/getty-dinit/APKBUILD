# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=getty-dinit
pkgver=0.1.0
pkgrel=2
pkgdesc="getty service template for dinit (tty1 + ttyS0)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit agetty"
makedepends=""
source="getty"

build() { return 0; }

check() { return 0; }

package() {
	# Alpine model: ship the template body only; enablement is rules-driven
	# (dinitctl enable getty@tty1 / getty@ttyS0 — instance name carries $1)
	install -Dm644 "$srcdir/getty" "$pkgdir/lib/dinit.d/getty"
}

sha512sums="
d41f4add683fbf5df9185eed8d36a5f598d1c8c1bbc9db2ec1cd66c12c94b984cd4b65272402272df771bc7082cbadc3ef207a6aa4e82ff2b098213d3043a14f  getty
"
