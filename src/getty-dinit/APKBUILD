# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=getty-dinit
pkgver=0.1.0
pkgrel=5
pkgdesc="getty service template for dinit (tty1 + ttyS0)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit agetty"
makedepends=""
source="getty getty.script getty.conf"

build() { return 0; }

check() { return 0; }

package() {
	# Alpine model: ship the template body only; enablement is rules-driven
	# (dinitctl enable getty@tty1 / getty@ttyS0 — instance name carries $1)
	# baud/term/args live in /etc/dinit.d/config/getty.conf (Artix
	# dinit-rc agetty-default pattern); wrapper resolves them at start
	install -Dm644 "$srcdir/getty" "$pkgdir/lib/dinit.d/getty"
	install -Dm755 "$srcdir/getty.script" "$pkgdir/usr/lib/dinit/getty"
	install -Dm644 "$srcdir/getty.conf" "$pkgdir/etc/dinit.d/config/getty.conf"
}

