# dinit template: getty@ (FeralOS — upstream dinit-chimera ships no getty)
# The instance name carries the argument: getty@tty1 -> $1 = tty1
# -L: local line (no carrier wait — serial has no DCD in QEMU)
# agetty syntax: agetty [options] PORT [baud] — port FIRST, then baud
# baud/term/extra args come from /etc/dinit.d/config/getty.conf via the
# /usr/lib/dinit/getty wrapper (Artix dinit-rc agetty-default pattern)
# depends-on login.target (DINIT-AS-INIT: tty services depend on loginready;
# never set runs-on-console on tty services — conflicts with login.target)
type = process
command = /usr/lib/dinit/getty $1
termsignal = HUP
restart = true
smooth-recovery = true
depends-on = login.target
