# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# User dinit service for glib-networking's PACRunner. Unit name = canonical
# session D-Bus bus name (ADR-010); D-Bus activation is routed through
# feralos-dbus-activate via the override in /usr/share/dinit/dbus-services/.
# Binary path source-verified in the Alpine glib-networking 2.80.1 APK
# contents (/usr/libexec/glib-pacrunner).
pkgname=glib-networking-user-dinit
pkgver=0.1.0
pkgrel=2
pkgdesc="User dinit service for glib-networking PACRunner"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="dinit glib-networking feralos-dbus-activate"
makedepends=""
source="org.gtk.GLib.PACRunner.user org.gtk.GLib.PACRunner.service"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/org.gtk.GLib.PACRunner.user" \
		"$pkgdir/etc/dinit.d/user/org.gtk.GLib.PACRunner.user"
	# D-Bus activation override: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.gtk.GLib.PACRunner.service" \
		"$pkgdir/usr/share/dinit/dbus-services/org.gtk.GLib.PACRunner.service"
}

sha512sums="
