# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# GNOME app-launch activation targets on the session bus. ADR-010: the
# D-Bus activation targets org.gnome.Calendar / DiskUtility / Firmware / Maps
# route through feralos-dbus-activate to per-user dinit units named after
# the bus names; the overrides are packaged in /usr/share/feralos/dbus-services
# (materialized at login into $XDG_RUNTIME_DIR/dbus-1/services).
# Transitional units: the harness check dbus_activation_migration retires
# them once dbus-broker is installed and every activation target has a
# package-shipped unit.
pkgname=gnome-apps-user-dinit
pkgver=0.1.0
pkgrel=1
pkgdesc="user dinit services for GNOME app-launch activation targets"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="feralos-dbus-activate gnome-calendar gnome-disk-utility gnome-firmware gnome-maps"
makedepends=""
source="org.gnome.Calendar.user org.gnome.Calendar.service
	org.gnome.DiskUtility.user org.gnome.DiskUtility.service
	org.gnome.Firmware.user org.gnome.Firmware.service
	org.gnome.Maps.user org.gnome.Maps.service"

build() { return 0; }
check() { return 0; }

package() {
	for app in Calendar DiskUtility Firmware Maps; do
		install -Dm644 "$srcdir/org.gnome.$app.user" \
			"$pkgdir/etc/dinit.d/user/org.gnome.$app.user"
		install -Dm644 "$srcdir/org.gnome.$app.service" \
			"$pkgdir/usr/share/feralos/dbus-services/org.gnome.$app.service"
	done
}

