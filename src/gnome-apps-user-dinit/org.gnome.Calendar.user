# feralos gnome-apps-user-dinit: D-Bus activation target for org.gnome.Calendar
# (ADR-010). Transitional: drop when the package (or dbus-broker ephemeral services)
# ships this unit itself. GUI app in GApplication service mode.
type = process
command = /usr/bin/gnome-calendar --gapplication-service
smooth-recovery = false
restart = false
working-dir = $HOME
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.gnome.Calendar.log
depends-on = dbus.user
