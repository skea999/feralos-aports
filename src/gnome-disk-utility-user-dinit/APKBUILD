# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# User dinit services for gnome-disk-utility (session D-Bus activation target, ADR-010).
# The package is named after the owner of the activation Exec binary (apk
# owner = gnome-disk-utility, R1b purity): the audit's who-owns candidate resolves the
# package by its own name. Evidence (pkgs.alpinelinux.org file search,
# v3.24 x86_64):
#   org.gnome.DiskUtility  Exec /usr/bin/gnome-disks --gapplication-service -> gnome-disk-utility
# D-Bus activation is routed through feralos-dbus-activate via the override
# in /usr/share/dinit/dbus-services/ (materialized at login into
# $XDG_RUNTIME_DIR/dbus-1/services).
pkgname=gnome-disk-utility-user-dinit
pkgver=0.1.0
pkgrel=2
pkgdesc="user dinit services for gnome-disk-utility (D-Bus activation target)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="feralos-dbus-activate gnome-disk-utility"
makedepends=""
source="org.gnome.DiskUtility.user
	org.gnome.DiskUtility.service"

build() { return 0; }
check() { return 0; }

package() {
	# D-Bus activation override: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.gnome.DiskUtility.service" \
		"$pkgdir/usr/share/dinit/dbus-services/org.gnome.DiskUtility.service"
	install -Dm644 "$srcdir/org.gnome.DiskUtility.user" \
		"$pkgdir/etc/dinit.d/user/org.gnome.DiskUtility.user"
}

sha512sums="
a9474391fb20715cc88daea2bed2ea7bdc2c746d2cfc30e8df083ac5328e216dd11f9dfadff5593da012493f0c5a3e8d0f8f99e12423a4e257a234cf7eff4ac7  org.gnome.DiskUtility.user
85247f6153e94c75de0444d733256bd4feda82cc001e368ff8d047214eeddba6eca3ebb4f98bcfc835bc0ca457c1b1bed5ce887020a315d56960ba2bf45d9e87  org.gnome.DiskUtility.service
"
