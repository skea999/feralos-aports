# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# User dinit services for gnome-firmware (session D-Bus activation target, ADR-010).
# The package is named after the owner of the activation Exec binary (apk
# owner = gnome-firmware, R1b purity): the audit's who-owns candidate resolves the
# package by its own name. Evidence (pkgs.alpinelinux.org file search,
# v3.24 x86_64):
#   org.gnome.Firmware  Exec /usr/bin/gnome-firmware --gapplication-service -> gnome-firmware
# D-Bus activation is routed through feralos-dbus-activate via the override
# in /usr/share/dinit/dbus-services/ (materialized at login into
# $XDG_RUNTIME_DIR/dbus-1/services).
pkgname=gnome-firmware-user-dinit
pkgver=0.1.0
pkgrel=2
pkgdesc="user dinit services for gnome-firmware (D-Bus activation target)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="feralos-dbus-activate gnome-firmware"
makedepends=""
source="org.gnome.Firmware.user
	org.gnome.Firmware.service"

build() { return 0; }
check() { return 0; }

package() {
	# D-Bus activation override: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.gnome.Firmware.service" \
		"$pkgdir/usr/share/dinit/dbus-services/org.gnome.Firmware.service"
	install -Dm644 "$srcdir/org.gnome.Firmware.user" \
		"$pkgdir/etc/dinit.d/user/org.gnome.Firmware.user"
}

sha512sums="
834b70944fc23d3477a14641c24e0b53be9f1216ee3717aefd8adb9453c989784577c86c73a5f150db99617b68134972208a78cae7decc80126fd7183c94ebca  org.gnome.Firmware.user
1954802adb6441f77aca5978a842b86809c41582d19c0856a3aa03e6f08f28a999f86d13b669e8e571c7c50f6ae6e9dcf129d6c7890132b950d7ff047e914b2d  org.gnome.Firmware.service
"
