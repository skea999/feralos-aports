# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# gnome-keyring/seahorse activation targets on the session bus (niri DE).
# ADR-010: the secret service (org.freedesktop.secrets plus the org.gnome.keyring
# and org.freedesktop.impl.portal.Secret aliases) routes through
# feralos-dbus-activate to the per-user dinit unit org.freedesktop.secrets.user;
# the gcr prompter and seahorse get their own units. The overrides are packaged
# in /usr/share/dinit/dbus-services (materialized at login into
# $XDG_RUNTIME_DIR/dbus-1/services). Transitional units: the harness check
# dbus_activation_migration retires them once dbus-broker is installed and
# every activation target has a package-shipped unit.
pkgname=gnome-keyring-user-dinit
pkgver=0.1.0
pkgrel=2
pkgdesc="user dinit services for gnome-keyring/seahorse activation targets"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="feralos-dbus-activate gnome-keyring gcr seahorse"
makedepends=""
source="org.freedesktop.secrets.user org.freedesktop.secrets.service
	org.freedesktop.impl.portal.Secret.service org.gnome.keyring.service
	org.gnome.keyring.PrivatePrompter.user org.gnome.keyring.PrivatePrompter.service
	org.gnome.keyring.SystemPrompter.service
	org.gnome.seahorse.Application.user org.gnome.seahorse.Application.service"

build() { return 0; }
check() { return 0; }

package() {
	for unit in org.freedesktop.secrets.user \
		org.gnome.keyring.PrivatePrompter.user \
		org.gnome.seahorse.Application.user; do
		install -Dm644 "$srcdir/$unit" "$pkgdir/etc/dinit.d/user/$unit"
	done
	# D-Bus activation overrides: the effective Exec starts the dinit units.
	for svc in org.freedesktop.secrets.service \
		org.freedesktop.impl.portal.Secret.service org.gnome.keyring.service \
		org.gnome.keyring.PrivatePrompter.service \
		org.gnome.keyring.SystemPrompter.service \
		org.gnome.seahorse.Application.service; do
		install -Dm644 "$srcdir/$svc" \
			"$pkgdir/usr/share/dinit/dbus-services/$svc"
	done
}

