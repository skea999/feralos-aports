# feralos gnome-keyring-user-dinit: D-Bus activation target for the secret
# service (org.freedesktop.secrets; aliases org.gnome.keyring and
# org.freedesktop.impl.portal.Secret) (ADR-010). Transitional: drop when the
# package (or dbus-broker ephemeral services) ships this unit itself.
type = process
command = /usr/bin/gnome-keyring-daemon --start --foreground --components=secrets
smooth-recovery = true
restart = false
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.freedesktop.secrets.log
depends-on = dbus.user
