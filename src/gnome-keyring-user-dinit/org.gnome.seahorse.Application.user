# feralos gnome-keyring-user-dinit: D-Bus activation target for seahorse
# (org.gnome.seahorse.Application) (ADR-010). Transitional unit; GUI app in
# GApplication service mode.
type = process
command = /usr/bin/seahorse --gapplication-service
smooth-recovery = false
restart = false
working-dir = $HOME
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.gnome.seahorse.Application.log
depends-on = dbus.user
