# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# User dinit services for gnome-maps (session D-Bus activation target, ADR-010).
# The package is named after the owner of the activation Exec binary (apk
# owner = gnome-maps, R1b purity): the audit's who-owns candidate resolves the
# package by its own name. Evidence (pkgs.alpinelinux.org file search,
# v3.24 x86_64):
#   org.gnome.Maps  Exec /usr/share/gnome-maps/org.gnome.Maps --gapplication-service -> gnome-maps
# D-Bus activation is routed through feralos-dbus-activate via the override
# in /usr/share/dinit/dbus-services/ (materialized at login into
# $XDG_RUNTIME_DIR/dbus-1/services).
pkgname=gnome-maps-user-dinit
pkgver=0.1.0
pkgrel=1
pkgdesc="user dinit services for gnome-maps (D-Bus activation target)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="feralos-dbus-activate gnome-maps"
makedepends=""
source="org.gnome.Maps.user
	org.gnome.Maps.service"

build() { return 0; }
check() { return 0; }

package() {
	# D-Bus activation override: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.gnome.Maps.service" \
		"$pkgdir/usr/share/dinit/dbus-services/org.gnome.Maps.service"
	install -Dm644 "$srcdir/org.gnome.Maps.user" \
		"$pkgdir/etc/dinit.d/user/org.gnome.Maps.user"
}

sha512sums="
b561005d72b5416609e43670140a6685ce11853ea5c611cea56e31135383acfb33b2f85c78a3ca37b85a7abe7733810bf9031eaec423f714088019cca23285db  org.gnome.Maps.user
d52a621d3161cf35286b66b650515fd1ce6b4ac85d79fafc6d96b6281bad33ed87b9f03152861c87cb9fa339c6d62b1b2c39dc1e06224af6f40b204842bdf846  org.gnome.Maps.service
"
