# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# gnome-online-accounts on the session bus. ADR-010: the D-Bus activation
# targets org.gnome.OnlineAccounts and org.gnome.Identity route through
# feralos-dbus-activate to per-user dinit units named after the bus names;
# the overrides are packaged in /usr/share/dinit/dbus-services
# (materialized at login into $XDG_RUNTIME_DIR/dbus-1/services).
# Transitional units: the harness check dbus_activation_migration retires
# them once dbus-broker is installed and every activation target has a
# package-shipped unit.
pkgname=gnome-online-accounts-user-dinit
pkgver=0.1.0
pkgrel=3
pkgdesc="user dinit service for gnome-online-accounts (D-Bus activation targets)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="feralos-dbus-activate gnome-online-accounts"
makedepends=""
source="org.gnome.OnlineAccounts.user org.gnome.OnlineAccounts.service
	org.gnome.Identity.user org.gnome.Identity.service"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/org.gnome.OnlineAccounts.user" \
		"$pkgdir/etc/dinit.d/user/org.gnome.OnlineAccounts.user"
	install -Dm644 "$srcdir/org.gnome.Identity.user" \
		"$pkgdir/etc/dinit.d/user/org.gnome.Identity.user"
	# D-Bus activation overrides: the effective Exec starts the dinit units.
	install -Dm644 "$srcdir/org.gnome.OnlineAccounts.service" \
		"$pkgdir/usr/share/dinit/dbus-services/org.gnome.OnlineAccounts.service"
	install -Dm644 "$srcdir/org.gnome.Identity.service" \
		"$pkgdir/usr/share/dinit/dbus-services/org.gnome.Identity.service"
}

sha512sums="
