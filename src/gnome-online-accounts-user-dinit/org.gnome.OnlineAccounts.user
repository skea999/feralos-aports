# feralos gnome-online-accounts-user-dinit: D-Bus activation target for
# org.gnome.OnlineAccounts (ADR-010). Transitional: drop when the package (or
# dbus-broker ephemeral services) ships this unit itself.
type = process
command = /usr/libexec/goa-daemon
smooth-recovery = true
restart = false
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.gnome.OnlineAccounts.log
depends-on = dbus.user
