# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=greetd-dinit
pkgver=0.1.0
pkgrel=8
pkgdesc="dinit service for greetd"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit greetd"
makedepends=""
source="greetd greetd.script greetd.conf"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/greetd" "$pkgdir/lib/dinit.d/greetd"
	install -Dm755 "$srcdir/greetd.script" "$pkgdir/usr/lib/dinit/greetd"
	install -Dm644 "$srcdir/greetd.conf" "$pkgdir/etc/dinit.d/config/greetd.conf"
}

