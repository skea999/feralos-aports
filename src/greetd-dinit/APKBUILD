# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=greetd-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for greetd"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit greetd"
makedepends=""
source="greetd"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/greetd" "$pkgdir/usr/lib/dinit.d/greetd"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../greetd" "$pkgdir/usr/lib/dinit.d/boot.d/greetd"
}

sha512sums="078bc74e70de7e12f82f9d0db01033d9c3e781e479643d790f89e036dbf3b342  greetd"
