# dinit service: greetd (Alpine ships the binary in /usr/sbin, not /usr/bin)
type = process
log-type = file
logfile = /var/log/dinit/greetd.log
command = /usr/lib/dinit/greetd
env-file = /etc/dinit.d/config/greetd.conf
restart = true
smooth-recovery = true
depends-on = login.target
depends-on = elogind
