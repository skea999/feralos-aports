# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# hardening-config: the FeralOS hardening package family — everything the
# hardening feature needs, pulled in as ONE dependency of the installer's
# hardening feature (ADR-013 R2). This package carries:
#   - the STATIC hardened sysctl drop-ins and the module blacklist
#   - the DEPENDENCY list of the whole family (apparmor stack, clamav stack
#     incl. clamav-config, the set-permissions posture package)
# The debug-dependent values are NOT shipped relaxed: when the installer
# runs with enableDebug it writes /etc/sysctl.d/99-feralos-debug.conf
# (sorts after these files — per-key last wins) relaxing exactly
# kernel.printk / dmesg_restrict / io_uring_disabled / memfd_noexec.
pkgname=hardening-config
pkgver=0.1.0
pkgrel=3
pkgdesc="FeralOS hardening family: static sysctl drop-ins, module blacklist, family dependencies"
url="https://github.com/skea999/feralos-aports"
arch="noarch"
license="ISC"
depends="bubblewrap apparmor apparmor-profiles libapparmor apparmor-utils
	clamav-daemon clamav-scanner clamav-db freshclam clamav-config
	set-permissions"
makedepends=""
source="hardening-config.post-install 93-ipv4Configs.conf 94-limitLogs.conf 95-randomizeAddresses.conf
	96-disableSuidDumps.conf 97-disableCoreDumps.conf 98-hardening.conf
	99-cmdline-hardening.conf bridging.conf disabledModules.conf 00-umask.sh"
install="$pkgname.post-install"
options="!check" # static config, applied by sysctl --system / modprobe

package() {
	install -Dm644 "$srcdir/93-ipv4Configs.conf" "$pkgdir/etc/sysctl.d/93-ipv4Configs.conf"
	install -Dm644 "$srcdir/94-limitLogs.conf" "$pkgdir/etc/sysctl.d/94-limitLogs.conf"
	install -Dm644 "$srcdir/95-randomizeAddresses.conf" "$pkgdir/etc/sysctl.d/95-randomizeAddresses.conf"
	install -Dm644 "$srcdir/96-disableSuidDumps.conf" "$pkgdir/etc/sysctl.d/96-disableSuidDumps.conf"
	install -Dm644 "$srcdir/97-disableCoreDumps.conf" "$pkgdir/etc/sysctl.d/97-disableCoreDumps.conf"
	install -Dm644 "$srcdir/98-hardening.conf" "$pkgdir/etc/sysctl.d/98-hardening.conf"
	install -Dm644 "$srcdir/99-cmdline-hardening.conf" "$pkgdir/etc/sysctl.d/99-cmdline-hardening.conf"
	install -Dm644 "$srcdir/bridging.conf" "$pkgdir/etc/sysctl.d/bridging.conf"
	install -Dm644 "$srcdir/disabledModules.conf" "$pkgdir/etc/modprobe.d/disabledModules.conf"
	install -Dm644 "$srcdir/00-umask.sh" "$pkgdir/etc/profile.d/00-umask.sh"
}
