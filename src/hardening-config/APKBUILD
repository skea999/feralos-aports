# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# hardening-config: the STATIC hardening files as an APK package (ADR-013 —
# the installer no longer writes them). Values are the hardened defaults.
#
# Split note: sysctls whose value depends on variables stay installer-written
# — 94-limitLogs.conf (kernel.printk), 98-hardening.conf (io_uring/memfd via
# enableDebug), 99-cmdline-hardening.conf (dmesg_restrict via enableDebug) and
# zswap.conf (vm.min_free_kbytes from RAM). Static leftovers are a follow-up
# (split the debug override out of 98/99).
pkgname=hardening-config
pkgver=0.1.0
pkgrel=0
pkgdesc="FeralOS static hardening config (sysctl drop-ins, module blacklist)"
url="https://github.com/skea999/feralos-aports"
arch="noarch"
license="ISC"
depends=""
makedepends=""
source="93-ipv4Configs.conf 95-randomizeAddresses.conf 96-disableSuidDumps.conf
	97-disableCoreDumps.conf bridging.conf disabledModules.conf"
options="!check" # static config, applied by sysctl --system / modprobe

package() {
	install -Dm644 "$srcdir/93-ipv4Configs.conf" "$pkgdir/etc/sysctl.d/93-ipv4Configs.conf"
	install -Dm644 "$srcdir/95-randomizeAddresses.conf" "$pkgdir/etc/sysctl.d/95-randomizeAddresses.conf"
	install -Dm644 "$srcdir/96-disableSuidDumps.conf" "$pkgdir/etc/sysctl.d/96-disableSuidDumps.conf"
	install -Dm644 "$srcdir/97-disableCoreDumps.conf" "$pkgdir/etc/sysctl.d/97-disableCoreDumps.conf"
	install -Dm644 "$srcdir/bridging.conf" "$pkgdir/etc/sysctl.d/bridging.conf"
	install -Dm644 "$srcdir/disabledModules.conf" "$pkgdir/etc/modprobe.d/disabledModules.conf"
}
sha512sums="
