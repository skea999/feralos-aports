# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# dinit user service for hyprsunset (blue-light filter). Completeness per
# the Alpine model: the service ships with the app and is INSTALLED but
# never enabled — nothing boot-links or session-links hyprsunset.user; the
# Wayle night-light module still execs the binary on demand. Start manually
# with `dinitctl --user start hyprsunset` (temperature/gamma via the ADR-008
# config file). The installer's dinit conversion picks this package up
# automatically when hyprsunset-openrc is present (it is NOT in
# dinitSkipSessionManaged).
pkgname=hyprsunset-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit user service for hyprsunset (installed-but-unused by default)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="hyprsunset wayland-wait-user-dinit"
makedepends=""
source="hyprsunset.user hyprsunset-run hyprsunset.conf"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/hyprsunset.user" "$pkgdir/etc/dinit.d/user/hyprsunset.user"
	install -Dm755 "$srcdir/hyprsunset-run" "$pkgdir/etc/dinit.d/user/scripts/hyprsunset-run"
	install -Dm644 "$srcdir/hyprsunset.conf" "$pkgdir/etc/dinit.d/config/hyprsunset.conf"
}

sha512sums="
