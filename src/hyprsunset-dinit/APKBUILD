4fa6a6d926939074f472a1408273b433307f9e25166b5c23cb622d7764f5cea07ef35adb514968ae445852a35594a1c662ab8e8d74029b7295f649e08289ee42  hyprsunset-run
291b247b57d169e40973fd29d9447dc56597760802114606f2bbfb040c431f7b323c2c7855b33d774bd09093eb1c36217ea04af99ec42c738d4355338e029c1e  hyprsunset.conf
"
