#!/bin/sh
# hyprsunset launcher (ADR-008 wrapper): source the user-editable config,
# resolve the compositor wayland socket (guaranteed by the wait-wayland.user
# dependency), then exec the daemon supervised.
[ -r /etc/dinit.d/config/hyprsunset.conf ] && . /etc/dinit.d/config/hyprsunset.conf
HYPRSUNSET_TEMP="${HYPRSUNSET_TEMP:-3400}"
HYPRSUNSET_GAMMA="${HYPRSUNSET_GAMMA:-1.0}"
for s in "$XDG_RUNTIME_DIR"/wayland-*; do
    [ -S "$s" ] && export WAYLAND_DISPLAY="${s##*/}"
done
exec /usr/bin/hyprsunset -t "$HYPRSUNSET_TEMP" -g "$HYPRSUNSET_GAMMA"
