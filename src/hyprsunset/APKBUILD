# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# hyprsunset: blue-light filter (Hyprland ecosystem) — absent from Alpine
# stable (testing only). Ported from Alpine's testing APKBUILD (0.4.0):
# same cmake/samurai build, source pinned to the upstream GitHub TAG
# archive (extracted dir = hyprsunset-$pkgver, GitHub strips the v).
# Dropped vs Alpine: $pkgname-doc (upstream ships NO man page — empty
# subpackage), $pkgname-openrc + hyprsunset.initd (OpenRC user-session
# supervisor; FeralOS spawns the binary on demand — the Wayle night-light
# module execs it directly). No depends=: runtime libs are auto-detected
# via abuild's so: tracing.
pkgname=hyprsunset
pkgver=0.4.0
pkgrel=0
pkgdesc="Application to enable a blue-light filter"
url="https://github.com/hyprwm/hyprsunset"
arch="all"
license="BSD-3-Clause"
makedepends="
	cmake
	samurai
	hyprwayland-scanner
	wayland-dev
	wayland-protocols
	hyprland-protocols
	hyprutils-dev
	hyprlang-dev
	sdbus-cpp-dev
"
options="!check" # currently there are no tests
source="https://github.com/hyprwm/hyprsunset/archive/refs/tags/v$pkgver/hyprsunset-$pkgver.tar.gz"

build() {
	cmake -S . -B ./build -G Ninja \
		-DCMAKE_BUILD_TYPE:STRING=Release \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_PREFIX:PATH=/usr

	cmake --build ./build --config Release
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	rm -r "$pkgdir"/usr/lib/systemd

	install -Dm0644 -t "$pkgdir"/usr/share/licenses/"$pkgname" LICENSE
}

sha512sums="
bab883e31406af5e740cf07ac2a11b07e4420e4c4a1915bb23caca2888db771356c88d8c4f263ad8d4efe2f92a86f16ecffeff8d60881c3d1f14bb42cae93c79  hyprsunset-0.4.0.tar.gz
"
