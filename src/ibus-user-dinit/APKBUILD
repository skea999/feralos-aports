# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# User dinit services for ibus. Unit names = canonical session D-Bus bus names
# (ADR-010); D-Bus activation is routed through feralos-dbus-activate via
# overrides in /usr/share/dinit/dbus-services/.
# Verified on Alpine 3.24: both binaries ship in the ibus package —
# /usr/bin/ibus-daemon (org.freedesktop.IBus, upstream Exec with
# --replace --panel disable --xim) and /usr/lib/ibus/ibus-portal
# (org.freedesktop.portal.IBus).
# Transitional units: the harness check dbus_activation_migration retires
# them once dbus-broker is installed and every activation target has a
# package-shipped unit.
pkgname=ibus-user-dinit
pkgver=0.1.0
pkgrel=2
pkgdesc="User dinit services for ibus (IBus + portal activation targets)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="feralos-dbus-activate ibus"
makedepends=""
source="org.freedesktop.IBus.user org.freedesktop.IBus.service
	org.freedesktop.portal.IBus.user org.freedesktop.portal.IBus.service"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/org.freedesktop.IBus.user" \
		"$pkgdir/etc/dinit.d/user/org.freedesktop.IBus.user"
	install -Dm644 "$srcdir/org.freedesktop.portal.IBus.user" \
		"$pkgdir/etc/dinit.d/user/org.freedesktop.portal.IBus.user"
	# D-Bus activation overrides: the effective Exec starts the dinit units.
	install -Dm644 "$srcdir/org.freedesktop.IBus.service" \
		"$pkgdir/usr/share/dinit/dbus-services/org.freedesktop.IBus.service"
	install -Dm644 "$srcdir/org.freedesktop.portal.IBus.service" \
		"$pkgdir/usr/share/dinit/dbus-services/org.freedesktop.portal.IBus.service"
}

