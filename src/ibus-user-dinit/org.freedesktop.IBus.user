# feralos ibus-user-dinit: D-Bus activation target for org.freedesktop.IBus
# (ADR-010).
# Transitional: drop when the package (or dbus-broker ephemeral services) ships
# this unit itself.
type = process
command = /usr/bin/ibus-daemon --replace --panel disable --xim
smooth-recovery = true
restart = false
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.freedesktop.IBus.log
depends-on = dbus.user
