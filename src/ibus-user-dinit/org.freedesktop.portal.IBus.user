# feralos ibus-user-dinit: D-Bus activation target for
# org.freedesktop.portal.IBus (ADR-010).
# Transitional: drop when the package (or dbus-broker ephemeral services) ships
# this unit itself.
type = process
command = /usr/lib/ibus/ibus-portal
smooth-recovery = true
restart = false
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.freedesktop.portal.IBus.log
depends-on = dbus.user
