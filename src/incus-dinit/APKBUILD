# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=incus-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="incus service for dinit"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit incus"
makedepends=""
source="incus"

build() {
	# nothing to build
	return 0
}

check() {
	# nothing to test
	return 0
}

package() {
	install -Dm644 "$srcdir/incus" "$pkgdir/usr/lib/dinit.d/incus"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf ../incus "$pkgdir/usr/lib/dinit.d/boot.d/incus"
}

sha512sums="142ce25d7dd4a75147eaec61fd077253fd44110e2337e57fbc33d3f5ab5ee9e5604f1dd12063f455e7ec78fb14bfdde8248fd935bdcba217e2cafc57f71fa08d  incus"
