# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=incus-dinit
pkgver=0.1.0
pkgrel=2
pkgdesc="dinit service for incusd (Alpine initd name)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit incus"
makedepends=""
source="incusd"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/incusd" "$pkgdir/lib/dinit.d/incusd"
}

