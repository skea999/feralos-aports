pkgname=incus-feature-agent-dinit
pkgver=0.1.0
pkgrel=2
pkgdesc="dinit service for incus-feature-agent"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit incus-feature"
makedepends=""
source="incus-feature-agent"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/incus-feature-agent" "$pkgdir/lib/dinit.d/incus-feature-agent"
	mkdir -p "$pkgdir/lib/dinit.d/boot.d"
	ln -sf "../incus-feature-agent" "$pkgdir/lib/dinit.d/boot.d/incus-feature-agent"
}

