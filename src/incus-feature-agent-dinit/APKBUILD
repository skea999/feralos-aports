pkgname=incus-feature-agent-dinit
pkgver=0.1.0
pkgrel=4
pkgdesc="dinit service for incus-agent (Alpine initd name)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit incus-feature"
makedepends=""
source="incus-agent"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/incus-agent" "$pkgdir/lib/dinit.d/incus-agent"
}

