pkgname=incus-feature-agent-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="incus feature agent service for dinit"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit incus-feature"
makedepends=""
source="incus-feature-agent"

build() {
	# nothing to build
	return 0
}

check() {
	# nothing to test
	return 0
}

package() {
	install -Dm644 "$srcdir/incus-feature-agent" "$pkgdir/usr/lib/dinit.d/incus-feature-agent"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf ../incus-feature-agent "$pkgdir/usr/lib/dinit.d/boot.d/incus-feature-agent"
}

