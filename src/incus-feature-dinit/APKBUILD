pkgname=incus-feature-dinit
pkgver=0.1.0
pkgrel=2
pkgdesc="dinit service for incusd (incus-feature hosts)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit incus-feature"
makedepends=""
source="incusd"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/incusd" "$pkgdir/lib/dinit.d/incusd"
}

