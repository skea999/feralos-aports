# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=incus-feature-dinit
pkgver=0.1.0
pkgrel=3
pkgdesc="dinit service for incusd (incus-feature hosts)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit incus-feature"
makedepends=""
source="incusd incusd.script incusd.conf"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/incusd" "$pkgdir/lib/dinit.d/incusd"
	install -Dm755 "$srcdir/incusd.script" "$pkgdir/usr/lib/dinit/incusd"
	install -Dm644 "$srcdir/incusd.conf" "$pkgdir/etc/dinit.d/config/incusd.conf"
}

