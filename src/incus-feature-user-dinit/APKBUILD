pkgname=incus-feature-user-dinit
pkgver=0.1.0
pkgrel=1
pkgdesc="dinit service for incus-feature-user"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit incus-feature"
makedepends=""
source="incus-feature-user"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/incus-feature-user" "$pkgdir/lib/dinit.d/incus-feature-user"
	mkdir -p "$pkgdir/lib/dinit.d/boot.d"
	ln -sf "../incus-feature-user" "$pkgdir/lib/dinit.d/boot.d/incus-feature-user"
}

