build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/incus-feature-user" "$pkgdir/lib/dinit.d/incus-feature-user"
}

