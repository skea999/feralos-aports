# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=iptables-dinit
pkgver=0.1.0
pkgrel=6
pkgdesc="dinit service for iptables (restore saved ruleset)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit iptables"
makedepends=""
source="iptables dinit-iptables iptables.conf"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/iptables" "$pkgdir/lib/dinit.d/iptables"
	install -Dm755 "$srcdir/dinit-iptables" "$pkgdir/usr/libexec/dinit-iptables"
	install -Dm644 "$srcdir/iptables.conf" "$pkgdir/etc/dinit.d/config/iptables.conf"
}

