pkgname=iptables-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for iptables"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit iptables"
makedepends=""
source="iptables-dinit"

build() { return 0; }
check() { return 0; }

package() {
    install -Dm644 "$srcdir/iptables-dinit" "$pkgdir/usr/lib/dinit.d/iptables-dinit"
    mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
    ln -sf ../"iptables-dinit" "$pkgdir/usr/lib/dinit.d/boot.d/iptables-dinit"
}

