# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=iptables-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for iptables"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit iptables"
makedepends=""
source="iptables"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/iptables" "$pkgdir/usr/lib/dinit.d/iptables"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../iptables" "$pkgdir/usr/lib/dinit.d/boot.d/iptables"
}

sha512sums="27283f5f7375c7ad3bf22ddbe69bec66dc1fd184a103adb3756380f2cda03ae0c0e9d1174a1d6624c0ccea268bd84d1f7555801776307253ac8a72a679a1da74  iptables"
