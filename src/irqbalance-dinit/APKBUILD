# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=irqbalance-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for irqbalance"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit irqbalance"
makedepends=""
source="irqbalance"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/irqbalance" "$pkgdir/usr/lib/dinit.d/irqbalance"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../irqbalance" "$pkgdir/usr/lib/dinit.d/boot.d/irqbalance"
}

sha512sums="abe3c4b53b954c84b918eec8a0524f4ac2343fe3994fc3d51c1a22c7ab7d6dfb  irqbalance"
