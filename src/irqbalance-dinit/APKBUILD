# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=irqbalance-dinit
pkgver=0.1.0
pkgrel=6
pkgdesc="dinit service for irqbalance"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit irqbalance"
makedepends=""
source="irqbalance irqbalance.script irqbalance.conf"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/irqbalance" "$pkgdir/lib/dinit.d/irqbalance"
	install -Dm755 "$srcdir/irqbalance.script" "$pkgdir/usr/lib/dinit/irqbalance"
	install -Dm644 "$srcdir/irqbalance.conf" "$pkgdir/etc/dinit.d/config/irqbalance.conf"
}

