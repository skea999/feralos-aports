pkgname=irqbalance-dinit
pkgver=0.1.0
pkgrel=3
pkgdesc="dinit service for irqbalance"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit irqbalance"
makedepends=""
source="irqbalance"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/irqbalance" "$pkgdir/lib/dinit.d/irqbalance"
}

