pkgname=irqbalance-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for irqbalance"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit irqbalance"
makedepends=""
source="irqbalance"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/irqbalance" "$pkgdir/usr/lib/dinit.d/irqbalance"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../irqbalance" "$pkgdir/usr/lib/dinit.d/boot.d/irqbalance"
}

