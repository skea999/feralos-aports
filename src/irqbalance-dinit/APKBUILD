# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=irqbalance-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="irqbalance service for dinit"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit irqbalance"
makedepends=""
source="irqbalance"

build() {
	# nothing to build
	return 0
}

check() {
	# nothing to test
	return 0
}

package() {
	install -Dm644 "$srcdir/irqbalance" "$pkgdir/usr/lib/dinit.d/irqbalance"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf ../irqbalance "$pkgdir/usr/lib/dinit.d/boot.d/irqbalance"
}

