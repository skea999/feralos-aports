# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# kcron's KAuth helper on the system bus. ADR-010: the D-Bus activation
# target local.kcron.crontab routes through feralos-dbus-activate to a dinit
# unit named after the bus name; the override is packaged in
# /usr/share/dinit/dbus-system-services (materialized at boot into the
# launch helper's standard dirs). Transitional units: the harness check
# dbus_activation_migration retires them once dbus-broker is installed and
# every activation target has a package-shipped unit.
pkgname=kcron-dinit
pkgver=0.1.0
pkgrel=3
pkgdesc="dinit service for kcron's KAuth helper (D-Bus activation target)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="feralos-dbus-activate kcron"
makedepends=""
source="local.kcron.crontab local.kcron.crontab.service"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/local.kcron.crontab" \
		"$pkgdir/lib/dinit.d/local.kcron.crontab"
	# D-Bus activation override: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/local.kcron.crontab.service" \
		"$pkgdir/usr/share/dinit/dbus-system-services/local.kcron.crontab.service"
}

sha512sums="
2f1fbdc8938314bac857e21a02545f3bc7e1ade3d22c73f6563bc21adc3218674c5323d46b048cc7d8d2a3b2d759af2f856300732bafecbe84693bbda3931201  local.kcron.crontab
0257749fe27ac2c718aaca18cc036cd4040b80e1c471db2097ba734da3c8a802ce5172c0baecc6f5c2330475d69afff8e6f584cf5e1733a1befbfa43a9a3fc49  local.kcron.crontab.service
"
