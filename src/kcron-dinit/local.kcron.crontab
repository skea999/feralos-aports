# feralos kcron-dinit: D-Bus activation target for local.kcron.crontab (ADR-010).
# Transitional: drop when the package (or dbus-broker ephemeral services) ships this
# unit itself. kcron_helper is a short-lived KAuth helper (one D-Bus call at a time):
# no smooth-recovery, the unit stops when the helper exits.
type = process
command = /usr/lib/libexec/kf6/kauth/kcron_helper
run-as = root
smooth-recovery = false
restart = false
log-type = file
logfile = /var/log/dinit/local.kcron.crontab.log
depends-on = dbus
