# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# User dinit service for kded. Unit name = canonical session D-Bus bus name
# (ADR-010); D-Bus activation is routed through feralos-dbus-activate via an
# override in /usr/share/feralos/dbus-services/.
pkgname=kded-user-dinit
pkgver=0.1.0
pkgrel=1
pkgdesc="User dinit service for kded"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="dinit kded feralos-dbus-activate"
makedepends=""
source="org.kde.kded6.user org.kde.kded6.service"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/org.kde.kded6.user" \
		"$pkgdir/etc/dinit.d/user/org.kde.kded6.user"
	# D-Bus activation override: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.kde.kded6.service" \
		"$pkgdir/usr/share/feralos/dbus-services/org.kde.kded6.service"
}

sha512sums="
