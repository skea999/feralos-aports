# dinit user service: kded6 (org.kde.kded6)
# KDE daemon (KF6). Unit name = canonical D-Bus bus name (ADR-010); D-Bus
# activation is routed through
# /usr/local/share/dbus-1/services/org.kde.kded6.service.
type = process
smooth-recovery = true
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.kde.kded6.log
command = /usr/bin/kded6
working-dir = $HOME
depends-on = dbus.user
