# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# User dinit service for kglobalaccel. Unit name = canonical session D-Bus
# bus name (ADR-010); D-Bus activation is routed through feralos-dbus-activate
# via an override in /usr/share/feralos/dbus-services/.
# Verified on Alpine 3.24: the unit command is /usr/bin/kglobalaccel5 —
# parity with the upstream activation Exec; the binary ships in the
# kglobalaccel5 package (pulled by plasma), hence the dependency adaptation.
# Transitional unit: the harness check dbus_activation_migration retires it
# once dbus-broker is installed and every activation target has a
# package-shipped unit.
pkgname=kglobalaccel-user-dinit
pkgver=0.1.0
pkgrel=2
pkgdesc="User dinit service for kglobalaccel"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="feralos-dbus-activate kglobalaccel5"
makedepends=""
source="org.kde.kglobalaccel.user org.kde.kglobalaccel.service"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/org.kde.kglobalaccel.user" \
		"$pkgdir/etc/dinit.d/user/org.kde.kglobalaccel.user"
	# D-Bus activation override: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.kde.kglobalaccel.service" \
		"$pkgdir/usr/share/feralos/dbus-services/org.kde.kglobalaccel.service"
}

sha512sums="
801c894b4bcb69681db30e10a7806f653174e6d2b98008fb59a895cfbe96a0c6a2242d6a8b442a8abcf6140ff8aaaca1b0d530103f3a2c1f49971fca373964fb  org.kde.kglobalaccel.user
ada6860429a2df5fe455d25bb693f7d408b7aae9f4c9704956b57e398b47b9fa85c1b8ad64bae1b42fb8013bec5ace18c074e5266bd7dabfb726477d9bbf7bab  org.kde.kglobalaccel.service
"
