# feralos kglobalaccel-user-dinit: D-Bus activation target for
# org.kde.kglobalaccel (ADR-010).
# Transitional: drop when the package (or dbus-broker ephemeral services) ships
# this unit itself.
type = process
command = /usr/bin/kglobalaccel5
smooth-recovery = true
restart = false
working-dir = $HOME
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.kde.kglobalaccel.log
depends-on = dbus.user
