# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# KIO Fuse filesystem bridge on the session bus (ADR-010). The D-Bus activation target
# org.kde.KIOFuse routes through feralos-dbus-activate to a per-user dinit unit named
# after the bus name; the override ships in /usr/share/feralos/dbus-services
# (materialized at login into $XDG_RUNTIME_DIR/dbus-1/services).
# Transitional units: the harness check dbus_activation_migration retires
# them once dbus-broker is installed and every activation target has a
# package-shipped unit.
pkgname=kio-fuse-user-dinit
pkgver=0.1.0
pkgrel=1
pkgdesc="user dinit service for org.kde.KIOFuse (D-Bus activation target)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="feralos-dbus-activate kio-fuse"
makedepends=""
source="org.kde.KIOFuse.user org.kde.KIOFuse.service"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/org.kde.KIOFuse.user" \
		"$pkgdir/etc/dinit.d/user/org.kde.KIOFuse.user"
	# D-Bus activation override: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.kde.KIOFuse.service" \
		"$pkgdir/usr/share/feralos/dbus-services/org.kde.KIOFuse.service"
}
sha512sums="
