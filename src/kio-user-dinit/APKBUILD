# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# User dinit services for kio (KF6). Unit names = canonical session D-Bus
# bus names (ADR-010); D-Bus activation is routed through
# feralos-dbus-activate via overrides in /usr/share/feralos/dbus-services/.
# All five bus names (org.kde.kiod6, kioexecd6, kpasswdserver6, kssld6,
# kmtpd5) are served by the SAME binary — /usr/lib/libexec/kf6/kiod6 —
# because KIO's auxiliary daemons are plugins loaded by kiod6;
# source-verified in the Alpine APK contents (all five shipped .service
# files carry Exec=/usr/lib/libexec/kf6/kiod6, no per-daemon binaries
# exist). org.kde.kmtpd5.service + the mtpd5 module ship in kio-extras;
# the activation file only exists when kio-extras is installed, so the
# unit is inert otherwise.
pkgname=kio-user-dinit
pkgver=0.1.0
pkgrel=1
pkgdesc="User dinit services for kio (kiod6 + kioexecd/kpasswdserver/kssld)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="dinit kio feralos-dbus-activate"
makedepends=""
source="org.kde.kiod6.user org.kde.kioexecd6.user
	org.kde.kpasswdserver6.user org.kde.kssld6.user org.kde.kmtpd5.user
	org.kde.kiod6.service org.kde.kioexecd6.service
	org.kde.kpasswdserver6.service org.kde.kssld6.service org.kde.kmtpd5.service"

build() { return 0; }
check() { return 0; }

package() {
	for s in org.kde.kiod6 org.kde.kioexecd6 org.kde.kpasswdserver6 org.kde.kssld6 org.kde.kmtpd5; do
		install -Dm644 "$srcdir/$s.user" "$pkgdir/etc/dinit.d/user/$s.user"
		install -Dm644 "$srcdir/$s.service" \
			"$pkgdir/usr/share/feralos/dbus-services/$s.service"
	done
}

