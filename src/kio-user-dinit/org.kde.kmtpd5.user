# dinit user service: kiod6 serving org.kde.kmtpd5
# KIO MTP (libmtp) daemon — upstream's activation file execs the SAME kiod6
# binary (KIO daemons are plugins loaded by kiod6; source-verified in the
# Alpine 3.24 APKs: org.kde.kmtpd5.service in kio-extras carries
# Exec=/usr/lib/libexec/kf6/kiod6 like all the kio org.kde.k*.service files;
# the activation file + the mtpd5 module ship in kio-extras). Unit name =
# canonical session D-Bus bus name (ADR-010); D-Bus activation is routed
# through /usr/share/feralos/dbus-services/org.kde.kmtpd5.service.
type = process
smooth-recovery = true
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.kde.kmtpd5.log
command = /usr/lib/libexec/kf6/kiod6
working-dir = $HOME
depends-on = dbus.user
