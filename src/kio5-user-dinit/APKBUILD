# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# kio5 (KF5 legacy stack) on the session bus (kde DE). ADR-010: all four bus
# names (org.kde.kiod5, kioexecd, kpasswdserver, kssld5) are served by the
# SAME binary — /usr/lib/libexec/kf5/kiod5 — because the auxiliary daemons
# are plugins loaded by kiod5; ONE unit (org.kde.kiod5.user) + four override
# aliases. Overrides ship in /usr/share/feralos/dbus-services
# (materialized at login into $XDG_RUNTIME_DIR/dbus-1/services).
# Transitional units: the harness check dbus_activation_migration retires
# them once dbus-broker is installed and every activation target has a
# package-shipped unit.
# NOT covered: org.kde.kcookiejar5 — its upstream activation file Execs
# /usr/bin/kded5, which does not exist on Alpine 3.24 (broken upstream); a
# unit would advertise a target that cannot start.
pkgname=kio5-user-dinit
pkgver=0.1.0
pkgrel=1
pkgdesc="user dinit service for kio5 (kiod5 + kioexecd/kpasswdserver/kssld5 aliases)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="feralos-dbus-activate kio5"
makedepends=""
source="org.kde.kiod5.user
	org.kde.kiod5.service org.kde.kioexecd.service
	org.kde.kpasswdserver.service org.kde.kssld5.service"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/org.kde.kiod5.user" \
		"$pkgdir/etc/dinit.d/user/org.kde.kiod5.user"
	for s in org.kde.kiod5 org.kde.kioexecd org.kde.kpasswdserver org.kde.kssld5; do
		install -Dm644 "$srcdir/$s.service" \
			"$pkgdir/usr/share/feralos/dbus-services/$s.service"
	done
}
sha512sums="
