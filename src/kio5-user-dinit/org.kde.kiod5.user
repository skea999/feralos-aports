# feralos kio5-user-dinit: D-Bus activation target for org.kde.kiod5 (ADR-010).
# Transitional: drop when the package (or dbus-broker ephemeral services) ships
# this unit itself.
# KIO KF5 daemon: kioexecd/kpasswdserver/kssld5 are plugins of kiod5.
type = process
command = /usr/lib/libexec/kf5/kiod5
smooth-recovery = true
restart = false
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.kde.kiod5.log
depends-on = dbus.user
