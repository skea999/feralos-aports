# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=klogd-dinit
pkgver=0.1.0
pkgrel=1
pkgdesc="dinit service for klogd (busybox) — kernel ring to /dev/log (vector kern.log)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit busybox"
makedepends=""
source="klogd dinit-klogd klogd.conf klogd-dinit.tmpfiles"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (boot.d)
	install -Dm644 "$srcdir/klogd" "$pkgdir/lib/dinit.d/klogd"
	install -Dm755 "$srcdir/dinit-klogd" "$pkgdir/usr/libexec/dinit-klogd"
	install -Dm644 "$srcdir/klogd.conf" "$pkgdir/etc/dinit.d/config/klogd.conf"
	# /var/log/dinit must exist before the service writes its logfile
	install -Dm644 "$srcdir/klogd-dinit.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/klogd-dinit.conf"
}

