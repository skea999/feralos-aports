# feralos knighttime-user-dinit: D-Bus activation target for
# org.kde.NightTime (ADR-010).
# Transitional: drop when the package (or dbus-broker ephemeral services) ships
# this unit itself.
type = process
command = /usr/lib/libexec/knighttimed
smooth-recovery = true
restart = false
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.kde.NightTime.log
depends-on = dbus.user
