# feralos kscreen-user-dinit: D-Bus activation target for
# org.kde.kscreen.osdService (ADR-010).
# Transitional: drop when the package (or dbus-broker ephemeral services) ships
# this unit itself.
type = process
command = /usr/lib/libexec/kscreen_osd_service
smooth-recovery = true
restart = false
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.kde.kscreen.osdService.log
depends-on = dbus.user
