# feralos ksystemstats-user-dinit: D-Bus activation target for
# org.kde.ksystemstats1 (ADR-010).
# Transitional: drop when the package (or dbus-broker ephemeral services) ships
# this unit itself.
type = process
command = /usr/bin/ksystemstats
smooth-recovery = true
restart = false
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.kde.ksystemstats1.log
depends-on = dbus.user
