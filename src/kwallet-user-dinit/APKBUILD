# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# User dinit services for kwallet. Unit names = canonical session D-Bus bus
# names (ADR-010); D-Bus activation is routed through feralos-dbus-activate
# via overrides in /usr/share/feralos/dbus-services/. The legacy
# org.kde.kwalletd5 alias maps to the SAME unit: Alpine's kwallet package
# ships no kwalletd5 binary and upstream's own kwalletd5 compat service file
# execs kwalletd6 too.
# org.kde.secretservicecompat and org.freedesktop.impl.portal.desktop.kwallet
# are served by the SEPARATE ksecretd binary (/usr/bin/ksecretd, verified in
# the Alpine kwallet 6.26.0 APK contents), hence their own units.
pkgname=kwallet-user-dinit
pkgver=0.1.0
pkgrel=2
pkgdesc="User dinit services for kwallet (kwalletd6 + ksecretd compat/portal)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="dinit kwallet feralos-dbus-activate"
makedepends=""
source="org.kde.kwalletd6.user org.kde.kwalletd6.service org.kde.kwalletd5.service
	org.kde.secretservicecompat.user org.kde.secretservicecompat.service
	org.freedesktop.impl.portal.desktop.kwallet.user
	org.freedesktop.impl.portal.desktop.kwallet.service"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/org.kde.kwalletd6.user" \
		"$pkgdir/etc/dinit.d/user/org.kde.kwalletd6.user"
	install -Dm644 "$srcdir/org.kde.secretservicecompat.user" \
		"$pkgdir/etc/dinit.d/user/org.kde.secretservicecompat.user"
	install -Dm644 "$srcdir/org.freedesktop.impl.portal.desktop.kwallet.user" \
		"$pkgdir/etc/dinit.d/user/org.freedesktop.impl.portal.desktop.kwallet.user"
	# D-Bus activation overrides: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.kde.kwalletd6.service" \
		"$pkgdir/usr/share/feralos/dbus-services/org.kde.kwalletd6.service"
	install -Dm644 "$srcdir/org.kde.kwalletd5.service" \
		"$pkgdir/usr/share/feralos/dbus-services/org.kde.kwalletd5.service"
	install -Dm644 "$srcdir/org.kde.secretservicecompat.service" \
		"$pkgdir/usr/share/feralos/dbus-services/org.kde.secretservicecompat.service"
	install -Dm644 "$srcdir/org.freedesktop.impl.portal.desktop.kwallet.service" \
		"$pkgdir/usr/share/feralos/dbus-services/org.freedesktop.impl.portal.desktop.kwallet.service"
}

