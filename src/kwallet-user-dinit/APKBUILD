# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# User dinit service for kwallet. Unit name = canonical session D-Bus bus name
# (ADR-010); D-Bus activation is routed through feralos-dbus-activate via
# overrides in /usr/share/feralos/dbus-services/. The legacy
# org.kde.kwalletd5 alias maps to the SAME unit: Alpine's kwallet package
# ships no kwalletd5 binary and upstream's own kwalletd5 compat service file
# execs kwalletd6 too.
pkgname=kwallet-user-dinit
pkgver=0.1.0
pkgrel=1
pkgdesc="User dinit service for kwallet (kwalletd6 + kwalletd5 alias)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="dinit kwallet feralos-dbus-activate"
makedepends=""
source="org.kde.kwalletd6.user org.kde.kwalletd6.service org.kde.kwalletd5.service"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/org.kde.kwalletd6.user" \
		"$pkgdir/etc/dinit.d/user/org.kde.kwalletd6.user"
	# D-Bus activation overrides: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.kde.kwalletd6.service" \
		"$pkgdir/usr/share/feralos/dbus-services/org.kde.kwalletd6.service"
	install -Dm644 "$srcdir/org.kde.kwalletd5.service" \
		"$pkgdir/usr/share/feralos/dbus-services/org.kde.kwalletd5.service"
}

sha512sums="
