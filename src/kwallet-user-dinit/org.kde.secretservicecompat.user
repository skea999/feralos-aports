# dinit user service: ksecretd serving org.kde.secretservicecompat
# KDE Secret Service compatibility daemon (exposes the freedesktop Secret
# Service API backed by KWallet). Upstream's activation file execs
# /usr/bin/ksecretd (source-verified in the Alpine kwallet 6.26.0 APK)
# — hence its own unit. Unit name = canonical session D-Bus bus name
# (ADR-010); D-Bus activation is routed through
# /usr/share/feralos/dbus-services/org.kde.secretservicecompat.service.
type = process
smooth-recovery = true
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.kde.secretservicecompat.log
command = /usr/bin/ksecretd
working-dir = $HOME
depends-on = dbus.user
