# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# User dinit services for localsearch (GNOME file indexer). Unit names =
# canonical session D-Bus bus names (ADR-010); D-Bus activation is routed
# through feralos-dbus-activate via overrides in /usr/share/dinit/dbus-services/.
# Mapping (source-verified against GNOME/localsearch 3.9.0 meson + service
# templates + src/indexer/tracker-main.c and Alpine v3.22 contents):
#   org.freedesktop.LocalSearch3[.Control|.Writeback]  -> localsearch-3 /
#       localsearch-control-3 / localsearch-writeback-3 (canonical units)
#   org.freedesktop.Tracker3.Miner.Files[.Control] / Tracker3.Writeback
#       -> legacy aliases, mapped to the same three units (the daemons claim
#       both name families)
#   localsearch-extractor-3 has no D-Bus name (spawned by the indexer) -> no
#       unit and no activation file.
#   org.freedesktop.portal.Tracker -> tinysparql-xdg-portal-3 (its OWN unit:
#       the portal ships in the tinysparql package — Alpine v3.24 APK
#       contents — not in localsearch; tinysparql is a localsearch dep).
pkgname=localsearch-user-dinit
pkgver=0.1.0
pkgrel=4
pkgdesc="User dinit services for localsearch (indexer + control + writeback)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="dinit localsearch tinysparql feralos-dbus-activate"
makedepends=""
source="org.freedesktop.LocalSearch3.user org.freedesktop.LocalSearch3.Control.user
	org.freedesktop.LocalSearch3.Writeback.user
	org.freedesktop.portal.Tracker.user
	org.freedesktop.LocalSearch3.service org.freedesktop.Tracker3.Miner.Files.service
	org.freedesktop.LocalSearch3.Control.service org.freedesktop.Tracker3.Miner.Files.Control.service
	org.freedesktop.LocalSearch3.Writeback.service org.freedesktop.Tracker3.Writeback.service
	org.freedesktop.portal.Tracker.service"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/org.freedesktop.LocalSearch3.user" \
		"$pkgdir/etc/dinit.d/user/org.freedesktop.LocalSearch3.user"
	install -Dm644 "$srcdir/org.freedesktop.LocalSearch3.Control.user" \
		"$pkgdir/etc/dinit.d/user/org.freedesktop.LocalSearch3.Control.user"
	install -Dm644 "$srcdir/org.freedesktop.LocalSearch3.Writeback.user" \
		"$pkgdir/etc/dinit.d/user/org.freedesktop.LocalSearch3.Writeback.user"
	install -Dm644 "$srcdir/org.freedesktop.portal.Tracker.user" \
		"$pkgdir/etc/dinit.d/user/org.freedesktop.portal.Tracker.user"
	# D-Bus activation overrides: the effective Exec starts the dinit unit.
	for s in org.freedesktop.LocalSearch3 org.freedesktop.Tracker3.Miner.Files \
		org.freedesktop.LocalSearch3.Control org.freedesktop.Tracker3.Miner.Files.Control \
		org.freedesktop.LocalSearch3.Writeback org.freedesktop.Tracker3.Writeback \
		org.freedesktop.portal.Tracker; do
		install -Dm644 "$srcdir/$s.service" \
			"$pkgdir/usr/share/dinit/dbus-services/$s.service"
	done
}

