# dinit user service: localsearch control (org.freedesktop.LocalSearch3.Control)
# Tracker control interface. Unit name = canonical D-Bus bus name (ADR-010);
# D-Bus activation is routed through
# /usr/local/share/dbus-1/services/org.freedesktop.LocalSearch3.Control.service.
# The legacy org.freedesktop.Tracker3.Miner.Files.Control activation file maps
# to this same unit.
type = process
smooth-recovery = true
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.freedesktop.LocalSearch3.Control.log
command = /usr/libexec/localsearch-control-3
working-dir = $HOME
depends-on = dbus.user
