# dinit user service: localsearch file indexer (org.freedesktop.LocalSearch3)
# File system data miner. Unit name = canonical D-Bus bus name (ADR-010);
# D-Bus activation is routed through
# /usr/share/feralos/dbus-services/org.freedesktop.LocalSearch3.service
# (materialized into the session's $XDG_RUNTIME_DIR/dbus-1/services at login).
# The daemon claims BOTH org.freedesktop.LocalSearch3 and the legacy
# org.freedesktop.Tracker3.Miner.Files name (source-verified in
# src/indexer/tracker-main.c: DBUS_NAME_SUFFIX + LEGACY_DBUS_NAME_SUFFIX), so
# the legacy activation file maps to this same unit.
type = process
smooth-recovery = true
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.freedesktop.LocalSearch3.log
command = /usr/libexec/localsearch-3
working-dir = $HOME
depends-on = dbus.user
