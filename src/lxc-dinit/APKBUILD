pkgname=lxc-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for lxc"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit lxc"
makedepends=""
source="lxc-dinit"

build() { return 0; }
check() { return 0; }

package() {
    install -Dm644 "$srcdir/lxc-dinit" "$pkgdir/usr/lib/dinit.d/lxc-dinit"
    mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
    ln -sf ../"lxc-dinit" "$pkgdir/usr/lib/dinit.d/boot.d/lxc-dinit"
}

