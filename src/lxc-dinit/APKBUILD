# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=lxc-dinit
pkgver=0.1.0
pkgrel=4
pkgdesc="dinit service for lxc"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit lxc"
makedepends=""
source="lxc lxc.script lxc.conf"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/lxc" "$pkgdir/lib/dinit.d/lxc"
	install -Dm755 "$srcdir/lxc.script" "$pkgdir/usr/lib/dinit/lxc"
	install -Dm644 "$srcdir/lxc.conf" "$pkgdir/etc/dinit.d/config/lxc.conf"
}

