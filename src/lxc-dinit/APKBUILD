# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=lxc-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for lxc"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit lxc"
makedepends=""
source="lxc"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/lxc" "$pkgdir/usr/lib/dinit.d/lxc"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../lxc" "$pkgdir/usr/lib/dinit.d/boot.d/lxc"
}

sha512sums="ed3f1963f698e10b97bb7996e4e9f2cf58562e141be13340a9888af3292d65cf  lxc"
