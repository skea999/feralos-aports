# dinit service: lxc (Alpine openrc lxc + overrides)
# lxc-autostart is a one-shot (brings autostart containers up, exits) — NOT a
# daemon: process+restart would loop forever (latent restart-loop bug).
type = scripted
command = /usr/lib/dinit/lxc start
stop-command = /usr/lib/dinit/lxc stop
restart = false
depends-on = local.target
before = login.target
env-file = /etc/dinit.d/config/lxc.conf
