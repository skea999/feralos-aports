#!/bin/sh
# dinit wrapper for lxc — sources the packaged config (if present), then
# starts/stops autostart containers (lxc-autostart is one-shot).
[ -r /etc/dinit.d/config/lxc.conf ] && . /etc/dinit.d/config/lxc.conf
case "${1:-start}" in
	start) exec /usr/bin/lxc-autostart ${LXC_OPTS} ;;
	stop) exec /usr/bin/lxc-autostart stop ${LXC_STOP_OPTS} ;;
	*) echo "usage: $0 [start|stop]" >&2; exit 1 ;;
esac
