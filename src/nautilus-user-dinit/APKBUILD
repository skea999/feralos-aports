# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# User dinit service for Nautilus. Unit name = canonical session D-Bus bus
# name (ADR-010); D-Bus activation is routed through feralos-dbus-activate
# via overrides in /usr/share/feralos/dbus-services/. Both activation files
# shipped by Alpine's nautilus package (org.gnome.Nautilus and
# org.freedesktop.FileManager1) map to the SAME unit — upstream execs the
# same command for both (source-verified: /usr/bin/nautilus
# --gapplication-service).
pkgname=nautilus-user-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="User dinit service for Nautilus (+ FileManager1 alias)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="dinit nautilus feralos-dbus-activate"
makedepends=""
source="org.gnome.Nautilus.user org.gnome.Nautilus.service
	org.freedesktop.FileManager1.service"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/org.gnome.Nautilus.user" \
		"$pkgdir/etc/dinit.d/user/org.gnome.Nautilus.user"
	# D-Bus activation overrides: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.gnome.Nautilus.service" \
		"$pkgdir/usr/share/feralos/dbus-services/org.gnome.Nautilus.service"
	install -Dm644 "$srcdir/org.freedesktop.FileManager1.service" \
		"$pkgdir/usr/share/feralos/dbus-services/org.freedesktop.FileManager1.service"
}

sha512sums="
