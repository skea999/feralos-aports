pkgname=networking-dinit
pkgver=0.1.0
pkgrel=2
pkgdesc="dinit service for networking (ifup -a, ifupdown-ng)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit ifupdown-ng"
makedepends=""
source="networking"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/networking" "$pkgdir/lib/dinit.d/networking"
}

