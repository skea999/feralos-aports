# dinit service: NetworkManager (system)
# NM needs the system bus (clients talk to it over D-Bus).
type = process
log-type = file
logfile = /var/log/dinit/networkmanager.log
command = /usr/sbin/NetworkManager --no-daemon
smooth-recovery = true
restart = on-failure
depends-on = dbus
depends-on = pre-network.target
before = network.target
