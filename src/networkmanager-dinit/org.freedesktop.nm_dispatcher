# dinit service: NetworkManager dispatcher (system bus activation unit)
# Unit name = system bus name: D-Bus activation is routed through
# /usr/share/feralos/dbus-system-services/org.freedesktop.nm_dispatcher.service
# (installed at boot into /usr/local/share/dbus-1/system-services by
# dbus-services-setup), whose Exec starts this unit (ADR-010).
type = process
smooth-recovery = true
log-type = file
logfile = /var/log/dinit/org.freedesktop.nm_dispatcher.log
command = /usr/libexec/nm-dispatcher
depends-on = dbus
