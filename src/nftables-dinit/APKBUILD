# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=nftables-dinit
pkgver=0.1.0
pkgrel=4
pkgdesc="dinit service for nftables (load ruleset)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit nftables"
makedepends=""
source="nftables dinit-nftables"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/nftables" "$pkgdir/lib/dinit.d/nftables"
	install -Dm755 "$srcdir/dinit-nftables" "$pkgdir/usr/libexec/dinit-nftables"
}

