# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=nftables-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for nftables"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit nftables"
makedepends=""
source="nftables"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/nftables" "$pkgdir/usr/lib/dinit.d/nftables"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../nftables" "$pkgdir/usr/lib/dinit.d/boot.d/nftables"
}

sha512sums="8d662ff1df9c28592074f91e44a5cda3fc7a9b895f7ff97c110cf35b751e86770571d493c79bdf8ac9ceaa5b1919624e982c7dda970a50db2a096a2a83fa47a7  nftables"
