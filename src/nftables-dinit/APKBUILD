# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=nftables-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for nftables"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit nftables"
makedepends=""
source="nftables"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/nftables" "$pkgdir/usr/lib/dinit.d/nftables"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../nftables" "$pkgdir/usr/lib/dinit.d/boot.d/nftables"
}

sha512sums="fa971d53b9ffcd90d1add94add79b1787415008af14f76648bb37f82c17a6674  nftables"
