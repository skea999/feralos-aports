# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=nftables-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for nftables"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit nftables"
makedepends=""
source="nftables"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/nftables" "$pkgdir/usr/lib/dinit.d/nftables"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../nftables" "$pkgdir/usr/lib/dinit.d/boot.d/nftables"
}

sha512sums="8a26738bb17c13dc98f4ab33b7fe0b24715407bff34789d02701df5070f73f17efa70e5f0511d60666295f170c9faa084038a352904de8c68cc59312c65e4c9a  nftables"
