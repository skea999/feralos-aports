# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# niri-base-config: the shared niri-family static layer (ADR-013 R2) —
# listed by BOTH niri (DMS) and niriWayle DE package lists. This package
# carries the static system-path CONFIGS the two desktop setups used to
# write identically, plus the SHARED branding and the SHARED niri entry:
#   - /etc/dconf/profile/user — Alpine's dconf ships NO /etc/dconf at all;
#     without the profile GLib never consults the user/system dbs
#   - /etc/NetworkManager/conf.d/10-manage.conf — NM manages ifupdown
#     interfaces (Wayle network module + DMS widget both talk to NM)
#   - /etc/network/interfaces — reduced to loopback (eth0 belongs to NM);
#     OVERWRITES the eth0-dhcp file internal.setupInterfaces wrote earlier
#     in the chroot run (dead in the niri-family flow). Alpine ships no
#     owner of this path.
#   - /etc/skel/.config/niri/config.kdl — the niri entry file, SHARED by
#     both niri-family desktops: optional=true includes of BOTH bases
#     (/usr/share/wayle/niri + /usr/share/dms/niri) + optional install.kdl
#     (per-install values, written by the installer) + optional generated
#     dms fragments. The active desktop's base loads; the other variant is
#     absent by design (optional skip). ONE owner = no smoke-root
#     collision (CI run 45910668977: the per-DE entries collided).
#   - the FeralOS branding: logo as a system hicolor icon (Wayle/Raffi
#     launcher) + the default wallpapers (the regreet background points at
#     the 1080p target)
#   - /usr/bin/feralos-reboot — the init-agnostic session reboot wrapper
#     (dinit: `sudo -n /usr/bin/reboot` — the loginctl path is broken
#     there, elogind's busybox follow-up makes dinit overwrite
#     REBOOT→HALT — vs `loginctl reboot` under OpenRC; /run/dinitctl
#     probe). The sudoers NOPASSWD rule the sudo path requires ships in
#     feralos-reboot (this package's depends).
#   - /usr/bin/xdg-su — the niri wrapper (alacritty + su; matches *niri*
#     so both session types hit it). NO Alpine package ships
#     /usr/bin/xdg-su (verified: apk file-search empty) — the path is
#     clean and the tracked-package lifecycle beats the former
#     installer-written /usr/local/bin trick (abuild bans /usr/local in
#     packages). The vendor fallback was dead code AND a self-exec loop
#     at that path — replaced by a hard error.
# The post-install materializes the COMPILED (empty) dconf system db: the
# edge/flatpak install runs BEFORE the desktop setup, so the db must exist
# at package-install time (proof 2026-11-23T23-15-08Z: the Key Rack
# flatpak hit "unable to open file /etc/dconf/db/local" when the
# materialization lived in the desktop setup).
pkgname=niri-base-config
pkgver=0.4.0
pkgrel=1
pkgdesc="FeralOS shared niri-family statics (dconf, NM, skel niri entry, branding)"
url="https://github.com/skea999/feralos-aports"
arch="noarch"
license="ISC"
depends="feralos-branding xdg-su feralos-reboot"
makedepends=""
source="dconf-profile-user 10-manage.conf interfaces
	niri-base-config.post-install skel-niri-config.kdl"
install="$pkgname.post-install"
options="!check" # static configs, exercised by the niri-family harness checks

package() {
	install -Dm644 "$srcdir/dconf-profile-user" "$pkgdir/etc/dconf/profile/user"
	install -Dm644 "$srcdir/10-manage.conf" "$pkgdir/etc/NetworkManager/conf.d/10-manage.conf"
	install -Dm644 "$srcdir/interfaces" "$pkgdir/etc/network/interfaces"
	# SKEL: the niri entry file (shared by both niri-family desktops —
	# optional includes of both bases; the active one loads, the other
	# variant is absent by design)
	install -d "$pkgdir/etc/skel/.config/niri"
	install -m644 "$srcdir/skel-niri-config.kdl" "$pkgdir/etc/skel/.config/niri/config.kdl"
	# SKEL: the empty user-dinit LOG dir — the user service files (dbus.user,
	# niri, ...) declare logfile = $HOME/.local/share/dinit/<svc>.log and
	# dinit does NOT mkdir the parent: without it every session service
	# fails at "Stage: opening log file" and the whole desktop dies at the
	# greeter. The install-time user gets the dir from the installer; this
	# skel entry covers every FUTURE user (the adduser skel copy).
	install -d "$pkgdir/etc/skel/.local/share/dinit"
	# wallpaper symlinks (PACKAGE CONTENT — tracked): the canonical files
	# live in the feralos-branding staging dir; relative links keep the
	# tree movable.
	install -d "$pkgdir/usr/share/wallpapers"
	ln -s ../feralos/branding/feralos-wallpaper-1080p.png \
		"$pkgdir/usr/share/wallpapers/feralos-default.png"
	ln -s ../feralos/branding/feralos-wallpaper-1440p.png \
		"$pkgdir/usr/share/wallpapers/feralos-default-3440x1440.png"
	# hicolor logo symlink (PACKAGE CONTENT — tracked)
	install -d "$pkgdir/usr/share/icons/hicolor/scalable/apps"
	ln -s ../../../../feralos/branding/feralos-logo.svg \
		"$pkgdir/usr/share/icons/hicolor/scalable/apps/feralos-logo.svg"
	# the standalone tools (feralos-reboot, xdg-su) = their OWN packages
	# (owner rule) — pulled here via depends, not shipped
}
