# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# niri-base-config: the shared niri-family static layer (ADR-013 R2) —
# listed by BOTH niri (DMS) and niriWayle DE package lists. This package
# carries every static system-path config the two desktop setups used to
# write identically, plus the branding assets:
#   - /etc/dconf/profile/user — Alpine's dconf ships NO /etc/dconf at all;
#     without the profile GLib never consults the user/system dbs
#   - /etc/NetworkManager/conf.d/10-manage.conf — NM manages ifupdown
#     interfaces (Wayle network module + DMS widget both talk to NM)
#   - /etc/network/interfaces — reduced to loopback (eth0 belongs to NM);
#     OVERWRITES the eth0-dhcp file internal.setupInterfaces wrote earlier
#     in the chroot run (dead in the niri-family flow — kept there for the
#     non-niri flows). Alpine ships no owner of this path.
#   - the FeralOS branding: logo as a system hicolor icon (Wayle/Raffi
#     launcher button; Adwaita inherits hicolor so `icon-name =
#     "feralos-logo"` resolves) + the default wallpapers (the regreet
#     background points at the 1080p target)
# Per-variant statics do NOT live here: the Wayle portals override (oo7)
# is wayle-config, the DMS user seeds stay installer-written.
# The post-install materializes the COMPILED (empty) dconf system db: the
# edge/flatpak install runs BEFORE the desktop setup, so the db must exist
# at package-install time (proof 2026-11-23T23-15-08Z: the Key Rack
# flatpak hit "unable to open file /etc/dconf/db/local" when the
# materialization lived in the desktop setup, which runs later).
pkgname=niri-base-config
pkgver=0.1.0
pkgrel=1
pkgdesc="FeralOS shared niri-family statics: dconf profile, NM manage, lo interfaces, branding"
url="https://github.com/skea999/feralos-aports"
arch="noarch"
license="ISC"
depends=""
makedepends=""
source="dconf-profile-user 10-manage.conf interfaces
	feralos-logo.svg feralos-wallpaper-1080p.png feralos-wallpaper-1440p.png
	niri-base-config.post-install"
install="$pkgname.post-install"
options="!check" # static configs, exercised by the niri-family harness checks

package() {
	install -Dm644 "$srcdir/dconf-profile-user" "$pkgdir/etc/dconf/profile/user"
	install -Dm644 "$srcdir/10-manage.conf" "$pkgdir/etc/NetworkManager/conf.d/10-manage.conf"
	install -Dm644 "$srcdir/interfaces" "$pkgdir/etc/network/interfaces"
	install -Dm644 "$srcdir/feralos-logo.svg" \
		"$pkgdir/usr/share/icons/hicolor/scalable/apps/feralos-logo.svg"
	install -Dm644 "$srcdir/feralos-wallpaper-1080p.png" \
		"$pkgdir/usr/share/wallpapers/feralos-default.png"
	install -Dm644 "$srcdir/feralos-wallpaper-1440p.png" \
		"$pkgdir/usr/share/wallpapers/feralos-default-3440x1440.png"
}
sha512sums="
