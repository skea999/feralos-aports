// FeralOS niri — YOUR niri config (the entry file, shared by both
// niri-family desktops). The optional includes below load:
//   /usr/share/wayle/niri/base.kdl — niriWayle static base (wayle-config)
//   /usr/share/dms/niri/base.kdl   — niri (DMS) static base (dms-config)
//   install.kdl                    — per-install values (installer, once)
//   dms/*.kdl                      — DMS fragments (`dms setup`-generated)
// The base of YOUR desktop is installed; the other variant is absent and
// its optional include is skipped by design. Your edits HERE merge
// per-key over everything (niri >=25.11) and survive apk + installer
// forever.

include optional=true "/usr/share/wayle/niri/base.kdl"
include optional=true "/usr/share/dms/niri/base.kdl"
include optional=true "install.kdl"
include optional=true "dms/binds.kdl"
include optional=true "dms/layout.kdl"
include optional=true "dms/colors.kdl"
