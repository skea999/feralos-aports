# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
#
# dinit USER services for the niri session. Alpine's niri ships
# /usr/bin/niri-session, the upstream wrapper that starts the "niri" user
# service via `dinitctl --user start niri` when a user dinit instance is
# running. That is exactly the lifecycle we want (niri dies -> session ends).
# The wrapper's earlier SHELL/bash re-exec branch is dodged via the
# login-shell symlink below; see README.md for the full rationale.
#
# Adapted from upstream niri v25.11 resources/dinit/{niri,niri-shutdown}:
#  * depends-on = dbus.user (our dbus-user-dinit service name; upstream's
#    `dbus` service does not exist on FeralOS)
#  * niri-shutdown also clears XDG_SESSION_DESKTOP
#
# FeralOS override series: pkgver 989.0.1.0 — FeralOS-only package (no
# Alpine counterpart), versioned in the same 989 series as our other
# overridden packages to keep repo ordering coherent. The 989 major
# component always outranks any Alpine version field-by-field.
pkgname=niri-user-dinit
pkgver=989.0.1.0
pkgrel=3
pkgdesc="dinit user services for the niri compositor session"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="niri dinit"
# replaces: we ship a fixed /usr/bin/niri-session (upstream post-25.11 mechanism — see the script header)
replaces="niri"
# !tracedeps: abuild would auto-detect `cmd:niri-session=<our-pkgver>` from the
# installed file; a versioned provide co-installed with Alpine niri's own
# `cmd:niri-session` provider is an unresolvable provider conflict (replaces=
# only settles FILE ownership). No so:/pc:/py: deps here, so !tracedeps drops
# only that one auto-provide.
options="!tracedeps"
makedepends=""
source="niri niri-shutdown niri-session"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/niri" "$pkgdir/etc/dinit.d/user/niri"
	install -Dm644 "$srcdir/niri-shutdown" "$pkgdir/etc/dinit.d/user/niri-shutdown"
	install -Dm755 "$srcdir/niri-session" "$pkgdir/usr/bin/niri-session"

	# login-shell: symlink to ash at a path NOT listed in /etc/shells.
	# niri-session re-execs itself through bash and abandons the user dinit
	# manager when $SHELL is a valid /etc/shells entry, and greetd always
	# sets SHELL (ash is in /etc/shells -> would trap). This symlink keeps a
	# perfectly usable shell while failing that check. See README.md.
	install -d "$pkgdir/usr/libexec/feralos"
	ln -s /bin/ash "$pkgdir/usr/libexec/feralos/login-shell"
}

sha512sums="
a0c2bea8b1c53eea035ab7ea251fddc85034a37d75546d82df7de87a882a7e621388b48cae313f048e3ccfab069285b9c1d0b9df44c6c98a1d4d839b4c621c2b  niri
6fb2d35f11c4e0e4168ffa909848ec7093f9b49ef6e4271cfcbbb46276a148b7979b47056fb66dfdc0d869fb933dd216be3a642fd7cfdf8bb47bec28338ed541  niri-shutdown
3553cc6d726f84d20f1678cc12c64d2d5916636418f82b0717df89387297ad2b95f19472f280211916c487ce8dbbbf0c5ec46554c8002a0857ede78e300fa1b9  niri-session
"
