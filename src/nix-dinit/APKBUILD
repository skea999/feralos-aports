pkgname=nix-dinit
pkgver=0.1.0
pkgrel=5
pkgdesc="dinit service for nix-daemon (Alpine initd name)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit nix"
makedepends=""
source="nix-daemon"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/nix-daemon" "$pkgdir/lib/dinit.d/nix-daemon"
}

