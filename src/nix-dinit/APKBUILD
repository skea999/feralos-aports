# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=nix-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for nix"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit nix"
makedepends=""
source="nix"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/nix" "$pkgdir/usr/lib/dinit.d/nix"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../nix" "$pkgdir/usr/lib/dinit.d/boot.d/nix"
}

sha512sums="ba2b30c1826de244c55cb5eb3b34077041e4e40f8b996d755c0867174da0fc39  nix"
