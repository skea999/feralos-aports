pkgname=nix-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for nix"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit nix"
makedepends=""
source="nix"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/nix" "$pkgdir/usr/lib/dinit.d/nix"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../nix" "$pkgdir/usr/lib/dinit.d/boot.d/nix"
}

