# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=nix-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for nix"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit nix"
makedepends=""
source="nix-dinit"

build() { return 0; }
check() { return 0; }

package() {
    install -Dm644 "$srcdir/nix-dinit" "$pkgdir/usr/lib/dinit.d/nix-dinit"
    mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
    ln -sf ../"nix-dinit" "$pkgdir/usr/lib/dinit.d/boot.d/nix-dinit"
}

sha512sums="c33893470c6954bda08705b58fc55393477902499a542b3c15ce1a34284010581d8582a88c4239d1bee4badff74b08f468d0a2f3f0edd5cf2d4170365b549302  nix-dinit"
