# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# User dinit service for obexd. Unit name = canonical session D-Bus bus name
# (ADR-010); D-Bus activation is routed through feralos-dbus-activate via an
# override in /usr/share/feralos/dbus-services/.
# Verified on Alpine 3.24: upstream activation Exec =
# /usr/lib/bluetooth/obexd -n --capability=!/usr/bin/obex-capabilities; the
# binary ships in obexd-enhanced, hence the dependency.
# Transitional unit: the harness check dbus_activation_migration retires it
# once dbus-broker is installed and every activation target has a
# package-shipped unit.
pkgname=obexd-user-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="User dinit service for obexd (org.bluez.obex activation target)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="feralos-dbus-activate obexd-enhanced"
makedepends=""
source="org.bluez.obex.user org.bluez.obex.service"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/org.bluez.obex.user" \
		"$pkgdir/etc/dinit.d/user/org.bluez.obex.user"
	# D-Bus activation override: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.bluez.obex.service" \
		"$pkgdir/usr/share/feralos/dbus-services/org.bluez.obex.service"
}

sha512sums="
d69b364c926197a79a2483c1e1cfd7a3c4996add65dca219a60fe298f87ee4dbc0694bb3f73218e813efcd86db2ddd21aba0deb083bf82ac935ba4a57feede54  org.bluez.obex.user
3cc9a46fec7fcde702f4187ca5456e3df122c3eb1745a1754cab7d5776a3db84aac5579488dc1cd4382c2ebab746fa17d76d2f9d56f67328d3c1754721c44609  org.bluez.obex.service
"
