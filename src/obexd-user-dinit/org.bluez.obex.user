# feralos obexd-user-dinit: D-Bus activation target for org.bluez.obex
# (ADR-010).
# Transitional: drop when the package (or dbus-broker ephemeral services) ships
# this unit itself.
type = process
command = /usr/lib/bluetooth/obexd -n --capability=!/usr/bin/obex-capabilities
smooth-recovery = true
restart = false
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.bluez.obex.log
depends-on = dbus.user
