#!/bin/sh
# FeralOS ADR-008 wrapper for the oo7 secret service daemon. Sources the
# user-editable, apk-protected config (same pattern as the system -dinit
# packages), exports RUST_LOG (the daemon's log filter is env-driven:
# RUST_LOG=info enables the INFO "Received unlock request" delivery line in
# secrets.log — the harness oo7_pam_unlock proof greps it; the installer
# sets it only on enableDebug installs), then execs the real daemon. No
# other args: zbus needs no env juggling beyond what the user-dinit session
# provides.
DAEMON=/usr/libexec/oo7-daemon
[ -r /etc/dinit.d/config/secrets.conf ] && . /etc/dinit.d/config/secrets.conf
[ -n "${RUST_LOG:-}" ] && export RUST_LOG
exec "$DAEMON"
