pkgname=oo7-user-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="User dinit services for oo7 (Secret Service daemon + portal)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="dinit oo7 oo7-portal dbus-user-dinit"
makedepends=""
source="secrets.user oo7-portal.user"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/secrets.user" "$pkgdir/etc/dinit.d/user/secrets.user"
	install -Dm644 "$srcdir/oo7-portal.user" "$pkgdir/etc/dinit.d/user/oo7-portal.user"
}

