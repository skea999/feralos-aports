# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# User dinit services for oo7 (Secret Service daemon + portal).
# Unit names = canonical session D-Bus bus names (ADR-010); D-Bus activation
# is routed through feralos-dbus-activate via the overrides in
# /usr/share/feralos/dbus-services/. The portal unit carries the portal's real
# bus name (org.freedesktop.impl.portal.desktop.oo7, verified in the oo7 portal
# source: PORTAL_NAME const + meson dbus_name).
# org.freedesktop.impl.portal.Secret is the portal backend INTERFACE, not a bus
# name — the former override under it could never fire and was removed.
# The secrets unit is named after the Secret Service bus name
# (org.freedesktop.secrets); the daemon binary lives in the oo7-server
# subpackage on Alpine 3.24 (source-verified APK contents), hence the
# explicit depends entry.
pkgname=oo7-user-dinit
pkgver=0.1.0
pkgrel=5
pkgdesc="User dinit services for oo7 (Secret Service daemon + portal)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="dinit oo7 oo7-server oo7-portal dbus-user-dinit feralos-dbus-activate"
makedepends=""
source="org.freedesktop.secrets.user org.freedesktop.impl.portal.desktop.oo7.user
	secrets secrets.conf
	oo7-daemon org.freedesktop.secrets.service
	org.freedesktop.impl.portal.desktop.oo7.service"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/org.freedesktop.secrets.user" \
		"$pkgdir/etc/dinit.d/user/org.freedesktop.secrets.user"
	install -Dm644 "$srcdir/org.freedesktop.impl.portal.desktop.oo7.user" \
		"$pkgdir/etc/dinit.d/user/org.freedesktop.impl.portal.desktop.oo7.user"
	# ADR-008: service -> wrapper -> config (user-editable, apk-protected).
	install -Dm755 "$srcdir/secrets" "$pkgdir/usr/libexec/oo7-user-dinit/secrets"
	install -Dm644 "$srcdir/secrets.conf" "$pkgdir/etc/dinit.d/config/secrets.conf"
	# pam_oo7 auto_start recovery path — must NEVER exec the daemon
	# directly (unsupervised); it delegates to dinitctl --user (see the
	# script header). Placed at /usr/bin because that is the path the
	# upstream PAM module hardcodes.
	install -Dm755 "$srcdir/oo7-daemon" "$pkgdir/usr/bin/oo7-daemon"
	# D-Bus activation overrides: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.freedesktop.secrets.service" \
		"$pkgdir/usr/share/feralos/dbus-services/org.freedesktop.secrets.service"
	install -Dm644 "$srcdir/org.freedesktop.impl.portal.desktop.oo7.service" \
		"$pkgdir/usr/share/feralos/dbus-services/org.freedesktop.impl.portal.desktop.oo7.service"
}

