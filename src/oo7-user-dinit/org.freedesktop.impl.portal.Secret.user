# dinit user service: oo7-portal — Secret portal backend (org.freedesktop.impl.portal.Secret)
# Backend for the Secret portal; zbus connects to the session bus at runtime.
# Unit name follows the ADR-010 inventory (Secret portal backend unit).
# NOTE: the daemon's actual well-known bus name is
# org.freedesktop.impl.portal.desktop.oo7 (verified in the oo7 portal source:
# PORTAL_NAME const + meson dbus_name); both activation files in
# /usr/local/share/dbus-1/services/ route to this unit.
type = process
smooth-recovery = true
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.freedesktop.impl.portal.Secret.log
command = /usr/libexec/oo7-portal
working-dir = $HOME
depends-on = dbus.user
