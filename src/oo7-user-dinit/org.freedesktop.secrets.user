# dinit service: oo7-daemon — Secret Service API (org.freedesktop.secrets)
# Alpine's oo7-server package ships the activation file with Exec=/bin/false
# (systemd-only); the effective override routed through feralos-dbus-activate
# lives in /usr/share/feralos/dbus-services/org.freedesktop.secrets.service.
# Without this service the secrets API would be dead under dinit (no
# unsupervised D-Bus spawn; ADR-010). zbus (pure rust) connects to the
# session bus at RUNTIME — no system deps, no env juggling.
# Unit name = canonical session D-Bus bus name (ADR-010). Logfile stays
# `secrets.log` (installer/harness reference it for the oo7_pam_unlock proof).
# command = the ADR-008 wrapper (sources /etc/dinit.d/config/secrets.conf,
# exports RUST_LOG, execs the real /usr/libexec/oo7-daemon).
type = process
smooth-recovery = true
load-options = sub-vars
logfile = $HOME/.local/share/dinit/secrets.log
command = /usr/libexec/oo7-user-dinit/secrets
depends-on = dbus.user
