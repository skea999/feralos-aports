# dinit service: oo7-daemon — Secret Service API (org.freedesktop.secrets)
# Alpine ships NO session dbus activation file for oo7-daemon: without this
# service the secrets service is dead under dinit. zbus (pure rust) connects
# to the session bus at RUNTIME — no system deps, no env juggling.
# command = the ADR-008 wrapper (sources /etc/dinit.d/config/secrets.conf,
# exports RUST_LOG, execs the real /usr/libexec/oo7-daemon).
type = process
smooth-recovery = true
load-options = sub-vars
logfile = $HOME/.local/share/dinit/secrets.log
command = /usr/libexec/oo7-user-dinit/secrets
depends-on = dbus.user
