# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=openssh-server-common-dinit
pkgver=0.1.0
pkgrel=4
pkgdesc="dinit sshd service for openssh (Alpine initd name: sshd)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit openssh"
makedepends=""
source="sshd"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	# NOTE: mirrors openssh-server-common-openrc which ships sshd.initd
	install -Dm644 "$srcdir/sshd" "$pkgdir/lib/dinit.d/sshd"
}

sha512sums="
2963c958dc60a2a6ffe7c1d110a54bd3ec9aa584e98b85cf8f15dda952a52a9b52f611ff60799fc38fd398d3b608c6f8eaf116716fa747518b7912bc5b2890a2  sshd
"
