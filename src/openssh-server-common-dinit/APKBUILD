pkgname=openssh-server-common-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="openssh server common service for dinit"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit openssh-server-common"
makedepends=""
source="sshd"

build() {
	# nothing to build
	return 0
}

check() {
	# nothing to test
	return 0
}

package() {
	install -Dm644 "$srcdir/sshd" "$pkgdir/usr/lib/dinit.d/sshd"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf ../sshd "$pkgdir/usr/lib/dinit.d/boot.d/sshd"
}

