pkgname=openssh-server-common-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for openssh-server-common"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit openssh-server-common"
makedepends=""
source="openssh-server-common"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/openssh-server-common" "$pkgdir/usr/lib/dinit.d/openssh-server-common"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../openssh-server-common" "$pkgdir/usr/lib/dinit.d/boot.d/openssh-server-common"
}

