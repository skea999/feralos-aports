# dinit service: sshd (Alpine openrc sshd + overrides)
# Host keys are generated at INSTALL time (installer runs ssh-keygen -A in
# the chroot). NOTE: dinit splits `command` on whitespace WITHOUT shell
# quoting — never wrap in sh -c '...' (the quotes become part of the token).
type = process
command = /usr/sbin/sshd -D -e
restart = true
depends-on = networking
