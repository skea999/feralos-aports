pkgname=pipewire-dinit
pkgver=0.1.0
pkgrel=3
pkgdesc="dinit service for pipewire"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit pipewire"
makedepends=""
source="pipewire"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/pipewire" "$pkgdir/lib/dinit.d/pipewire"
}

