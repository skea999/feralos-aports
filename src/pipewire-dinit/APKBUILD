pkgname=pipewire-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for pipewire"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit pipewire"
makedepends=""
source="pipewire-dinit"

build() { return 0; }
check() { return 0; }

package() {
    install -Dm644 "$srcdir/pipewire-dinit" "$pkgdir/usr/lib/dinit.d/pipewire-dinit"
    mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
    ln -sf ../"pipewire-dinit" "$pkgdir/usr/lib/dinit.d/boot.d/pipewire-dinit"
}

