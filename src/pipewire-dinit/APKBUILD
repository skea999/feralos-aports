# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=pipewire-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for pipewire"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit pipewire"
makedepends=""
source="pipewire"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/pipewire" "$pkgdir/usr/lib/dinit.d/pipewire"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../pipewire" "$pkgdir/usr/lib/dinit.d/boot.d/pipewire"
}

sha512sums="036867dffec4c4ccc219cc8a40a6426923b897550af1f9b665dcef3a88320c44  pipewire"
