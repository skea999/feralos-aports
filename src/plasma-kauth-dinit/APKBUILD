# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# KDE Plasma system-bus KAuth helper activation targets (kde DE). ADR-010: each
# helper's upstream system-bus activation file routes through
# feralos-dbus-activate to a dinit unit named after the bus name; the overrides
# are packaged in /usr/share/feralos/dbus-system-services (materialized at boot
# into the launch helper's standard dirs). Transitional units: the harness check
# dbus_activation_migration retires them once dbus-broker is installed and
# every activation target has a package-shipped unit.
pkgname=plasma-kauth-dinit
pkgver=0.1.0
pkgrel=1
pkgdesc="dinit services for the KDE Plasma system-bus KAuth helper targets"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="feralos-dbus-activate discover-backend-apk plasma-workspace kdeplasma-addons plasma-desktop sddm-kcm plasma-disks kinfocenter libksysguard ktexteditor powerdevil plasma-firewall"
makedepends=""
source="org.kde.discover.alpineapkbackend org.kde.discover.alpineapkbackend.service
	org.kde.fontinst org.kde.fontinst.service
	org.kde.kameleonhelper org.kde.kameleonhelper.service
	org.kde.kcontrol.kcmclock org.kde.kcontrol.kcmclock.service
	org.kde.kcontrol.kcmsddm org.kde.kcontrol.kcmsddm.service
	org.kde.kded.smart org.kde.kded.smart.service
	org.kde.kinfocenter.dmidecode org.kde.kinfocenter.dmidecode.service
	org.kde.ksysguard.processlisthelper org.kde.ksysguard.processlisthelper.service
	org.kde.ktexteditor6.katetextbuffer org.kde.ktexteditor6.katetextbuffer.service
	org.kde.localegenhelper org.kde.localegenhelper.service
	org.kde.powerdevil.backlighthelper org.kde.powerdevil.backlighthelper.service
	org.kde.powerdevil.chargethresholdhelper org.kde.powerdevil.chargethresholdhelper.service
	org.kde.powerdevil.discretegpuhelper org.kde.powerdevil.discretegpuhelper.service
	org.kde.powerdevil.wakeupsourcehelper org.kde.powerdevil.wakeupsourcehelper.service
	org.kde.ufw org.kde.ufw.service"

build() { return 0; }
check() { return 0; }

package() {
	for helper in org.kde.discover.alpineapkbackend \
		org.kde.fontinst \
		org.kde.kameleonhelper \
		org.kde.kcontrol.kcmclock \
		org.kde.kcontrol.kcmsddm \
		org.kde.kded.smart \
		org.kde.kinfocenter.dmidecode \
		org.kde.ksysguard.processlisthelper \
		org.kde.ktexteditor6.katetextbuffer \
		org.kde.localegenhelper \
		org.kde.powerdevil.backlighthelper \
		org.kde.powerdevil.chargethresholdhelper \
		org.kde.powerdevil.discretegpuhelper \
		org.kde.powerdevil.wakeupsourcehelper \
		org.kde.ufw; do
		install -Dm644 "$srcdir/$helper" "$pkgdir/lib/dinit.d/$helper"
		# D-Bus activation override: the effective Exec starts the dinit unit.
		install -Dm644 "$srcdir/$helper.service" \
			"$pkgdir/usr/share/feralos/dbus-system-services/$helper.service"
	done
}

