# feralos plasma-kauth-dinit: D-Bus activation target for org.kde.kcontrol.kcmclock (ADR-010).
# Transitional: drop when the package (or dbus-broker ephemeral services) ships
# this unit itself. KAuth per-request helper: short-lived, no smooth-recovery.
type = process
command = /usr/lib/libexec/kf6/kauth/kcmdatetimehelper
run-as = root
smooth-recovery = false
restart = false
log-type = file
logfile = /var/log/dinit/org.kde.kcontrol.kcmclock.log
depends-on = dbus
