# feralos plasma-kauth-dinit: D-Bus activation target for org.kde.localegenhelper (ADR-010).
# Transitional: drop when the package (or dbus-broker ephemeral services) ships
# this unit itself. KAuth per-request helper: short-lived, no smooth-recovery.
# Singleton helper (stays resident), smooth-recovery on.
type = process
command = /usr/bin/plasma-localegen-helper
run-as = root
smooth-recovery = true
restart = false
log-type = file
logfile = /var/log/dinit/org.kde.localegenhelper.log
depends-on = dbus
