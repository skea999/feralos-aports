1748600fdab1afe19f18ea8f41292a8cfcfab966b6e88e3ac9f0dc4b92c844986088cf1b68e252acd00e13b38d041404bb270bc01c4df9cd3d9aaf0105539133  org.kde.localegenhelper
5f97cd378ee169dc889f940a5c1f4c82a046824a95ab07726705b715583063c407c1fb3fa646536a390db6079cc5ae0c51284c7c3a0429b8b0d76b0e4067bc5a  org.kde.fontinst.service
0beea3740deaf57debb7adaa9f0e00e043524153019d1a61e049968808ad1e7bdb0590d9af09c5ac3d12372338dfa415cf20aec2813e27e0e7466b7bfd0d2d4d  org.kde.localegenhelper.service
