# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# System-bus dinit units for the KDE Plasma KAuth helper D-Bus activation
# targets OWNED BY plasma-workspace (ADR-010, R1b purity: the supervision package is
# named after the apk package owning each activation Exec binary).
# Evidence (pkgs.alpinelinux.org file search):
#   org.kde.fontinst  Exec /usr/lib/libexec/kf6/kauth/fontinst_helper -> plasma-workspace
#   org.kde.localegenhelper  Exec /usr/bin/plasma-localegen-helper -> plasma-workspace
# Overrides ship in /usr/share/feralos/dbus-system-services/ (materialized
# at boot into /usr/local/share/dbus-1/system-services via
# dbus-services-setup: the launch helper resolves names only against the
# standard dirs). KAuth per-request helpers: short-lived, no smooth-recovery.
pkgname=plasma-workspace-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit services for the plasma-workspace KAuth helper activation targets"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="feralos-dbus-activate plasma-workspace"
makedepends=""
source="org.kde.fontinst
org.kde.localegenhelper
	org.kde.fontinst.service
	org.kde.localegenhelper.service"

build() { return 0; }
check() { return 0; }

package() {
	for helper in org.kde.fontinst org.kde.localegenhelper ; do
		install -Dm644 "$srcdir/$helper" "$pkgdir/lib/dinit.d/$helper"
		# D-Bus activation override: the effective Exec starts the dinit unit.
		install -Dm644 "$srcdir/$helper.service" \
			"$pkgdir/usr/share/feralos/dbus-system-services/$helper.service"
	done
}

