# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# KDE Plasma session-bus activation targets (kde DE). ADR-010: each target
# routes through feralos-dbus-activate to a per-user dinit unit named after
# the bus name; the overrides ship in /usr/share/dinit/dbus-services
# (materialized at login into $XDG_RUNTIME_DIR/dbus-1/services).
# Transitional units: the harness check dbus_activation_migration retires
# them once dbus-broker is installed and every activation target has a
# package-shipped unit.
pkgname=plasma-workspace-user-dinit
pkgver=0.1.0
pkgrel=3
pkgdesc="user dinit services for the plasma-workspace session activation targets"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="feralos-dbus-activate plasma-workspace"
makedepends=""
source="org.kde.KSplash.user org.kde.KSplash.service
	org.kde.LogoutPrompt.user org.kde.LogoutPrompt.service
	org.kde.Shutdown.user org.kde.Shutdown.service
	org.kde.fontinst.user org.kde.fontinst.service
	org.freedesktop.Notifications.user org.freedesktop.Notifications.service
	org.kde.krunner.user org.kde.krunner.service
	org.kde.runners.baloo.user org.kde.runners.baloo.service
	org.kde.secretprompter.user org.kde.secretprompter.service"

build() { return 0; }
check() { return 0; }

package() {
	for s in org.kde.KSplash org.kde.LogoutPrompt org.kde.Shutdown \
		org.kde.fontinst org.freedesktop.Notifications org.kde.krunner \
		org.kde.runners.baloo org.kde.secretprompter; do
		install -Dm644 "$srcdir/$s.user" "$pkgdir/etc/dinit.d/user/$s.user"
		install -Dm644 "$srcdir/$s.service" \
			"$pkgdir/usr/share/dinit/dbus-services/$s.service"
	done
}
