# feralos plasma-workspace-user-dinit: D-Bus activation target for
# org.kde.KSplash (ADR-010).
# Transitional: drop when the package (or dbus-broker ephemeral services) ships
# this unit itself.
# Transient waiter: short-lived, no smooth-recovery.
type = process
command = /usr/bin/plasma_waitforname org.kde.KSplash
smooth-recovery = false
restart = false
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.kde.KSplash.log
depends-on = dbus.user
