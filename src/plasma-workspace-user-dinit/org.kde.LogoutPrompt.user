# feralos plasma-workspace-user-dinit: D-Bus activation target for
# org.kde.LogoutPrompt (ADR-010).
# Transitional: drop when the package (or dbus-broker ephemeral services) ships
# this unit itself.
# GUI logout greeter; transient: short-lived, no smooth-recovery.
type = process
command = /usr/lib/libexec/ksmserver-logout-greeter
smooth-recovery = false
restart = false
working-dir = $HOME
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.kde.LogoutPrompt.log
depends-on = dbus.user
