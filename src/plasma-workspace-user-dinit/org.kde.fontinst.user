# feralos plasma-workspace-user-dinit: D-Bus activation target for
# org.kde.fontinst (ADR-010).
# Transitional: drop when the package (or dbus-broker ephemeral services) ships
# this unit itself.
# KAuth per-request helper: short-lived, no smooth-recovery.
type = process
command = /usr/lib/libexec/kf6/kauth/fontinst
smooth-recovery = false
restart = false
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.kde.fontinst.log
depends-on = dbus.user
