# feralos plasma-workspace-user-dinit: D-Bus activation target for
# org.kde.secretprompter (ADR-010).
# Transitional: drop when the package (or dbus-broker ephemeral services) ships
# this unit itself.
type = process
command = /usr/lib/libexec/ksecretprompter
# dbus-activated on-demand: smooth-recovery off — a clean idle exit stops the
# unit (the next activation restarts it); restart=on-failure covers crashes.
smooth-recovery = false
restart = on-failure
working-dir = $HOME
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.kde.secretprompter.log
depends-on = dbus.user
