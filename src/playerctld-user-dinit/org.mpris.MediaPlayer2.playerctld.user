# feralos playerctld-user-dinit: D-Bus activation target for
# org.mpris.MediaPlayer2.playerctld (ADR-010).
# Transitional: drop when the package (or dbus-broker ephemeral services) ships
# this unit itself.
type = process
command = /usr/bin/playerctld
smooth-recovery = true
restart = false
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.mpris.MediaPlayer2.playerctld.log
depends-on = dbus.user
