# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=podman-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for podman"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit podman"
makedepends=""
source="podman"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/podman" "$pkgdir/usr/lib/dinit.d/podman"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../podman" "$pkgdir/usr/lib/dinit.d/boot.d/podman"
}

sha512sums="cc3932d6e2f8ef175a31ee0f63c57659474c615ad94f18cd72060fc487cfbfe0  podman"
