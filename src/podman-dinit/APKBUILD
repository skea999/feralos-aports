# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=podman-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for podman"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit podman"
makedepends=""
source="podman-dinit"

build() { return 0; }
check() { return 0; }

package() {
    install -Dm644 "$srcdir/podman-dinit" "$pkgdir/usr/lib/dinit.d/podman-dinit"
    mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
    ln -sf ../"podman-dinit" "$pkgdir/usr/lib/dinit.d/boot.d/podman-dinit"
}

