pkgname=podman-dinit
pkgver=0.1.0
pkgrel=4
pkgdesc="dinit service for podman"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit podman"
makedepends=""
source="podman"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/podman" "$pkgdir/lib/dinit.d/podman"
}

