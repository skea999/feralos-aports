pkgname=polkit-agent-user-dinit
pkgver=0.1.0
pkgrel=2
pkgdesc="dinit user service for the polkit authentication agent (polkit-gnome)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="polkit-gnome wayland-wait-user-dinit dbus-user-dinit"
makedepends=""
source="polkit-agent.user polkit-agent-session"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/polkit-agent.user" "$pkgdir/etc/dinit.d/user/polkit-agent.user"
	install -Dm755 "$srcdir/polkit-agent-session" "$pkgdir/etc/dinit.d/user/scripts/polkit-agent-session"
}

