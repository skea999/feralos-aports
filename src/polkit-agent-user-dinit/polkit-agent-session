#!/bin/sh
# polkit authentication agent launcher: resolve the compositor wayland
# socket (guaranteed by the wait-wayland.user dependency), export it, then
# exec the agent supervised.
for s in "$XDG_RUNTIME_DIR"/wayland-*; do
    [ -S "$s" ] && export WAYLAND_DISPLAY="${s##*/}"
done
export DISPLAY="${DISPLAY:-:0}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
