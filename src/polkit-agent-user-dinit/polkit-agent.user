# dinit service: polkit authentication agent (user session)
# MUST be a distro-native (musl/elogind) build — glibc agents (nix/quickshell
# built-in) cannot resolve elogind sessions (FIX-niri-dms.md round 23).
type = process
load-options = sub-vars
logfile = $HOME/.local/share/dinit/polkit-agent.log
command = /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
smooth-recovery = true
depends-on = wait-wayland.user
depends-on = dbus.user
