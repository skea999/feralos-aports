# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=polkit-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for polkit"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit polkit"
makedepends=""
source="polkit"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/polkit" "$pkgdir/usr/lib/dinit.d/polkit"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../polkit" "$pkgdir/usr/lib/dinit.d/boot.d/polkit"
}

sha512sums="d0090254bc4026b207e4560258c9873f2ae26827bb6e12ba7efb679184ff5edb  polkit"
