# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# Unit name = system bus name. D-Bus activation (.service override packaged
# in /usr/share/feralos/dbus-system-services, materialized at boot into the
# launch helper's standard dirs) starts this unit through feralos-dbus-activate.
pkgname=polkit-dinit
pkgver=0.1.0
pkgrel=7
pkgdesc="dinit service for polkit"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit polkit feralos-dbus-activate"
makedepends=""
source="org.freedesktop.PolicyKit1
	org.freedesktop.PolicyKit1.service"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/org.freedesktop.PolicyKit1" \
		"$pkgdir/lib/dinit.d/org.freedesktop.PolicyKit1"
	# D-Bus activation override: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.freedesktop.PolicyKit1.service" \
		"$pkgdir/usr/share/feralos/dbus-system-services/org.freedesktop.PolicyKit1.service"
}

sha512sums="
