# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# Unit name = the OpenRC initd name (polkit, ADR-010 R1 amendment):
# explicitly-activated system services carry the initd name; the D-Bus
# activation override (bus name org.freedesktop.PolicyKit1) is packaged in
# /usr/share/dinit/dbus-system-services, materialized at boot into the
# launch helper's standard dirs, and starts this unit through
# feralos-dbus-activate.
pkgname=polkit-dinit
pkgver=0.1.0
pkgrel=10
pkgdesc="dinit service for polkit"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit polkit feralos-dbus-activate"
makedepends=""
source="polkit
	org.freedesktop.PolicyKit1.service"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/polkit" \
		"$pkgdir/lib/dinit.d/polkit"
	# D-Bus activation override: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.freedesktop.PolicyKit1.service" \
		"$pkgdir/usr/share/dinit/dbus-system-services/org.freedesktop.PolicyKit1.service"
}

sha512sums="
b73ef816b6b51896064821a3c9b424b6bb80a77306a2bffe28b6cc0b588d52e60400bb17245c7e87dd6285abc5c82db7e55f888bb8fc47cb414cca347d7a1148  polkit
e00002b4f635968e7ed867d689beb04226681acfc5e94da775e5d7d452e45380167f783c0d888a0117ee430284312223ea4532be5881a2deee2d8d30a7461a9e  org.freedesktop.PolicyKit1.service
"
