pkgname=polkit-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for polkit"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit polkit"
makedepends=""
source="polkit-dinit"

build() { return 0; }
check() { return 0; }

package() {
    install -Dm644 "$srcdir/polkit-dinit" "$pkgdir/usr/lib/dinit.d/polkit-dinit"
    mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
    ln -sf ../"polkit-dinit" "$pkgdir/usr/lib/dinit.d/boot.d/polkit-dinit"
}

