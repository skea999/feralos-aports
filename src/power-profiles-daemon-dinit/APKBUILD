# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# power-profiles-daemon on the system bus. Alpine's PPD is D-Bus activated
# (no init script by design): both bus names must route activation to the
# dinit unit through feralos-dbus-activate (ADR-010); the overrides are
# packaged in /usr/share/dinit/dbus-system-services (materialized at boot
# into the launch helper's standard dirs).
pkgname=power-profiles-daemon-dinit
pkgver=0.1.0
pkgrel=4
pkgdesc="dinit service for power-profiles-daemon"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit power-profiles-daemon feralos-dbus-activate"
makedepends=""
source="org.freedesktop.UPower.PowerProfiles
	org.freedesktop.UPower.PowerProfiles.service
	net.hadess.PowerProfiles.service"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/org.freedesktop.UPower.PowerProfiles" \
		"$pkgdir/lib/dinit.d/org.freedesktop.UPower.PowerProfiles"
	# D-Bus activation overrides (both names): the effective Exec starts the unit.
	install -Dm644 "$srcdir/org.freedesktop.UPower.PowerProfiles.service" \
		"$pkgdir/usr/share/dinit/dbus-system-services/org.freedesktop.UPower.PowerProfiles.service"
	install -Dm644 "$srcdir/net.hadess.PowerProfiles.service" \
		"$pkgdir/usr/share/dinit/dbus-system-services/net.hadess.PowerProfiles.service"
}

sha512sums="
