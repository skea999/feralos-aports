e79522c2799172ca30352b86480f9c4d31a08424536fd453753991126f45f1a8d4aeb03b8ebcfa04dd5934f43e79ce507255aadeaaea141cd133cea352bc3b0e  org.freedesktop.UPower.PowerProfiles.service
9c0bd6b3c489aaab7a6f6245d0a13a8d4618e69cc1e6b645ad6c62b7415a5b52403595170ac730a4990417164a8b4491f4c54d9d33506802dc3ebccf226aa99d  net.hadess.PowerProfiles.service
"
