# dinit service: power-profiles-daemon (system bus power profiles)
# Unit name = system bus name: D-Bus activation is routed through
# /usr/share/feralos/dbus-system-services/org.freedesktop.UPower.PowerProfiles.service
# (installed at boot into /usr/local/share/dbus-1/system-services by
# dbus-services-setup; also its net.hadess.PowerProfiles alias), whose Exec
# starts this unit (ADR-010).
type = process
smooth-recovery = true
log-type = file
logfile = /var/log/dinit/org.freedesktop.UPower.PowerProfiles.log
command = /usr/libexec/power-profiles-daemon
depends-on = dbus
depends-on = local.target
before = login.target
