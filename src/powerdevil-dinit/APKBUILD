# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# System-bus dinit units for the KDE Plasma KAuth helper D-Bus activation
# targets OWNED BY powerdevil (ADR-010, R1b purity: the supervision package is
# named after the apk package owning each activation Exec binary).
# Evidence (pkgs.alpinelinux.org file search):
#   org.kde.powerdevil.backlighthelper  Exec /usr/lib/libexec/kf6/kauth/backlighthelper -> powerdevil
#   org.kde.powerdevil.chargethresholdhelper  Exec /usr/lib/libexec/kf6/kauth/chargethresholdhelper -> powerdevil
#   org.kde.powerdevil.discretegpuhelper  Exec /usr/lib/libexec/kf6/kauth/discretegpuhelper -> powerdevil
#   org.kde.powerdevil.wakeupsourcehelper  Exec /usr/lib/libexec/kf6/kauth/wakeupsourcehelper -> powerdevil
# Overrides ship in /usr/share/dinit/dbus-system-services/ (materialized
# at boot into /usr/local/share/dbus-1/system-services via
# dbus-services-setup: the launch helper resolves names only against the
# standard dirs). KAuth per-request helpers: short-lived, no smooth-recovery.
pkgname=powerdevil-dinit
pkgver=0.1.0
pkgrel=2
pkgdesc="dinit services for the powerdevil KAuth helper activation targets"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="feralos-dbus-activate powerdevil"
makedepends=""
source="org.kde.powerdevil.backlighthelper
org.kde.powerdevil.chargethresholdhelper
org.kde.powerdevil.discretegpuhelper
org.kde.powerdevil.wakeupsourcehelper
	org.kde.powerdevil.backlighthelper.service
	org.kde.powerdevil.chargethresholdhelper.service
	org.kde.powerdevil.discretegpuhelper.service
	org.kde.powerdevil.wakeupsourcehelper.service"

build() { return 0; }
check() { return 0; }

package() {
	for helper in org.kde.powerdevil.backlighthelper org.kde.powerdevil.chargethresholdhelper org.kde.powerdevil.discretegpuhelper org.kde.powerdevil.wakeupsourcehelper ; do
		install -Dm644 "$srcdir/$helper" "$pkgdir/lib/dinit.d/$helper"
		# D-Bus activation override: the effective Exec starts the dinit unit.
		install -Dm644 "$srcdir/$helper.service" \
			"$pkgdir/usr/share/dinit/dbus-system-services/$helper.service"
	done
}

