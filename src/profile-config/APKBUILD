# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# profile-config: the static shell/profile defaults as an APK package
# (ADR-013 — the installer no longer writes them).
#   editor.sh  -> micro as $EDITOR
#   console.sh -> root/user PS1
#   pager.sh   -> PAGER=moor (POSIX drop-in; replaces the installer sed that
#                 rewrote the vendor /etc/profile)
#   pager.fish -> PAGER=moor (fish)
pkgname=profile-config
pkgver=0.1.0
pkgrel=0
pkgdesc="FeralOS static shell defaults (editor, PS1, pager)"
url="https://github.com/skea999/feralos-aports"
arch="noarch"
license="ISC"
depends=""
makedepends=""
source="editor.sh console.sh pager.sh pager.fish"
options="!check" # static config, exercised by every login shell

package() {
	install -Dm644 "$srcdir/editor.sh" "$pkgdir/etc/profile.d/editor.sh"
	install -Dm644 "$srcdir/console.sh" "$pkgdir/etc/profile.d/console.sh"
	install -Dm644 "$srcdir/pager.sh" "$pkgdir/etc/profile.d/pager.sh"
	install -Dm644 "$srcdir/pager.fish" "$pkgdir/etc/fish/conf.d/pager.fish"
}
sha512sums="
