# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=rasdaemon-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for rasdaemon"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit rasdaemon"
makedepends=""
source="rasdaemon"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/rasdaemon" "$pkgdir/usr/lib/dinit.d/rasdaemon"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../rasdaemon" "$pkgdir/usr/lib/dinit.d/boot.d/rasdaemon"
}

sha512sums="75b9a9186a0341e471c836dde26b33ed94d2f44b1d285808876d4124df669e63  rasdaemon"
