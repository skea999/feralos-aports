pkgname=rasdaemon-dinit
pkgver=0.1.0
pkgrel=3
pkgdesc="dinit service for rasdaemon"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit rasdaemon"
makedepends=""
source="rasdaemon"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/rasdaemon" "$pkgdir/lib/dinit.d/rasdaemon"
}

