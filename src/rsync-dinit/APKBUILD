# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=rsync-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for rsync"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit rsync"
makedepends=""
source="rsync"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/rsync" "$pkgdir/usr/lib/dinit.d/rsync"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../rsync" "$pkgdir/usr/lib/dinit.d/boot.d/rsync"
}

sha512sums="5c598715653dfed9fcbf79a11cba0042577e55ff8d66ce0a22288c3088873127  rsync"
