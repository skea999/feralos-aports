# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=rsync-dinit
pkgver=0.1.0
pkgrel=7
pkgdesc="dinit service for rsync"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit rsync"
makedepends=""
source="rsync rsync.script rsync.conf"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/rsync" "$pkgdir/lib/dinit.d/rsync"
	install -Dm755 "$srcdir/rsync.script" "$pkgdir/usr/lib/dinit/rsync"
	install -Dm644 "$srcdir/rsync.conf" "$pkgdir/etc/dinit.d/config/rsync.conf"
}

