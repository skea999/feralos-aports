# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# System-bus dinit units for the KDE Plasma KAuth helper D-Bus activation
# targets OWNED BY sddm-kcm (ADR-010, R1b purity: the supervision package is
# named after the apk package owning each activation Exec binary).
# Evidence (pkgs.alpinelinux.org file search):
#   org.kde.kcontrol.kcmsddm  Exec /usr/lib/libexec/kf6/kauth/kcmsddm_authhelper -> sddm-kcm
# Overrides ship in /usr/share/feralos/dbus-system-services/ (materialized
# at boot into /usr/local/share/dbus-1/system-services via
# dbus-services-setup: the launch helper resolves names only against the
# standard dirs). KAuth per-request helpers: short-lived, no smooth-recovery.
pkgname=sddm-kcm-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit services for the sddm-kcm KAuth helper activation target"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="feralos-dbus-activate sddm-kcm"
makedepends=""
source="org.kde.kcontrol.kcmsddm
	org.kde.kcontrol.kcmsddm.service"

build() { return 0; }
check() { return 0; }

package() {
	for helper in org.kde.kcontrol.kcmsddm ; do
		install -Dm644 "$srcdir/$helper" "$pkgdir/lib/dinit.d/$helper"
		# D-Bus activation override: the effective Exec starts the dinit unit.
		install -Dm644 "$srcdir/$helper.service" \
			"$pkgdir/usr/share/feralos/dbus-system-services/$helper.service"
	done
}

sha512sums="
02ee26c2c35ce83e0c97b23954ac8c625e3892afbd97a3633203632dd4c0db8cdc3bc674305b5c315c738d30698b164966c017e18001611be2d1e9678074e9fd  org.kde.kcontrol.kcmsddm
e9761e56dbf2d6936aa5b81db6aaaad91a215063b8b0b3ddb10e573d94da2ddbc126bde2a3421f724d07bf8118e102c6d953a6e325312cd1afbaf6398f48d7c8  org.kde.kcontrol.kcmsddm.service
"
