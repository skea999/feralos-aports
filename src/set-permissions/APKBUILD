# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# set-permissions: the hardening permission posture applied at boot, as its
# own package pulled in as a DEPENDENCY of hardening-config — never installed
# explicitly. Ships one shared script plus its two init flavors (OpenRC initd
# + dinit scripted unit, same unit/initd name per ADR-010 R1). Enablement is
# rules-driven (services map: set-permissions = boot).
pkgname=set-permissions
pkgver=0.1.0
pkgrel=0
pkgdesc="FeralOS secure permission posture at boot (hardening)"
url="https://github.com/skea999/feralos-aports"
arch="noarch"
license="ISC"
depends=""
makedepends=""
source="set-permissions set-permissions.initd set-permissions.dinit"
options="!check" # static script + init files, exercised by services_status

package() {
	install -Dm755 "$srcdir/set-permissions" "$pkgdir/usr/libexec/feralos/set-permissions"
	install -Dm755 "$srcdir/set-permissions.initd" "$pkgdir/etc/init.d/set-permissions"
	install -Dm644 "$srcdir/set-permissions.dinit" "$pkgdir/lib/dinit.d/set-permissions"
}
sha512sums="
