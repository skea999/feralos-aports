# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# User dinit services for signon-ui. Unit names = canonical session D-Bus
# bus names (ADR-010); D-Bus activation is routed through
# feralos-dbus-activate via overrides in /usr/share/feralos/dbus-services/.
# SEPARATE package from signond-user-dinit: the binaries live in the
# signon-ui package (/usr/bin/signon-ui — source-verified in the Alpine
# signon-ui APK), not in signond; both activation files shipped by that
# package map to the same binary.
pkgname=signon-ui-user-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="User dinit services for signon-ui (webcredentials + singlesignonui)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="dinit signon-ui feralos-dbus-activate"
makedepends=""
source="com.canonical.indicators.webcredentials.user
	com.nokia.singlesignonui.user
	com.canonical.indicators.webcredentials.service
	com.nokia.singlesignonui.service"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/com.canonical.indicators.webcredentials.user" \
		"$pkgdir/etc/dinit.d/user/com.canonical.indicators.webcredentials.user"
	install -Dm644 "$srcdir/com.nokia.singlesignonui.user" \
		"$pkgdir/etc/dinit.d/user/com.nokia.singlesignonui.user"
	# D-Bus activation overrides: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/com.canonical.indicators.webcredentials.service" \
		"$pkgdir/usr/share/feralos/dbus-services/com.canonical.indicators.webcredentials.service"
	install -Dm644 "$srcdir/com.nokia.singlesignonui.service" \
		"$pkgdir/usr/share/feralos/dbus-services/com.nokia.singlesignonui.service"
}

sha512sums="
