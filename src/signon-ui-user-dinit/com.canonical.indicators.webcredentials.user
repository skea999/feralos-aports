# dinit user service: signon-ui serving com.canonical.indicators.webcredentials
# Online-accounts credential prompt UI. Upstream's activation file execs
# /usr/bin/signon-ui here (its sh wrapper only falls back to
# /usr/bin/online-accounts-service on Ubuntu/ubuntumirclient, and Alpine's
# signon-ui package ships no online-accounts-service — source-verified APK
# contents). Unit name = canonical session D-Bus bus name (ADR-010); D-Bus
# activation is routed through
# /usr/share/feralos/dbus-services/com.canonical.indicators.webcredentials.service.
type = process
smooth-recovery = true
load-options = sub-vars
logfile = $HOME/.local/share/dinit/com.canonical.indicators.webcredentials.log
command = /usr/bin/signon-ui
working-dir = $HOME
depends-on = dbus.user
