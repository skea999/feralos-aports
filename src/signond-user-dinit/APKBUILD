# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# User dinit service for signond. Unit name = canonical session D-Bus bus name
# (ADR-010); D-Bus activation is routed through feralos-dbus-activate via
# overrides in /usr/share/dinit/dbus-services/. The com.nokia.SingleSignOn.Backup
# target gets its OWN transient unit: the upstream activation Exec is
# /usr/bin/signond -backup (backup helper, short-lived), not the main daemon.
# Transitional units: the harness check dbus_activation_migration retires
# them once dbus-broker is installed and every activation target has a
# package-shipped unit.
pkgname=signond-user-dinit
pkgver=0.1.0
pkgrel=4
pkgdesc="User dinit service for signond (+ backup helper unit)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="dinit signond feralos-dbus-activate"
makedepends=""
source="com.google.code.AccountsSSO.SingleSignOn.user
	com.google.code.AccountsSSO.SingleSignOn.service
	com.nokia.SingleSignOn.Backup.user com.nokia.SingleSignOn.Backup.service"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/com.google.code.AccountsSSO.SingleSignOn.user" \
		"$pkgdir/etc/dinit.d/user/com.google.code.AccountsSSO.SingleSignOn.user"
	install -Dm644 "$srcdir/com.nokia.SingleSignOn.Backup.user" \
		"$pkgdir/etc/dinit.d/user/com.nokia.SingleSignOn.Backup.user"
	# D-Bus activation overrides: the effective Exec starts the dinit units.
	install -Dm644 "$srcdir/com.google.code.AccountsSSO.SingleSignOn.service" \
		"$pkgdir/usr/share/dinit/dbus-services/com.google.code.AccountsSSO.SingleSignOn.service"
	install -Dm644 "$srcdir/com.nokia.SingleSignOn.Backup.service" \
		"$pkgdir/usr/share/dinit/dbus-services/com.nokia.SingleSignOn.Backup.service"
}

