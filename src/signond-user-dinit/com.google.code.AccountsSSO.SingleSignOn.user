# dinit user service: signond (com.google.code.AccountsSSO.SingleSignOn)
# Single Sign-On daemon. Unit name = canonical D-Bus bus name (ADR-010);
# D-Bus activation is routed through
# /usr/local/share/dbus-1/services/com.google.code.AccountsSSO.SingleSignOn.service.
type = process
smooth-recovery = true
load-options = sub-vars
logfile = $HOME/.local/share/dinit/com.google.code.AccountsSSO.SingleSignOn.log
command = /usr/bin/signond
working-dir = $HOME
depends-on = dbus.user
