# feralos signond-user-dinit: D-Bus activation target for
# com.nokia.SingleSignOn.Backup (ADR-010).
# Transitional: drop when the package (or dbus-broker ephemeral services) ships
# this unit itself. Backup helper: short-lived, no smooth-recovery.
type = process
command = /usr/bin/signond -backup
smooth-recovery = false
restart = false
load-options = sub-vars
logfile = $HOME/.local/share/dinit/com.nokia.SingleSignOn.Backup.log
depends-on = dbus.user
