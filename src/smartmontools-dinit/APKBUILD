# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=smartmontools-dinit
pkgver=0.1.0
pkgrel=5
pkgdesc="dinit service for smartd (Alpine initd name)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit smartmontools"
makedepends=""
source="smartd smartd.script smartd.conf"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/smartd" "$pkgdir/lib/dinit.d/smartd"
	install -Dm755 "$srcdir/smartd.script" "$pkgdir/usr/lib/dinit/smartd"
	install -Dm644 "$srcdir/smartd.conf" "$pkgdir/etc/dinit.d/config/smartd.conf"
}

