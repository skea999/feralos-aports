# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=smartmontools-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for smartmontools"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit smartmontools"
makedepends=""
source="smartmontools"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/smartmontools" "$pkgdir/usr/lib/dinit.d/smartmontools"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../smartmontools" "$pkgdir/usr/lib/dinit.d/boot.d/smartmontools"
}

sha512sums="471866462b78740e1dd2a3d214cd1e8951078ae0808aa555f3d244b142247afd  smartmontools"
