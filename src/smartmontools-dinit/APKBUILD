pkgname=smartmontools-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for smartmontools"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit smartmontools"
makedepends=""
source="smartmontools-dinit"

build() { return 0; }
check() { return 0; }

package() {
    install -Dm644 "$srcdir/smartmontools-dinit" "$pkgdir/usr/lib/dinit.d/smartmontools-dinit"
    mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
    ln -sf ../"smartmontools-dinit" "$pkgdir/usr/lib/dinit.d/boot.d/smartmontools-dinit"
}

