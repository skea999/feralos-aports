# Maintainer: FeralOS <dev@feralos.org>
pkgname=smartmontools-dinit
pkgver=0.1.0
pkgrel=1
pkgdesc="dinit service for smartmontools"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit smartmontools"
makedepends=""
source="smartmontools"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/smartmontools" "$pkgdir/lib/dinit.d/smartmontools"
	mkdir -p "$pkgdir/lib/dinit.d/boot.d"
	ln -sf "../smartmontools" "$pkgdir/lib/dinit.d/boot.d/smartmontools"
}

sha512sums="ca35201afee0a511f2c31ffcf2f5b13e90c8a6a7a6b81d70934e4102eb13417303d46def7e4ee08ba4d86c60889f373a1fd66ba9cc4f3c1c779dfb5a7bf42dac  smartmontools"
