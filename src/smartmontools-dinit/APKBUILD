pkgname=smartmontools-dinit
pkgver=0.1.0
pkgrel=2
pkgdesc="dinit service for smartd (Alpine initd name)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit smartmontools"
makedepends=""
source="smartd"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/smartd" "$pkgdir/lib/dinit.d/smartd"
}

