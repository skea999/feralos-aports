# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=sshd-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for sshd"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit openssh"
makedepends=""
source="sshd"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/sshd" "$pkgdir/usr/lib/dinit.d/sshd"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../sshd" "$pkgdir/usr/lib/dinit.d/boot.d/sshd"
}

sha512sums="d996e2a5fa9a070f3dd95de4951e0df80d1bcf0ae995f0b78c3317ac19ede74d  sshd"
