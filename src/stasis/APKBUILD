# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# stasis: context-aware Wayland idle manager (Rust) — owns the niriWayle
# idle timing (lock -> dpms -> suspend plans; veila = lock screen only,
# its own idle stays disabled). Rust/cargo package: matugen pattern
# (fetch --locked + build/test --frozen).
#
# Licensing: GPL-3.0-only source; the compiled program links
# lib_game_detector 0.0.39 (AGPL-3.0-only, bundled_sqlite feature) —
# upstream THIRD_PARTY.md requires metadata to identify BOTH licenses.
#
# Pure-Rust dependency set (wayland-client/zbus/evdev/rune-cfg crates —
# no system C libraries at build time); bundled_sqlite needs cc -> gcc.
# Runtime helpers (not build deps): pw-dump from pipewire (media/mic
# detection), loginctl from elogind (suspend step), /dev/input read
# access for gamepad activity.
pkgname=stasis
pkgver=1.6.3
pkgrel=0
pkgdesc="Context-aware Wayland idle manager — lock/dpms/suspend plans with media, game and gamepad awareness"
url="https://github.com/saltnpepper97/stasis"
arch="all"
license="GPL-3.0-only AGPL-3.0-only"
depends="pipewire"
makedepends="cargo gcc"
source="$pkgname-$pkgver.tar.gz::https://github.com/saltnpepper97/stasis/archive/refs/tags/v$pkgver.tar.gz
	stasis.user
	stasis-session"
options="!check" # unit tests need a rust toolchain env; upstream runs 68 unit tests in their CI

prepare() {
	default_prepare
	# matugen pattern: vendor-free locked fetch against the target triple
	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo build --frozen --release
}

package() {
	install -Dm755 target/release/stasis "$pkgdir"/usr/bin/stasis
	install -Dm644 "$srcdir/stasis.user" "$pkgdir/etc/dinit.d/user/stasis.user"
	install -Dm755 "$srcdir/stasis-session" \
		"$pkgdir/etc/dinit.d/user/scripts/stasis-session"
	install -Dm644 assets/stasis.png \
		"$pkgdir/usr/share/icons/hicolor/256x256/apps/stasis.png"
	# both licenses must ship with the compiled program (AGPL-3.0 section 13)
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
	install -Dm644 LICENSES/AGPL-3.0-only.txt \
		"$pkgdir"/usr/share/licenses/$pkgname/AGPL-3.0-only.txt
}

