# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# User dinit service for system-config-printer. Unit name = canonical session
# D-Bus bus name (ADR-010); D-Bus activation is routed through
# feralos-dbus-activate via an override in /usr/share/dinit/dbus-services/.
# Verified on Alpine 3.24: upstream activation Exec = /usr/bin/scp-dbus-service,
# a POSIX-sh wrapper that execs the Python service; the wrapper ships in
# system-config-printer-common, hence the dependency.
# Transitional unit: the harness check dbus_activation_migration retires it
# once dbus-broker is installed and every activation target has a
# package-shipped unit.
pkgname=system-config-printer-user-dinit
pkgver=0.1.0
pkgrel=3
pkgdesc="User dinit service for system-config-printer (Config.Printing activation target)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="feralos-dbus-activate system-config-printer-common"
# VERSIONED provides are REQUIRED: unversioned provides are virtual and apk add <alias> refuses the provider.
# The two names below cover the audit's candidate chain for the
# org.fedoraproject.Config.Printing target: who-owns(/usr/bin/scp-dbus-service)
# = system-config-printer-common-user-dinit, bus = org.fedoraproject.Config.Printing-user-dinit
# (audit run 2026-11-05T21-59-48Z tried both before MISSing — the package
# itself resolves neither name without these aliases).
provides="system-config-printer-common-user-dinit=$pkgver-r$pkgrel org.fedoraproject.Config.Printing-user-dinit=$pkgver-r$pkgrel"
makedepends=""
source="org.fedoraproject.Config.Printing.user
	org.fedoraproject.Config.Printing.service"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/org.fedoraproject.Config.Printing.user" \
		"$pkgdir/etc/dinit.d/user/org.fedoraproject.Config.Printing.user"
	# D-Bus activation override: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.fedoraproject.Config.Printing.service" \
		"$pkgdir/usr/share/dinit/dbus-services/org.fedoraproject.Config.Printing.service"
}

sha512sums="
836cbeffc747290ce914d7bcb871c496e0fe47b2cfb54dd9d3ae2362b279cdde04fa84b085c50a1e510fbaf24edc863c6867e534b35efa2cbf9249f1a7ce1e44  org.fedoraproject.Config.Printing.user
b3053b528ac830dc5d4d2255ed64924bb1d22e83a2fcaa5d26e6930b58c28acb089825488d41c463099231febab0cd3b85a65bfb89098d58b2a364fb43fff096  org.fedoraproject.Config.Printing.service
"
