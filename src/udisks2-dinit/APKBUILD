# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=udisks2-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for udisks2"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit udisks2"
makedepends=""
source="udisks2"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/udisks2" "$pkgdir/usr/lib/dinit.d/udisks2"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../udisks2" "$pkgdir/usr/lib/dinit.d/boot.d/udisks2"
}

sha512sums="9b31371f1eef4fe817dbc47970b5631abb276da50e4d9187f6ef81dacd4afca1  udisks2"
