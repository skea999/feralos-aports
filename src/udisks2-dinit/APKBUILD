# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# udisks2 on the system bus. ADR-010: the D-Bus activation target
# org.freedesktop.UDisks2 routes through feralos-dbus-activate to a dinit
# unit named after the bus name; the override is packaged in
# /usr/share/feralos/dbus-system-services (materialized at boot into the
# launch helper's standard dirs). Transitional units: the harness check
# dbus_activation_migration retires them once dbus-broker is installed and
# every activation target has a package-shipped unit.
pkgname=udisks2-dinit
pkgver=0.1.0
pkgrel=5
pkgdesc="dinit service for udisks2"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit udisks2 feralos-dbus-activate"
makedepends=""
source="udisks2
	org.freedesktop.UDisks2
	org.freedesktop.UDisks2.service"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/udisks2" "$pkgdir/lib/dinit.d/udisks2"
	# D-Bus activation target (canonical bus name) + override.
	install -Dm644 "$srcdir/org.freedesktop.UDisks2" \
		"$pkgdir/lib/dinit.d/org.freedesktop.UDisks2"
	install -Dm644 "$srcdir/org.freedesktop.UDisks2.service" \
		"$pkgdir/usr/share/feralos/dbus-system-services/org.freedesktop.UDisks2.service"
}

sha512sums="
