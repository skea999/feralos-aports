# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=udisks2-dinit
pkgver=0.1.0
pkgrel=1
pkgdesc="dinit service for udisks2"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit udisks2"
makedepends=""
source="udisks2"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/udisks2" "$pkgdir/lib/dinit.d/udisks2"
	mkdir -p "$pkgdir/lib/dinit.d/boot.d"
	ln -sf "../udisks2" "$pkgdir/lib/dinit.d/boot.d/udisks2"
}

sha512sums="c0c10071eff9765bc97687bd5fd0df48b17374dbb279dd12725a7898d5bf5089f3b1c7c626206ab0e57b6e52837435f0daede8671066dbe8c50415ef77c3a7dd  udisks2"
