# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# dinit service for upower. Daemon path verified on Alpine 3.24:
# /usr/libexec/upowerd (flat, NOT /usr/libexec/upower/upowerd).
# Unit name = system bus name. D-Bus activation (.service override in
# /etc/dbus-1/system-services/) starts this unit through feralos-dbus-activate.
pkgname=upower-dinit
pkgver=0.1.0
pkgrel=1
pkgdesc="dinit service for upower"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit upower feralos-dbus-activate"
makedepends=""
source="org.freedesktop.UPower org.freedesktop.UPower.script org.freedesktop.UPower.conf
	org.freedesktop.UPower.service"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/org.freedesktop.UPower" \
		"$pkgdir/lib/dinit.d/org.freedesktop.UPower"
	install -Dm755 "$srcdir/org.freedesktop.UPower.script" \
		"$pkgdir/usr/lib/dinit/org.freedesktop.UPower"
	install -Dm644 "$srcdir/org.freedesktop.UPower.conf" \
		"$pkgdir/etc/dinit.d/config/org.freedesktop.UPower.conf"
	# D-Bus activation override: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.freedesktop.UPower.service" \
		"$pkgdir/etc/dbus-1/system-services/org.freedesktop.UPower.service"
}

