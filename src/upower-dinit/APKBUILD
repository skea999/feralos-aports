# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# dinit service for upower. Daemon path verified on Alpine 3.24:
# /usr/libexec/upowerd (flat, NOT /usr/libexec/upower/upowerd).
pkgname=upower-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for upower"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit upower"
makedepends=""
source="upower upower.script upower.conf"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/upower" "$pkgdir/lib/dinit.d/upower"
	install -Dm755 "$srcdir/upower.script" "$pkgdir/usr/lib/dinit/upower"
	install -Dm644 "$srcdir/upower.conf" "$pkgdir/etc/dinit.d/config/upower.conf"
}

