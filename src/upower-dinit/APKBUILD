24b8209787022ecddc426a18aebe02eece0627f7f8ac124477c3a1423f641c086bf0972a917e5d715df285b21022d6f2f4981f9b94098c589f67286d1e12b445  upower.script
cbbd2d815c27ea9db33786a3123fe59d00a33624ea552af39bde2030f1fe9beb0e5cc9fbe5f435450a176d96b5a0fc816567b91af12f6a680a5400c2b2147a04  upower.conf
"
