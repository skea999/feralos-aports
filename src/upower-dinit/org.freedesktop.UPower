# dinit service: upower (power history/battery daemon, system bus)
# Unit name = system bus name: D-Bus activation is routed through
# /etc/dbus-1/system-services/org.freedesktop.UPower.service, whose Exec
# starts this unit (ADR-010).
type = process
smooth-recovery = true
log-type = file
logfile = /var/log/dinit/org.freedesktop.UPower.log
command = /usr/lib/dinit/org.freedesktop.UPower
env-file = /etc/dinit.d/config/org.freedesktop.UPower.conf
depends-on = dbus
depends-on = local.target
before = login.target
