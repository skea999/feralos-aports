#!/bin/sh
# dinit wrapper for upower — sources the packaged config (if present), then execs
# the daemon with the fixed flags below plus the extra args from the config.
[ -r /etc/dinit.d/config/org.freedesktop.UPower.conf ] && . /etc/dinit.d/config/org.freedesktop.UPower.conf
exec /usr/libexec/upowerd ${UPOWER_OPTS}
