# Maintainer: FeralOS <dev@feralos.org>
# ursine: FeralOS control center — ursined (root daemon, shadow-file auth,
# Unix socket) + ursine (libcosmic GUI client). Absent from Alpine. Rust/cargo
# workspace package (matugen pattern: fetch --locked + build --frozen).
#
# AUTHENTICATION (changed in upstream 0.39.2): the daemon verifies user +
# password in-process against /etc/shadow (pwhash, pure Rust; Webmin
# pattern; `ursined --version` prints "auth: shadow"). There is NO `pam`
# cargo feature, no pam-client/libpam, no stub authenticator and no
# /etc/pam.d/ursine any more: the build takes no features and the package
# ships no PAM file. Up to 0.35.x the package built with --features pam and
# shipped /etc/pam.d/ursine; do NOT bring either back. Only members of
# group wheel (read from /etc/group) get a session. Socket: /run/ursine.sock.
#
# libcosmic is a git dependency (pop-os/libcosmic, pinned rev) -> git in
# makedepends. v0.22.1 adds cosmic-theme + cosmic-config from the SAME
# pinned rev (pure-Rust; theming module's COSMIC target) — no new system
# makedepends. v0.24.0 adds src/ursinectl — root CLI, in-process host of
# ursine-core (chroot-capable): same workspace deps (ursine-api/core,
# tokio, serde_json — no new system libs); shipped next to the GUI client.
# v0.25.x/v0.26.0 add the system-admin modules (packages, services, disks,
# network, bluetooth, firewall, printers, scanners setup, logs, crontab,
# snapshots, users, theming, flatpak permissions) — pure Rust, runtime
# tools only (mkfs/parted/firewall-cmd/nmcli/bluetoothctl), no new build
# deps. v0.26.0 also ships packaging/man/ursinectl.1.
# v0.27.0 = the "no D-Bus, ever" release: ALL D-Bus removed — Users talks
# to useradd/adduser/chpasswd CLI (shadow + busybox), Disks talks to
# mount/umount/blkid CLI (util-linux + busybox); zbus dropped; capabilities
# Accountsservice -> Shadow, Udisks2 -> Parted.
# v0.35.0 = the package-manager fusion release (0.28-0.35): one GUI code
# path for apk/flatpak/nix (canonical SECTIONS order + shared confirm
# blocks), flatpak orphan count + search Preview, uniform "Repositories"
# naming, regex Pattern actions for apk/flatpak, update-check counters +
# auto-check toggler, aa-easyprof AppArmor actions; the flatpak
# permissions editor is REMOVED everywhere (daemon actions + GUI + man).
# nix/flatpak CLI calls stay runtime tools provided by the installer's
# EnableNix/flatpak features — NOT unconditional depends.
# v0.36.0-v0.49.0 (verified against upstream v0.49.0, wire protocol v7):
#   * 0.39.2: PAM -> shadow-file authentication (above); ursined and
#     ursinectl are static upstream (zero libs) when built with the release
#     rustflags — this package builds them dynamic like the GUI, abuild adds
#     the so: depends. pam-client/pam-sys/serde_yaml left the lockfile
#     (saphyr, kdl 4, pwhash, getrandom are pure Rust): linux-pam-dev left
#     makedepends.
#   * 0.47.0: refresh_apk removed (protocol v7). 0.49.0: `ursinectl actions
#     [--json]` (catalogue schema ursine.actions/1); man page extended.
#   * 0.49.0: AppArmor profile backups go to /var/backups/ursine/apparmor,
#     created by the daemon at run time (not a package directory).
#   * Service files (dinit unit, wrapper, conf, OpenRC initd) are unchanged
#     upstream since 0.35.0; Cargo.toml still pins libcosmic rev 430f3d48.
#   * rust-toolchain.toml asks for Rust 1.99.1 (rustup channel; abuild
#     builds with Alpine's cargo).
# Runtime depends = parted + shadow + util-linux (Disks/Users modules) —
# see the depends= line below.
# The package only SHIPS the service assets (dinit unit +
# ADR-008 wrapper + conf, OpenRC initd) — enablement is done
# by the FeralOS installer services map, never by the package itself
# (post-install only creates the config/log dirs).
#
# check() runs the member set from 0.27.0 (unchanged through 0.49.0;
# -p list below): the
# src/ursinectl integration tests (e2e/inprocess) are calibrated for
# upstream's root CI container ("runs as root ... the same condition the
# CLI enforces"; Dispatch expectations tuned to the ursine-ci tool set) —
# they would fail under abuild's non-root, differently-tooled sandbox.
# Pure-logic unit tests (ursine-core/api/ursined/ursine) stay enforced.
#
# Extracted dir = ursine-$pkgver (GitHub strips the leading v of the tag),
# no builddir override needed. Binaries land in artifacts/target/release/
# (the repo's .cargo/config.toml sets build.target-dir = artifacts/target,
# plus the -crt-static=off rustflag: dynamic musl, the GUI links
# libxkbcommon dynamically).
pkgname=ursine
pkgver=0.49.0
pkgrel=0
pkgdesc="FeralOS control center: shadow-authenticated root daemon + libcosmic GUI client"
url="https://github.com/skea999/ursine"
arch="x86_64"
license="ISC"
makedepends="cargo git libxkbcommon-dev"
# parted = HARD requirement of the Disks module (it gates the WHOLE
# module — partition/format actions — with no fallback in code); shadow +
# util-linux = belt-and-braces so the Users/Disks CLI calls hit the real
# useradd/chpasswd and mount/umount/blkid instead of busybox applets.
# Declared HERE so EVERY ursine install gets them, instead of per-DE
# explicit entries in the installer rules.
depends="parted shadow util-linux"
# runtime shared libs (libxkbcommon, libgcc, ...) are picked up automatically as
# so: dependencies by abuild's ELF tracing — the so: half needs no entry.
# config/log dirs created at install time (mode 0750), not packaged dirs
install="ursine.post-install"
source="https://github.com/skea999/ursine/archive/refs/tags/v$pkgver/ursine-v$pkgver.tar.gz
	ursined.dinit
	ursined.script
	ursined.conf
	ursined.initd
"

prepare() {
	default_prepare
	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo build --frozen --release
}

# ursine-core tests that need root: on abuild (ordinary user) 32 of its 321
# tests fail (chown, "configuration parent is not root-owned", writes under
# /run/ursine and /.snapshots); they pass in upstream's root CI container.
# Skipped by exact name; the other 288 and every ursine-api/ursined/ursine
# test stay enforced.
_root_tests="config::tests::missing_file_seeds_only_modules_table
	config::tests::new_config_has_explicit_private_mode
	config::tests::refuses_group_or_world_writable_config
	config::tests::set_module_switch_accepts_inline_modules_table
	config::tests::set_module_switch_creates_modules_table
	config::tests::set_module_switch_updates_one_key_and_preserves_comments
	config::tests::write_template_is_atomic_and_readable
	dispatch::tests::config_init_refuses_to_overwrite_existing_file
	dispatch::tests::config_switch_persists_and_applies_live
	dispatch::tests::log_read_follow_sees_appended_lines
	modules::crontab::tests::staging_path_is_per_process_under_run
	modules::logs::tests::binary_content_is_rejected
	modules::logs::tests::line_count_is_clamped_and_empty_reads_are_safe
	modules::logs::tests::list_discovers_new_files_and_skips_compressed
	modules::logs::tests::tail_before_and_follow_cursors
	modules::snapshots::conf::tests::init_creates_a_readable_config_once
	modules::theming::apply::tests::environment_writes_platform_theme_for_available_qtct_only
	modules::theming::apply::tests::gtk_css_imports_the_shell_palette_without_touching_it
	modules::theming::apply::tests::gtk_settings_writes_ini_and_css_for_wayle_source
	modules::theming::apply::tests::kde_writes_scheme_and_selects_it_in_kdeglobals
	modules::theming::apply::tests::minimize_toggle_switches_layout_and_kde_buttons
	modules::theming::apply::tests::qtct_writes_scheme_file_and_selection
	modules::theming::apps::tests::alacritty_import_matches_the_winning_source
	modules::theming::apps::tests::electron_flags_are_added_once
	modules::theming::apps::tests::firefox_preserves_foreign_userchrome
	modules::theming::apps::tests::firefox_writes_chrome_and_merges_prefs
	modules::theming::apps::tests::foot_cava_replace_only_marker_owned_sections
	modules::theming::apps::tests::galculator_display_colors_merge_preserve_the_rest
	modules::theming::apps::tests::kitty_appends_include_once_and_ignores_comments
	modules::theming::apps::tests::vscodium_merges_colors_without_dropping_user_keys
	modules::theming::cosmic::tests::write_entry_targets_the_user_home_not_root
	modules::theming::write::tests::write_owned_is_atomic_and_replaces
"

check() {
	# whole workspace minus ursinectl (see the header comment); the
	# _root_tests are skipped by exact name
	set --
	for t in $_root_tests; do set -- "$@" --skip "$t"; done
	cargo test --frozen --release \
		-p ursine-api -p ursine-core -p ursined -p ursine -- "$@"
}

package() {
	install -Dm755 artifacts/target/release/ursined "$pkgdir"/usr/sbin/ursined
	install -Dm755 artifacts/target/release/ursine "$pkgdir"/usr/bin/ursine
	install -Dm755 artifacts/target/release/ursinectl "$pkgdir"/usr/bin/ursinectl
	# gzipped — abuild rejects uncompressed man pages
	install -Dm644 packaging/man/ursinectl.1 "$pkgdir"/usr/share/man/man1/ursinectl.1
	gzip -9 "$pkgdir"/usr/share/man/man1/ursinectl.1
	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/

	# dinit: upstream ships @PLACEHOLDER@ tokens (substituted by its
	# install.sh) — substitute the FeralOS paths here, same as the OpenRC
	# initd below, and drop the "do not edit the tokens" comments (the
	# shipped copy is already baked). The upstream unit already carries the
	# local.target fix, log-type=file and the ADR-008 wrapper layout.
	sed -e 's|@LOCALSTATEDIR@|/var|g' \
		-e 's|@LIBEXECDIR@|/usr/lib|g' \
		-e 's|@DINIT_CONFIG_DIR@|/etc/dinit.d/config|g' \
		-e 's|@SBINDIR@|/usr/sbin|g' \
		-e 's|@SYSCONFDIR@|/etc|g' \
		-e '/Paths are substituted by/d' \
		-e '/@PLACEHOLDER@/d' \
		-e '/^# the repository copy\.$/d' \
		"$srcdir"/ursined.dinit > "$srcdir"/ursined.dinit.feralos
	install -Dm644 "$srcdir"/ursined.dinit.feralos "$pkgdir"/lib/dinit.d/ursined

	sed -e 's|@LOCALSTATEDIR@|/var|g' \
		-e 's|@LIBEXECDIR@|/usr/lib|g' \
		-e 's|@DINIT_CONFIG_DIR@|/etc/dinit.d/config|g' \
		-e 's|@SBINDIR@|/usr/sbin|g' \
		-e 's|@SYSCONFDIR@|/etc|g' \
		-e '/Paths are substituted by/d' \
		-e '/@PLACEHOLDER@/d' \
		-e '/^# the repository copy\.$/d' \
		"$srcdir"/ursined.script > "$srcdir"/ursined.script.feralos
	install -Dm755 "$srcdir"/ursined.script.feralos "$pkgdir"/usr/lib/dinit/ursined

	sed -e 's|@LOCALSTATEDIR@|/var|g' \
		-e 's|@LIBEXECDIR@|/usr/lib|g' \
		-e 's|@DINIT_CONFIG_DIR@|/etc/dinit.d/config|g' \
		-e 's|@SBINDIR@|/usr/sbin|g' \
		-e 's|@SYSCONFDIR@|/etc|g' \
		"$srcdir"/ursined.conf > "$srcdir"/ursined.conf.feralos
	install -Dm644 "$srcdir"/ursined.conf.feralos \
		"$pkgdir"/etc/dinit.d/config/ursined.conf

	# OpenRC initd: upstream ships @PLACEHOLDER@ tokens (substituted by its
	# install.sh) — substitute the FeralOS paths here and drop the stale
	# "do not edit the tokens" comment (the shipped copy is already baked)
	sed -e 's|@SBINDIR@|/usr/sbin|g' \
		-e 's|@SYSCONFDIR@|/etc|g' \
		-e 's|@LOCALSTATEDIR@|/var|g' \
		-e '/^# Paths are substituted by install.sh/d' \
		-e '/^# the repository copy\.$/d' \
		"$srcdir"/ursined.initd > "$srcdir"/ursined.initd.feralos
	install -Dm755 "$srcdir"/ursined.initd.feralos "$pkgdir"/etc/init.d/ursined
}

