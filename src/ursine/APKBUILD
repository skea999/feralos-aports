# Maintainer: FeralOS <dev@feralos.org>
# ursine: FeralOS control center — ursined (root daemon, PAM auth, Unix
# socket) + ursine (libcosmic GUI client). Absent from Alpine. Rust/cargo
# workspace package (matugen pattern: fetch --locked + build --frozen).
#
# --features pam is MANDATORY: the daemon must use the real PAM
# authenticator (pam-client -> libpam); the FeralOS installer refuses the
# default stub auth. Do NOT drop the flag.
#
# libcosmic is a git dependency (pop-os/libcosmic, pinned rev) -> git in
# makedepends. The package only SHIPS the service assets (dinit unit +
# ADR-008 wrapper + conf, OpenRC initd, pam.d file) — enablement is done
# by the FeralOS installer services map, never by the package itself
# (post-install only creates the config/log dirs).
#
# Extracted dir = ursine-$pkgver (GitHub strips the leading v of the tag),
# no builddir override needed. Binaries land in artifacts/target/release/
# (the repo's .cargo/config.toml sets build.target-dir = artifacts/target,
# plus the -crt-static rustflag that makes -lpam resolve on musl).
pkgname=ursine
pkgver=0.19.0
pkgrel=2
pkgdesc="FeralOS control center: PAM-authenticated root daemon + libcosmic GUI client"
url="https://github.com/skea999/ursine"
arch="x86_64"
license="ISC"
makedepends="cargo git linux-pam-dev libxkbcommon-dev"
# runtime shared libs (libpam, libgcc, ...) are picked up automatically as
# so: dependencies by abuild's ELF tracing — no explicit depends needed.
depends=""
# config/log dirs created at install time (mode 0750), not packaged dirs
install="ursine.post-install"
source="https://github.com/skea999/ursine/archive/refs/tags/v$pkgver/ursine-v$pkgver.tar.gz
	ursine.pam
	ursined.dinit
	ursined.script
	ursined.conf
	ursined.initd
"

prepare() {
	default_prepare
	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo build --frozen --release --features pam
}

check() {
	cargo test --frozen --release --features pam
}

package() {
	install -Dm755 artifacts/target/release/ursined "$pkgdir"/usr/sbin/ursined
	install -Dm755 artifacts/target/release/ursine "$pkgdir"/usr/bin/ursine
	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/

	# PAM auth stack (auth + account via pam_unix)
	install -Dm644 "$srcdir"/ursine.pam "$pkgdir"/etc/pam.d/ursine

	# dinit: upstream ships @PLACEHOLDER@ tokens (substituted by its
	# install.sh) — substitute the FeralOS paths here, same as the OpenRC
	# initd below, and drop the "do not edit the tokens" comments (the
	# shipped copy is already baked). The upstream unit already carries the
	# local.target fix, log-type=file and the ADR-008 wrapper layout.
	sed -e 's|@LOCALSTATEDIR@|/var|g' \
		-e 's|@LIBEXECDIR@|/usr/lib|g' \
		-e 's|@DINIT_CONFIG_DIR@|/etc/dinit.d/config|g' \
		-e 's|@SBINDIR@|/usr/sbin|g' \
		-e 's|@SYSCONFDIR@|/etc|g' \
		-e '/Paths are substituted by/d' \
		-e '/@PLACEHOLDER@/d' \
		-e '/^# the repository copy\.$/d' \
		"$srcdir"/ursined.dinit > "$srcdir"/ursined.dinit.feralos
	install -Dm644 "$srcdir"/ursined.dinit.feralos "$pkgdir"/lib/dinit.d/ursined

	sed -e 's|@LOCALSTATEDIR@|/var|g' \
		-e 's|@LIBEXECDIR@|/usr/lib|g' \
		-e 's|@DINIT_CONFIG_DIR@|/etc/dinit.d/config|g' \
		-e 's|@SBINDIR@|/usr/sbin|g' \
		-e 's|@SYSCONFDIR@|/etc|g' \
		-e '/Paths are substituted by/d' \
		-e '/@PLACEHOLDER@/d' \
		-e '/^# the repository copy\.$/d' \
		"$srcdir"/ursined.script > "$srcdir"/ursined.script.feralos
	install -Dm755 "$srcdir"/ursined.script.feralos "$pkgdir"/usr/lib/dinit/ursined

	sed -e 's|@LOCALSTATEDIR@|/var|g' \
		-e 's|@LIBEXECDIR@|/usr/lib|g' \
		-e 's|@DINIT_CONFIG_DIR@|/etc/dinit.d/config|g' \
		-e 's|@SBINDIR@|/usr/sbin|g' \
		-e 's|@SYSCONFDIR@|/etc|g' \
		"$srcdir"/ursined.conf > "$srcdir"/ursined.conf.feralos
	install -Dm644 "$srcdir"/ursined.conf.feralos \
		"$pkgdir"/etc/dinit.d/config/ursined.conf

	# OpenRC initd: upstream ships @PLACEHOLDER@ tokens (substituted by its
	# install.sh) — substitute the FeralOS paths here and drop the stale
	# "do not edit the tokens" comment (the shipped copy is already baked)
	sed -e 's|@SBINDIR@|/usr/sbin|g' \
		-e 's|@SYSCONFDIR@|/etc|g' \
		-e 's|@LOCALSTATEDIR@|/var|g' \
		-e '/^# Paths are substituted by install.sh/d' \
		-e '/^# the repository copy\.$/d' \
		"$srcdir"/ursined.initd > "$srcdir"/ursined.initd.feralos
	install -Dm755 "$srcdir"/ursined.initd.feralos "$pkgdir"/etc/init.d/ursined
}

