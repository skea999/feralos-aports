type = process
command = /usr/lib/dinit/ursined
# logfile lives in the @var-log fstab subvol — must start AFTER the local
# mounts (early-fs-fstab), else "opening log file: No such file or
# directory" at boot (vector has the same pattern for /var/log).
depends-on = local.target
before = login.target
logfile = /var/log/ursine/ursined.log
env-file = /etc/dinit.d/config/ursined.conf
smooth-recovery = true
restart = false
