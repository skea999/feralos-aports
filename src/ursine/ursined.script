#!/bin/sh
# shellcheck shell=sh disable=SC2086,SC1091
# dinit wrapper for ursined: dinit loads the env-file, then this wrapper execs
# the daemon with the configured extra arguments. The manual source keeps a
# direct start (dinitctl/manual) working with the same options.
#
# Paths are substituted by install.sh; do not edit the @PLACEHOLDER@ tokens in
# the repository copy.
[ -r "@DINIT_CONFIG_DIR@/ursined.conf" ] && . "@DINIT_CONFIG_DIR@/ursined.conf"
exec "@SBINDIR@/ursined" --config "@SYSCONFDIR@/ursine/config.toml" ${URSINED_OPTS}
