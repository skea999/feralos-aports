# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=vector-dinit
pkgver=0.1.0
pkgrel=3
pkgdesc="dinit service for vector"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit vector"
makedepends=""
source="vector
	vector-dinit.tmpfiles"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/vector" "$pkgdir/lib/dinit.d/vector"
	# /run/vector, /dev/log, /var/log, /btrbk — replaces the OpenRC
	# vector-setup script (processed by the dinit-chimera early chain)
	install -Dm644 "$srcdir/vector-dinit.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/vector-dinit.conf"
}

sha512sums="
