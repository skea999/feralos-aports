# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=vector-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for vector"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit vector"
makedepends=""
source="vector"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/vector" "$pkgdir/usr/lib/dinit.d/vector"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../vector" "$pkgdir/usr/lib/dinit.d/boot.d/vector"
}

sha512sums="b95e69b2987b37d6f046a3f7fceaf5c26918fe68775b9e485f716b0f425abdd0  vector"
