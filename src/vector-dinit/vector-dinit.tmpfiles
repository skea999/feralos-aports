# FeralOS vector-dinit: what the SERVICE needs, nothing else (ADR-013 R1/R2).
# Configurations and the paths vector.yaml names (/run/vector, /dev/log) ship
# in vector-config / vector-setup-openrc.
d /var/lib/vector 0755 vector vector -
d /run/vector 0755 vector vector -
L /dev/log 0777 - - - /run/vector/syslog.sock
