# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# wayle-config: the niriWayle static pieces that are NOT the user's
# editable configs (ADR-013 — static configs are package-shipped; anything
# under /home stays installer-written, and vendor-file appends stay
# installer-run-ONCE so a user's manual removal is never re-asserted by a
# package update). This package carries:
#   - /etc/greetd/greeter-wayle.sh — the greeter session script (session
#     log redirect; dms-config ships the niri variant as greeter-niri.sh —
#     distinct filenames so the two config packages never collide as apk
#     content; greetd-config's dispatcher execs whichever one is installed)
#   - /etc/skel/.config/wayle/config.toml — the wayle session config for
#     EVERY user (the install-time user via the skel copy at adduser —
#     packages install BEFORE user creation — and future users). 100%
#     static since feralos-reboot (owner decision: $HOME configs stay
#     installer-written was REVISED 2026-11-25 — the config is static, so
#     the skel carries it and nothing writes /home at install anymore)
#   - the reboot command = the standalone `feralos-reboot` package (the
#     init-agnostic wrapper; wayle-config depends on it)
#   - /etc/pam.d/passwd — oo7 keyring password re-sync override (Alpine
#     ships NO /etc/pam.d/passwd — no vendor conflict; the module re-syncs
#     keyrings on user-initiated passwd changes)
#   - /usr/share/wayle/niri/base.kdl — the niri STATIC base the
#     user config includes (prefer-no-csd, environment minus the per-install
#     XDG_DATA_DIRS, xwayland-satellite, the full binds set). niri >=25.11
#     merges most sections PER-PROPERTY across includes — user overrides
#     live in their config.kdl (installer-written), the base is
#     package-owned and upgrade-replaceable by design.
#   - /etc/xdg-desktop-portal/niri-portals.conf — the ADMIN-path portals
#     override (default=gtk, wlr screenshot/screencast, Secret=oo7-portal —
#     exact oo7 README pin: without it the secret backend resolves
#     implicitly to gtk, and niriWayle has NO gnome-keyring). Shadowing the
#     vendor /usr/share one (default=gnome;gtk) is why niri-portalsconf's
#     dummy exists. The DMS variant pins gnome-keyring instead — its
#     per-user seed stays installer-written until dms-config carries it.
#   - the hicolor logo lives in niri-base-config now (the SHARED layer —
#     the smoke CI installs every apk into ONE root and the two DE
#     packages would collide on the same path; CI run 45301085299).
pkgname=wayle-config
pkgver=0.1.5
pkgrel=0
pkgdesc="FeralOS niriWayle statics: greeter script, init-agnostic reboot, oo7 passwd PAM override"
url="https://github.com/skea999/feralos-aports"
arch="noarch"
license="ISC"
depends="greetd-config feralos-reboot"
makedepends=""
source="greeter.sh pam-passwd niri-base.kdl niri-portals.conf config.toml"
options="!check" # static pieces, proven live by the greeter + wayle harness checks

package() {
	install -Dm755 "$srcdir/greeter.sh" "$pkgdir/etc/greetd/greeter-wayle.sh"
	install -Dm644 "$srcdir/pam-passwd" "$pkgdir/etc/pam.d/passwd"
	install -Dm644 "$srcdir/niri-base.kdl" "$pkgdir/usr/share/wayle/niri/base.kdl"
	install -Dm644 "$srcdir/niri-portals.conf" "$pkgdir/etc/xdg-desktop-portal/niri-portals.conf"
	# skel: EVERY user (install-time via the adduser skel copy — packages
	# install before user creation — and future users) gets the wayle
	# session config; user-editable after
	install -d "$pkgdir/etc/skel/.config/wayle"
	install -m644 "$srcdir/config.toml" "$pkgdir/etc/skel/.config/wayle/config.toml"
}
sha512sums="
