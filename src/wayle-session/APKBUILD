# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# niriWayle session: niri compositor + Wayle shell, as dinit user services.
# The session script is modeled line-by-line on the FeralOS niri-session
# (niri-user-dinit): turnstiled async-race wait, full login-env setenv,
# `dinitctl --user start niri`, existence-filtered session apps
# (wayle.user veila.user polkit-agent.user wayvnc.user — NOT dms.user),
# dinit-monitor hold = greetd session lifetime.
#
# Depends on niri-user-dinit for: the niri user service + niri-shutdown,
# the login-shell trick (/usr/libexec/feralos/login-shell, not in
# /etc/shells) used by greetd's niri-session path, and the fixed
# niri-session mechanism this script mirrors.
#
# This package owns the niriWayle wayland-session entry (wayle itself
# deliberately ships none).
pkgname=wayle-session
pkgver=0.1.0
pkgrel=1
pkgdesc="Wayle session — niri compositor + Wayle shell session for FeralOS (user dinit services)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="niri-user-dinit wayle veila raffi dinit"
makedepends=""
# polkit-agent.user / wayvnc.user are started existence-filtered by the
# session script; they ship with polkit-agent-user-dinit / wayvnc and stay
# optional here (same posture as the niri/DMS stack).
source="wayle-session wayle.user veila.user niriwayle.desktop"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm755 "$srcdir/wayle-session" "$pkgdir/usr/bin/wayle-session"
	install -Dm644 "$srcdir/wayle.user" "$pkgdir/etc/dinit.d/user/wayle.user"
	install -Dm644 "$srcdir/veila.user" "$pkgdir/etc/dinit.d/user/veila.user"
	install -Dm644 "$srcdir/niriwayle.desktop" \
		"$pkgdir/usr/share/wayland-sessions/niriwayle.desktop"
}

sha512sums="
