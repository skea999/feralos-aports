# dinit user service: Wayle shell — bar, notifications, OSD, wallpaper
# (started by wayle-session; niriWayle session). `wayle shell` runs the
# full desktop shell in the FOREGROUND (dinit process supervision holds).
# WAYLAND_DISPLAY/NIRI_SOCKET resolved at start from the compositor
# sockets via the launcher wrapper (wayvnc-session/dms-session pattern;
# depends-on the wait-wayland gate) — the user-dinit env has neither.
type = process
load-options = sub-vars
logfile = $HOME/.local/share/dinit/wayle.log
command = /etc/dinit.d/user/scripts/wayle-shell-session
smooth-recovery = true
working-dir = $HOME
depends-on = wait-wayland.user
depends-on = dbus.user
