pkgname=wayvnc-user-dinit
pkgver=0.1.0
pkgrel=3
pkgdesc="dinit user service for wayvnc"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="wayvnc wayland-wait-user-dinit"
makedepends=""
source="wayvnc.user wayvnc-session"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/wayvnc.user" "$pkgdir/etc/dinit.d/user/wayvnc.user"
	install -Dm755 "$srcdir/wayvnc-session" "$pkgdir/etc/dinit.d/user/scripts/wayvnc-session"
}

