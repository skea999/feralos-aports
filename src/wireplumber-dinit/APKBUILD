# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=wireplumber-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for wireplumber"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit wireplumber"
makedepends=""
source="wireplumber"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/wireplumber" "$pkgdir/usr/lib/dinit.d/wireplumber"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../wireplumber" "$pkgdir/usr/lib/dinit.d/boot.d/wireplumber"
}

sha512sums="287443a88847325d42e0c5a2cf414337899df57b4d8e7ed1af8c00e18e5e3eb3  wireplumber"
