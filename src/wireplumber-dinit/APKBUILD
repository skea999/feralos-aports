# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=wireplumber-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for wireplumber"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit wireplumber"
makedepends=""
source="wireplumber-dinit"

build() { return 0; }
check() { return 0; }

package() {
    install -Dm644 "$srcdir/wireplumber-dinit" "$pkgdir/usr/lib/dinit.d/wireplumber-dinit"
    mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
    ln -sf ../"wireplumber-dinit" "$pkgdir/usr/lib/dinit.d/boot.d/wireplumber-dinit"
}

