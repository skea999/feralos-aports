# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=wireplumber-user-dinit
pkgver=0.1.0
pkgrel=3
pkgdesc="dinit user service for wireplumber"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="wireplumber pipewire-user-dinit pipewire-pulse-user-dinit"
makedepends=""
source="wireplumber.user"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/wireplumber.user" "$pkgdir/etc/dinit.d/user/wireplumber.user"
	# boot.d self-declaration (owner rule): the link ships WITH the service
	# (membership = installed package; the installer no longer maintains boot.d)
	install -d "$pkgdir"/usr/lib/dinit.d/user/boot.d
	ln -sf /etc/dinit.d/user/wireplumber.user \
		"$pkgdir"/usr/lib/dinit.d/user/boot.d/wireplumber.user
}

sha512sums="
d19996c07fea7acd020e3492f40d901ee6600b3749496bf559a6aef8f996a5066deb00a761abf527bf0ccde8ae439a325844bcbeb7582b33ebcef17c155fa529  wireplumber.user
"
