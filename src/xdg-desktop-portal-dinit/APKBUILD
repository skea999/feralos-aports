pkgname=xdg-desktop-portal-dinit
pkgver=0.1.0
pkgrel=1
pkgdesc="dinit service for xdg-desktop-portal"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit xdg-desktop-portal"
makedepends=""
source="xdg-desktop-portal"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/xdg-desktop-portal" "$pkgdir/lib/dinit.d/xdg-desktop-portal"
	mkdir -p "$pkgdir/lib/dinit.d/boot.d"
	ln -sf "../xdg-desktop-portal" "$pkgdir/lib/dinit.d/boot.d/xdg-desktop-portal"
}

sha512sums="b7eea4805dc27b0b41e5f1869042975d5cb6009ad53189d4ce4a22e2df03548b15b7e10dabeb0ba084bf5ddab3aa8a2f62351520e55a4112e312d79d774d2870  xdg-desktop-portal"
