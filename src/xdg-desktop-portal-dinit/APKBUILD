# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
pkgname=xdg-desktop-portal-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for xdg-desktop-portal"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit xdg-desktop-portal"
makedepends=""
source="xdg-desktop-portal"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/xdg-desktop-portal" "$pkgdir/usr/lib/dinit.d/xdg-desktop-portal"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../xdg-desktop-portal" "$pkgdir/usr/lib/dinit.d/boot.d/xdg-desktop-portal"
}

sha512sums="cde6010d53aa94916684e028a69c84b8c250fb1c8213c058a7608490b897bace  xdg-desktop-portal"
