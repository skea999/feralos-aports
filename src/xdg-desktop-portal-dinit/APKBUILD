pkgname=xdg-desktop-portal-dinit
pkgver=0.1.0
pkgrel=3
pkgdesc="dinit service for xdg-desktop-portal"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit xdg-desktop-portal"
makedepends=""
source="xdg-desktop-portal"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/xdg-desktop-portal" "$pkgdir/lib/dinit.d/xdg-desktop-portal"
}

