# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# User dinit service for xdg-desktop-portal-gnome. Unit name = canonical
# session D-Bus bus name (ADR-010); D-Bus activation is routed through
# feralos-dbus-activate via an override in /usr/share/dinit/dbus-services/.
pkgname=xdg-desktop-portal-gnome-user-dinit
pkgver=0.1.0
pkgrel=2
pkgdesc="User dinit service for xdg-desktop-portal-gnome"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="dinit xdg-desktop-portal-gnome feralos-dbus-activate"
makedepends=""
source="org.freedesktop.impl.portal.desktop.gnome.user org.freedesktop.impl.portal.desktop.gnome.service"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/org.freedesktop.impl.portal.desktop.gnome.user" \
		"$pkgdir/etc/dinit.d/user/org.freedesktop.impl.portal.desktop.gnome.user"
	# D-Bus activation override: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.freedesktop.impl.portal.desktop.gnome.service" \
		"$pkgdir/usr/share/dinit/dbus-services/org.freedesktop.impl.portal.desktop.gnome.service"
}

sha512sums="
