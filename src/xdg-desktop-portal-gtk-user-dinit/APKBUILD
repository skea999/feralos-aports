# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# User dinit service for xdg-desktop-portal-gtk. Unit name = canonical
# session D-Bus bus name (ADR-010); D-Bus activation is routed through
# feralos-dbus-activate via an override in /usr/share/feralos/dbus-services/.
pkgname=xdg-desktop-portal-gtk-user-dinit
pkgver=0.1.0
pkgrel=1
pkgdesc="User dinit service for xdg-desktop-portal-gtk"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="dinit xdg-desktop-portal-gtk feralos-dbus-activate"
makedepends=""
source="org.freedesktop.impl.portal.desktop.gtk.user org.freedesktop.impl.portal.desktop.gtk.service"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/org.freedesktop.impl.portal.desktop.gtk.user" \
		"$pkgdir/etc/dinit.d/user/org.freedesktop.impl.portal.desktop.gtk.user"
	# D-Bus activation override: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.freedesktop.impl.portal.desktop.gtk.service" \
		"$pkgdir/usr/share/feralos/dbus-services/org.freedesktop.impl.portal.desktop.gtk.service"
}

sha512sums="
