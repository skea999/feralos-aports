# dinit user service: xdg-desktop-portal-gtk (org.freedesktop.impl.portal.desktop.gtk)
# GTK portal backend. Unit name = canonical D-Bus bus name (ADR-010); D-Bus
# activation is routed through
# /usr/local/share/dbus-1/services/org.freedesktop.impl.portal.desktop.gtk.service.
type = process
smooth-recovery = true
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.freedesktop.impl.portal.desktop.gtk.log
command = /usr/libexec/xdg-desktop-portal-gtk
working-dir = $HOME
depends-on = dbus.user
