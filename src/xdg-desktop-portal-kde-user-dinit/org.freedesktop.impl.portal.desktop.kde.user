# feralos xdg-desktop-portal-kde-user-dinit: D-Bus activation target for
# org.freedesktop.impl.portal.desktop.kde (ADR-010).
# Transitional: drop when the package (or dbus-broker ephemeral services) ships
# this unit itself.
type = process
command = /usr/libexec/xdg-desktop-portal-kde
smooth-recovery = true
restart = false
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.freedesktop.impl.portal.desktop.kde.log
depends-on = dbus.user
