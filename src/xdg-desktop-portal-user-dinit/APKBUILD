# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# User dinit services for xdg-desktop-portal (frontend + document portal +
# permission store). Unit names = canonical session D-Bus bus names
# (ADR-010). D-Bus activation is routed through feralos-dbus-activate via
# overrides in /usr/local/share/dbus-1/services/ (higher precedence than the
# upstream /usr/share files).
pkgname=xdg-desktop-portal-user-dinit
pkgver=0.1.0
pkgrel=2
pkgdesc="User dinit services for xdg-desktop-portal (desktop + document portal + permission store)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="dinit xdg-desktop-portal xdg-document-portal dbus-user-dinit dbus feralos-dbus-activate"
makedepends=""
source="org.freedesktop.portal.Desktop.user org.freedesktop.portal.Documents.user
	org.freedesktop.impl.portal.PermissionStore.user portal-order
	org.freedesktop.portal.Desktop.service org.freedesktop.portal.Documents.service
	org.freedesktop.impl.portal.PermissionStore.service"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/org.freedesktop.portal.Desktop.user" \
		"$pkgdir/etc/dinit.d/user/org.freedesktop.portal.Desktop.user"
	install -Dm644 "$srcdir/org.freedesktop.portal.Documents.user" \
		"$pkgdir/etc/dinit.d/user/org.freedesktop.portal.Documents.user"
	install -Dm644 "$srcdir/org.freedesktop.impl.portal.PermissionStore.user" \
		"$pkgdir/etc/dinit.d/user/org.freedesktop.impl.portal.PermissionStore.user"
	install -Dm755 "$srcdir/portal-order" "$pkgdir/usr/lib/dinit/portal-order"
	# D-Bus activation overrides: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.freedesktop.portal.Desktop.service" \
		"$pkgdir/usr/local/share/dbus-1/services/org.freedesktop.portal.Desktop.service"
	install -Dm644 "$srcdir/org.freedesktop.portal.Documents.service" \
		"$pkgdir/usr/local/share/dbus-1/services/org.freedesktop.portal.Documents.service"
	install -Dm644 "$srcdir/org.freedesktop.impl.portal.PermissionStore.service" \
		"$pkgdir/usr/local/share/dbus-1/services/org.freedesktop.impl.portal.PermissionStore.service"
}

