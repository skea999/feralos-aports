pkgname=xdg-desktop-portal-user-dinit
pkgver=0.1.0
pkgrel=1
pkgdesc="User dinit services for xdg-desktop-portal (desktop + document portal + permission store)"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="dinit xdg-desktop-portal xdg-document-portal dbus-user-dinit dbus"
makedepends=""
source="xdg-desktop-portal.user xdg-document-portal.user xdg-permission-store.user portal-order"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/xdg-desktop-portal.user" "$pkgdir/etc/dinit.d/user/xdg-desktop-portal.user"
	install -Dm644 "$srcdir/xdg-document-portal.user" "$pkgdir/etc/dinit.d/user/xdg-document-portal.user"
	install -Dm644 "$srcdir/xdg-permission-store.user" "$pkgdir/etc/dinit.d/user/xdg-permission-store.user"
	install -Dm755 "$srcdir/portal-order" "$pkgdir/usr/lib/dinit/portal-order"
}

