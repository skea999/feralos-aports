# dinit service: xdg-document-portal (user session)
# FUSE-backed document portal; exposes files to sandboxed apps.
# portal-order gate: do not start until the permission store owns its
# D-Bus name — losing the name race to a D-Bus-activated twin makes the
# supervised instance exit 20 (see /usr/lib/dinit/portal-order header).
type = process
smooth-recovery = true
load-options = sub-vars
logfile = $HOME/.local/share/dinit/xdg-document-portal.log
command = /usr/lib/dinit/portal-order org.freedesktop.impl.portal.PermissionStore -- /usr/libexec/xdg-document-portal
depends-on = dbus.user
