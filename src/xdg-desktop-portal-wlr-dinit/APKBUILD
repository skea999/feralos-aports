pkgname=xdg-desktop-portal-wlr-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for xdg-desktop-portal-wlr"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit xdg-desktop-portal-wlr"
makedepends=""
source="xdg-desktop-portal-wlr-dinit"

build() { return 0; }
check() { return 0; }

package() {
    install -Dm644 "$srcdir/xdg-desktop-portal-wlr-dinit" "$pkgdir/usr/lib/dinit.d/xdg-desktop-portal-wlr-dinit"
    mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
    ln -sf ../"xdg-desktop-portal-wlr-dinit" "$pkgdir/usr/lib/dinit.d/boot.d/xdg-desktop-portal-wlr-dinit"
}

