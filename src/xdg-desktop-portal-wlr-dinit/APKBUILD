source="xdg-desktop-portal-wlr"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/xdg-desktop-portal-wlr" "$pkgdir/lib/dinit.d/xdg-desktop-portal-wlr"
}

