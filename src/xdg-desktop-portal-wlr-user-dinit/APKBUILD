# Contributor: FeralOS <dev@feralos.org>
# Maintainer: FeralOS <dev@feralos.org>
# User dinit service for xdg-desktop-portal-wlr. Unit name = canonical
# session D-Bus bus name (ADR-010); D-Bus activation is routed through
# feralos-dbus-activate via an override in /usr/share/dinit/dbus-services/.
pkgname=xdg-desktop-portal-wlr-user-dinit
pkgver=0.1.0
pkgrel=3
pkgdesc="User dinit service for xdg-desktop-portal-wlr"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="MIT"
depends="dinit xdg-desktop-portal-wlr feralos-dbus-activate"
makedepends=""
source="org.freedesktop.impl.portal.desktop.wlr.user org.freedesktop.impl.portal.desktop.wlr.service"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/org.freedesktop.impl.portal.desktop.wlr.user" \
		"$pkgdir/etc/dinit.d/user/org.freedesktop.impl.portal.desktop.wlr.user"
	# D-Bus activation override: the effective Exec starts the dinit unit.
	install -Dm644 "$srcdir/org.freedesktop.impl.portal.desktop.wlr.service" \
		"$pkgdir/usr/share/dinit/dbus-services/org.freedesktop.impl.portal.desktop.wlr.service"
}

