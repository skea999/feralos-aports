# dinit user service: xdg-desktop-portal-wlr (org.freedesktop.impl.portal.desktop.wlr)
# wlroots portal backend. Unit name = canonical D-Bus bus name (ADR-010);
# D-Bus activation is routed through
# /usr/local/share/dbus-1/services/org.freedesktop.impl.portal.desktop.wlr.service.
type = process
smooth-recovery = true
load-options = sub-vars
logfile = $HOME/.local/share/dinit/org.freedesktop.impl.portal.desktop.wlr.log
command = /usr/libexec/xdg-desktop-portal-wlr
working-dir = $HOME
depends-on = dbus.user
