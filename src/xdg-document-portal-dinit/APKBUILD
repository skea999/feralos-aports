pkgname=xdg-document-portal-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="xdg document portal service for dinit"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit xdg-document-portal"
makedepends=""
source="xdg-document-portal-dinit"

build() {
	# nothing to build
	return 0
}

check() {
	# nothing to test
	return 0
}

package() {
	install -Dm644 "$srcdir/xdg-document-portal-dinit" "$pkgdir/usr/lib/dinit.d/xdg-document-portal-dinit"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf ../xdg-document-portal-dinit "$pkgdir/usr/lib/dinit.d/boot.d/xdg-document-portal-dinit"
}

