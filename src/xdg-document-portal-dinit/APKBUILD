pkgname=xdg-document-portal-dinit
pkgver=0.1.0
pkgrel=3
pkgdesc="dinit service for xdg-document-portal"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit xdg-document-portal"
makedepends=""
source="xdg-document-portal"

build() { return 0; }
check() { return 0; }

package() {
	# Alpine model: ship the service file; enablement is rules-driven (dinitctl enable)
	install -Dm644 "$srcdir/xdg-document-portal" "$pkgdir/lib/dinit.d/xdg-document-portal"
}

