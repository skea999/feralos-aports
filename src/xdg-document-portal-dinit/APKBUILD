pkgname=xdg-document-portal-dinit
pkgver=0.1.0
pkgrel=0
pkgdesc="dinit service for xdg-document-portal"
url="https://github.com/skea999/feralos-aports"
arch="all"
license="ISC"
depends="dinit xdg-document-portal"
makedepends=""
source="xdg-document-portal"

build() { return 0; }
check() { return 0; }

package() {
	install -Dm644 "$srcdir/xdg-document-portal" "$pkgdir/usr/lib/dinit.d/xdg-document-portal"
	mkdir -p "$pkgdir/usr/lib/dinit.d/boot.d"
	ln -sf "../xdg-document-portal" "$pkgdir/usr/lib/dinit.d/boot.d/xdg-document-portal"
}

