#!/bin/sh
# xdg-su wrapper (niri-base-config) — the vendor xdg-su does not support
# niri: GUI privilege prompts run alacritty + su instead. Matches *niri*
# so both session types (niri, niriWayle) hit the wrapper.
# No vendor binary exists on Alpine (no package ships /usr/bin/xdg-su) —
# the former "exec the original" fallback was dead code and a self-exec
# loop once this wrapper lived at that same path.

case "$XDG_CURRENT_DESKTOP" in
    *niri*)
        cmd=
        user=
        while [ $# -gt 0 ]; do
            case "$1" in
                -c) cmd="$2"; shift 2 ;;
                -u) user="$2"; shift 2 ;;
                *) shift ;;
            esac
        done
        if [ -n "$cmd" ] && command -v alacritty >/dev/null 2>&1; then
            if [ -n "$user" ]; then
                exec alacritty -e su -c "$cmd" "$user"
            else
                exec alacritty -e su -c "$cmd"
            fi
        fi
        echo "xdg-su: no command (-c) or alacritty missing" >&2
        exit 1
        ;;
esac

echo "xdg-su: XDG_CURRENT_DESKTOP is not niri — nothing to do" >&2
exit 1
